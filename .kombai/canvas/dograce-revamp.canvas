      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=IBM+Plex+Mono:wght@400;500;600&display=swap');\n\n  #drs { font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }\n  #drs .mono { font-family: 'IBM Plex Mono', ui-monospace, monospace; }\n\n  #drs .photo { filter: grayscale(100%) contrast(1.18) brightness(0.98); transition: filter .45s ease; }\n  #drs .ph:hover .photo { filter: none; }\n\n  #drs .logo-chip { display: flex; align-items: center; justify-content: center; overflow: hidden; }\n  #drs .logo-chip img {\n    max-height: 62px; max-width: 100%; width: auto; height: auto; object-fit: contain;\n    filter: grayscale(100%) contrast(1.1) opacity(0.72); transition: filter .35s ease;\n  }\n  #drs .logo-chip:hover img { filter: none; }\n\n  #drs .field {\n    border: 0; border-bottom: 2px solid #050a14; background: #ffffff; color: #050a14;\n    font: inherit; font-size: 0.95rem; padding: 0.7rem 0.25rem; width: 100%;\n    transition: border-color .2s ease, background .2s ease;\n  }\n  #drs .field::placeholder { color: #6b7280; }\n  #drs .field:focus {\n    outline: 3px solid #ffc107; outline-offset: 3px;\n    border-bottom-color: #050a14; background: #fffdf3;\n  }\n  #drs a:focus-visible, #drs button:focus-visible { outline: 3px solid #ffc107; outline-offset: 3px; }\n  #drs .mapframe { filter: grayscale(100%) contrast(1.12); }\n  #drs .yellow-btn { transition: background .18s ease, color .18s ease; }\n  #drs .yellow-btn:hover { background: #050a14; color: #ffc107; }\n  #drs .ink-btn { transition: background .18s ease, color .18s ease; }\n  #drs .ink-btn:hover { background: #ffc107; color: #050a14; }\n  #drs .navlink { transition: color .18s ease, background .18s ease; }\n  #drs .navlink:hover { background: #ffc107; }\n</style>\n<link data-kid=\"1\" data-name=\"Tabler Icons stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"bg-white text-[#050a14] pb-24\" data-kid=\"2\" data-name=\"page wrapper\" id=\"drs\">\n    <!-- ================= 1. UTILITY STRIP ================= -->\n    <div class=\"bg-[#050a14] text-white\" data-kid=\"2-1\" data-name=\"utility bar\">\n        <div class=\"mx-auto max-w-[1320px] px-8 flex items-stretch justify-between\" data-kid=\"2-1-1\" data-name=\"utility bar container\">\n            <div class=\"mono text-[11px] tracking-[0.14em] uppercase flex items-center gap-6 py-3 text-white/70\" data-kid=\"2-1-1-1\" data-name=\"contact info group\">\n                <span data-kid=\"2-1-1-1-1\" data-name=\"address text\">\n                    2120 Dunakeszi, Fő út 69.\n                </span>\n                <span class=\"hidden md:inline text-white/25\" data-kid=\"2-1-1-1-2\" data-name=\"separator text\">\n                    /\n                </span>\n                <a class=\"hidden md:inline hover:text-[#ffc107]\" data-kid=\"2-1-1-1-3\" data-name=\"email link\" href=\"mailto:dograceseckft@gmail.com\">\n                    dograceseckft@gmail.com\n                </a>\n            </div>\n            <div class=\"flex items-stretch\" data-kid=\"2-1-1-2\" data-name=\"call action group\">\n                <span class=\"mono hidden lg:flex items-center px-5 text-[11px] tracking-[0.14em] uppercase text-white/50 border-l border-white/15\" data-kid=\"2-1-1-2-1\" data-name=\"dispatcher status text\">\n                    Diszpécser 0–24\n                </span>\n                <a class=\"mono flex items-center gap-2 bg-[#ffc107] text-[#050a14] px-5 text-[12px] font-semibold tracking-[0.08em] yellow-btn\" data-kid=\"2-1-1-2-2\" data-name=\"call button\" href=\"tel:+36706069802\">\n                    <i class=\"ti ti-phone text-[14px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"phone icon\">\n                    </i>\n                    06 70 606 9802\n                </a>\n            </div>\n        </div>\n    </div>\n    <!-- ================= 1b. HEADER ================= -->\n    <header class=\"bg-white border-b border-[#050a14]\" data-kid=\"2-2\" data-name=\"header container\">\n        <div class=\"mx-auto max-w-[1320px] px-8 h-[86px] flex items-center justify-between\" data-kid=\"2-2-1\" data-name=\"header layout\">\n            <a class=\"flex items-center\" data-kid=\"2-2-1-1\" data-name=\"logo link\" href=\"#top\">\n                <img alt=\"DOG RACE SECURITY Kft. logó\" data-kid=\"2-2-1-1-1\" data-name=\"company logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\" style=\"filter: invert(1); height: 46px; width: auto;\"/>\n            </a>\n            <nav aria-label=\"Fő navigáció\" class=\"flex items-center gap-1\" data-kid=\"2-2-1-2\" data-name=\"main navigation\">\n                <a class=\"navlink mono text-[11px] font-semibold uppercase tracking-[0.14em] px-3 py-2\" data-kid=\"2-2-1-2-1\" data-name=\"services nav link\" href=\"#services\">\n                    Szolgáltatások\n                </a>\n                <a class=\"navlink mono text-[11px] font-semibold uppercase tracking-[0.14em] px-3 py-2\" data-kid=\"2-2-1-2-2\" data-name=\"about nav link\" href=\"#about\">\n                    Rólunk\n                </a>\n                <a class=\"navlink mono text-[11px] font-semibold uppercase tracking-[0.14em] px-3 py-2\" data-kid=\"2-2-1-2-3\" data-name=\"process nav link\" href=\"#process\">\n                    Folyamat\n                </a>\n                <a class=\"navlink mono text-[11px] font-semibold uppercase tracking-[0.14em] px-3 py-2\" data-kid=\"2-2-1-2-4\" data-name=\"references nav link\" href=\"#references\">\n                    Referenciák\n                </a>\n                <a class=\"navlink mono text-[11px] font-semibold uppercase tracking-[0.14em] px-3 py-2\" data-kid=\"2-2-1-2-5\" data-name=\"contact nav link\" href=\"#contact\">\n                    Kapcsolat\n                </a>\n                <a class=\"yellow-btn ml-4 bg-[#ffc107] border border-[#050a14] px-5 py-3 mono text-[11px] font-bold uppercase tracking-[0.14em]\" data-kid=\"2-2-1-2-6\" data-name=\"primary request offer button\" href=\"#contact\">\n                    Ajánlatkérés\n                </a>\n            </nav>\n        </div>\n    </header>\n    <!-- ================= 2. HERO ================= -->\n    <section class=\"border-b border-[#050a14]\" data-kid=\"2-3\" data-name=\"hero section\" id=\"top\">\n        <div class=\"grid grid-cols-1 lg:grid-cols-[1fr_1fr]\" data-kid=\"2-3-1\" data-name=\"hero layout container\">\n            <!-- left -->\n            <div class=\"bg-white px-8 lg:pl-[60px] lg:pr-16 py-16 lg:py-20 flex flex-col justify-center\" data-kid=\"2-3-1-1\" data-name=\"hero left content block\">\n                <div class=\"max-w-[620px]\" data-kid=\"2-3-1-1-1\" data-name=\"hero text container\">\n                    <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14] flex items-center gap-3 mb-8\" data-kid=\"2-3-1-1-1-1\" data-name=\"hero subheadline container\">\n                        <span class=\"inline-block w-8 h-[3px] bg-[#ffc107]\" data-kid=\"2-3-1-1-1-1-1\" data-name=\"hero subheadline decorative bar\">\n                        </span>\n                        Vagyonvédelem & létesítményszolgáltatás\n                    </div>\n                    <h1 class=\"text-[46px] xl:text-[54px] leading-[1.04] font-extrabold tracking-[-0.03em]\" data-kid=\"2-3-1-1-1-2\" data-name=\"main hero headline\">\n                        2019 óta őrizzük ipari parkok, irodaházak és építési területek vagyonát.\n                    </h1>\n                    <p class=\"mt-7 text-[16.5px] leading-[1.65] text-[#050a14]/85 max-w-[560px]\" data-kid=\"2-3-1-1-1-3\" data-name=\"hero paragraph\">\n                        Objektumőrzés, portaszolgálat és járőrszolgálat országos lefedettséggel — 40 fős,\n            feddhetetlenségi vizsgálaton átesett állománnyal, 0–24 diszpécserháttérrel.\n                    </p>\n                    <div class=\"mt-9 flex flex-wrap items-stretch gap-4\" data-kid=\"2-3-1-1-1-4\" data-name=\"hero buttons container\">\n                        <a class=\"yellow-btn bg-[#ffc107] border-2 border-[#050a14] px-7 py-4 mono text-[12px] font-bold uppercase tracking-[0.12em]\" data-kid=\"2-3-1-1-1-4-1\" data-name=\"hero request offer button\" href=\"#contact\">\n                            Ajánlatkérés 24 órán belül\n                        </a>\n                        <a class=\"ink-btn bg-white border-2 border-[#050a14] px-7 py-4 mono text-[12px] font-bold uppercase tracking-[0.12em] flex items-center gap-2\" data-kid=\"2-3-1-1-1-4-2\" data-name=\"hero phone link\" href=\"tel:+36706069802\">\n                            <i class=\"ti ti-phone text-[16px]\" data-kid=\"2-3-1-1-1-4-2-1\" data-name=\"phone icon\">\n                            </i>\n                            06 70 606 9802\n                        </a>\n                    </div>\n                    <div class=\"mt-9 pt-6 border-t border-[#050a14]/20\" data-kid=\"2-3-1-1-1-5\" data-name=\"credentials disclaimer container\">\n                        <p class=\"mono text-[11px] uppercase tracking-[0.1em] text-[#050a14]/65 leading-[1.9]\" data-kid=\"2-3-1-1-1-5-1\" data-name=\"credentials text\">\n                            Vagyonvédelmi tevékenységi engedély\n                            <span class=\"text-[#050a14]/30\" data-kid=\"2-3-1-1-1-5-1-1\" data-name=\"separator\">\n                                ·\n                            </span>\n                            Felelősségbiztosítás\n                            <span class=\"text-[#050a14]/30\" data-kid=\"2-3-1-1-1-5-1-2\" data-name=\"separator\">\n                                ·\n                            </span>\n                            100%-ban magyar tulajdon\n                        </p>\n                    </div>\n                </div>\n            </div>\n            <!-- right photo -->\n            <div class=\"relative ph border-l border-[#050a14] min-h-[520px] lg:min-h-[660px] overflow-hidden bg-[#050a14]\" data-kid=\"2-3-1-2\" data-name=\"hero image container\">\n                <img alt=\"DOG RACE SECURITY szolgálati gépjármű\" class=\"photo absolute inset-0 w-full h-full object-cover\" data-kid=\"2-3-1-2-1\" data-name=\"hero image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image7.jpeg\"/>\n                <div class=\"absolute top-0 left-0 bg-[#ffc107] text-[#050a14] mono text-[10px] font-bold uppercase tracking-[0.18em] px-4 py-2\" data-kid=\"2-3-1-2-2\" data-name=\"hero image label badge\">\n                    Saját flotta · Kivonuló járőr\n                </div>\n                <div class=\"absolute bottom-0 right-0 bg-[#050a14] text-[#ffc107] mono text-[11px] tracking-[0.16em] px-4 py-2\" data-kid=\"2-3-1-2-3\" data-name=\"hero image status indicator\">\n                    [ OP-STATUS: ACTIVE ]\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 3. STATS BAND ================= -->\n    <section class=\"border-b border-[#050a14] bg-[#f3f4f6]\" data-kid=\"2-4\" data-name=\"stats section\">\n        <div class=\"grid grid-cols-2 lg:grid-cols-4\" data-kid=\"2-4-1\" data-name=\"stats grid\">\n            <div class=\"border-r border-[#050a14] px-8 py-9\" data-kid=\"2-4-1-1\" data-name=\"stat card 1\">\n                <div class=\"mono text-[38px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"2-4-1-1-1\" data-name=\"stat value 1\">\n                    7+ év\n                </div>\n                <div class=\"mt-3 h-[3px] w-10 bg-[#ffc107]\" data-kid=\"2-4-1-1-2\" data-name=\"stat decorator 1\">\n                </div>\n                <div class=\"mt-3 text-[13.5px] leading-[1.5] text-[#050a14]/75\" data-kid=\"2-4-1-1-3\" data-name=\"stat description 1\">\n                    folyamatos működés 2019 óta\n                </div>\n            </div>\n            <div class=\"border-r-0 lg:border-r border-[#050a14] px-8 py-9\" data-kid=\"2-4-1-2\" data-name=\"stat card 2\">\n                <div class=\"mono text-[38px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"2-4-1-2-1\" data-name=\"stat value 2\">\n                    40+ fő\n                </div>\n                <div class=\"mt-3 h-[3px] w-10 bg-[#ffc107]\" data-kid=\"2-4-1-2-2\" data-name=\"stat decorator 2\">\n                </div>\n                <div class=\"mt-3 text-[13.5px] leading-[1.5] text-[#050a14]/75\" data-kid=\"2-4-1-2-3\" data-name=\"stat description 2\">\n                    saját, bejelentett állomány\n                </div>\n            </div>\n            <div class=\"border-r border-[#050a14] border-t lg:border-t-0 px-8 py-9\" data-kid=\"2-4-1-3\" data-name=\"stat card 3\">\n                <div class=\"mono text-[38px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"2-4-1-3-1\" data-name=\"stat value 3\">\n                    15+ ügyfél\n                </div>\n                <div class=\"mt-3 h-[3px] w-10 bg-[#ffc107]\" data-kid=\"2-4-1-3-2\" data-name=\"stat decorator 3\">\n                </div>\n                <div class=\"mt-3 text-[13.5px] leading-[1.5] text-[#050a14]/75\" data-kid=\"2-4-1-3-3\" data-name=\"stat description 3\">\n                    ipari park, logisztika, építőipar\n                </div>\n            </div>\n            <div class=\"border-t lg:border-t-0 border-[#050a14] px-8 py-9\" data-kid=\"2-4-1-4\" data-name=\"stat card 4\">\n                <div class=\"mono text-[38px] font-semibold leading-none tracking-[-0.02em]\" data-kid=\"2-4-1-4-1\" data-name=\"stat value 4\">\n                    0–24\n                </div>\n                <div class=\"mt-3 h-[3px] w-10 bg-[#ffc107]\" data-kid=\"2-4-1-4-2\" data-name=\"stat decorator 4\">\n                </div>\n                <div class=\"mt-3 text-[13.5px] leading-[1.5] text-[#050a14]/75\" data-kid=\"2-4-1-4-3\" data-name=\"stat description 4\">\n                    diszpécserszolgálat, minden nap\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 4. SERVICES ================= -->\n    <section class=\"bg-white py-20\" data-kid=\"2-5\" data-name=\"services section\" id=\"services\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-5-1\" data-name=\"services section container\">\n            <div class=\"flex flex-wrap items-end justify-between gap-6 mb-3\" data-kid=\"2-5-1-1\" data-name=\"services header area\">\n                <div data-kid=\"2-5-1-1-1\" data-name=\"section title group\">\n                    <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-5-1-1-1-1\" data-name=\"services section label\">\n                        01 / Szolgáltatások\n                    </div>\n                    <h2 class=\"text-[36px] font-extrabold tracking-[-0.03em] leading-[1.1] max-w-[620px]\" data-kid=\"2-5-1-1-1-2\" data-name=\"services section heading\">\n                        Szolgáltatásaink\n                    </h2>\n                </div>\n                <p class=\"text-[14.5px] text-[#050a14]/70 max-w-[380px] leading-[1.6]\" data-kid=\"2-5-1-1-2\" data-name=\"services lead paragraph\">\n                    Három őrzési alaptevékenység, amelyre a szerződések épülnek, és három kiegészítő szolgáltatás.\n                </p>\n            </div>\n            <div class=\"mono text-[11px] uppercase tracking-[0.18em] text-[#050a14] bg-[#ffc107] inline-block px-3 py-1.5 mt-10 mb-5\" data-kid=\"2-5-1-2\" data-name=\"primary services badge\">\n                Őrzési alaptevékenység\n            </div>\n            <!-- primary 3 -->\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 border-t border-l border-[#050a14]\" data-kid=\"2-5-1-3\" data-name=\"primary services grid\">\n                <article class=\"ph group border-r border-b border-[#050a14] bg-white\" data-kid=\"2-5-1-3-1\" data-name=\"service card 1\">\n                    <div class=\"overflow-hidden border-b border-[#050a14]\" data-kid=\"2-5-1-3-1-1\" data-name=\"service image container 1\">\n                        <img alt=\"Objektumőrzés – irodaház bejárata\" class=\"photo w-full h-[230px] object-cover\" data-kid=\"2-5-1-3-1-1-1\" data-name=\"service image 1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image4.jpeg\"/>\n                    </div>\n                    <div class=\"p-8\" data-kid=\"2-5-1-3-1-2\" data-name=\"service content 1\">\n                        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"2-5-1-3-1-2-1\" data-name=\"service icon group 1\">\n                            <span class=\"w-11 h-11 border border-[#050a14] grid place-items-center text-[22px] bg-[#f3f4f6]\" data-kid=\"2-5-1-3-1-2-1-1\" data-name=\"service icon wrapper 1\">\n                                <i class=\"ti ti-building-warehouse\" data-kid=\"2-5-1-3-1-2-1-1-1\" data-name=\"service icon 1\">\n                                </i>\n                            </span>\n                            <span class=\"mono text-[11px] tracking-[0.16em] text-[#050a14]/50\" data-kid=\"2-5-1-3-1-2-1-2\" data-name=\"service number 1\">\n                                01\n                            </span>\n                        </div>\n                        <h3 class=\"text-[19px] font-bold tracking-[-0.01em]\" data-kid=\"2-5-1-3-1-2-2\" data-name=\"service title 1\">\n                            Objektumőrzés\n                        </h3>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.65] text-[#050a14]/80\" data-kid=\"2-5-1-3-1-2-3\" data-name=\"service description 1\">\n                            Épületek, telephelyek, irodaházak és ipari létesítmények komplett objektumvédelme, igény esetén kutyás őrszolgálattal.\n                        </p>\n                        <ul class=\"mt-5 space-y-2 mono text-[11px] uppercase tracking-[0.1em] text-[#050a14]/65\" data-kid=\"2-5-1-3-1-2-4\" data-name=\"service features list 1\">\n                            <li class=\"flex gap-2\" data-kid=\"2-5-1-3-1-2-4-1\" data-name=\"service feature 1-1\">\n                                <span class=\"text-[#050a14]\" data-kid=\"2-5-1-3-1-2-4-1-1\" data-name=\"feature icon 1-1\">\n                                    —\n                                </span>\n                                Beléptetés és kamerafigyelés\n                            </li>\n                            <li class=\"flex gap-2\" data-kid=\"2-5-1-3-1-2-4-2\" data-name=\"service feature 1-2\">\n                                <span class=\"text-[#050a14]\" data-kid=\"2-5-1-3-1-2-4-2-1\" data-name=\"feature icon 1-2\">\n                                    —\n                                </span>\n                                Kutyás őrszolgálat opcióval\n                            </li>\n                        </ul>\n                    </div>\n                </article>\n                <article class=\"ph group border-r border-b border-[#050a14] bg-white\" data-kid=\"2-5-1-3-2\" data-name=\"service card 2\">\n                    <div class=\"overflow-hidden border-b border-[#050a14]\" data-kid=\"2-5-1-3-2-1\" data-name=\"service image container 2\">\n                        <img alt=\"Portaszolgálat – recepciós munkatárs\" class=\"photo w-full h-[230px] object-cover\" data-kid=\"2-5-1-3-2-1-1\" data-name=\"service image 2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image6.jpeg\"/>\n                    </div>\n                    <div class=\"p-8\" data-kid=\"2-5-1-3-2-2\" data-name=\"service content 2\">\n                        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"2-5-1-3-2-2-1\" data-name=\"service icon group 2\">\n                            <span class=\"w-11 h-11 border border-[#050a14] grid place-items-center text-[22px] bg-[#f3f4f6]\" data-kid=\"2-5-1-3-2-2-1-1\" data-name=\"service icon wrapper 2\">\n                                <i class=\"ti ti-door-enter\" data-kid=\"2-5-1-3-2-2-1-1-1\" data-name=\"service icon 2\">\n                                </i>\n                            </span>\n                            <span class=\"mono text-[11px] tracking-[0.16em] text-[#050a14]/50\" data-kid=\"2-5-1-3-2-2-1-2\" data-name=\"service number 2\">\n                                02\n                            </span>\n                        </div>\n                        <h3 class=\"text-[19px] font-bold tracking-[-0.01em]\" data-kid=\"2-5-1-3-2-2-2\" data-name=\"service title 2\">\n                            Portaszolgálat\n                        </h3>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.65] text-[#050a14]/80\" data-kid=\"2-5-1-3-2-2-3\" data-name=\"service description 2\">\n                            Recepciós, diszpécseri és operátori feladatok ellátása, beléptetés és információs szolgáltatások.\n                        </p>\n                        <ul class=\"mt-5 space-y-2 mono text-[11px] uppercase tracking-[0.1em] text-[#050a14]/65\" data-kid=\"2-5-1-3-2-2-4\" data-name=\"service features list 2\">\n                            <li class=\"flex gap-2\" data-kid=\"2-5-1-3-2-2-4-1\" data-name=\"service feature 2-1\">\n                                <span class=\"text-[#050a14]\" data-kid=\"2-5-1-3-2-2-4-1-1\" data-name=\"feature icon 2-1\">\n                                    —\n                                </span>\n                                Látogató- és gépjárműkezelés\n                            </li>\n                            <li class=\"flex gap-2\" data-kid=\"2-5-1-3-2-2-4-2\" data-name=\"service feature 2-2\">\n                                <span class=\"text-[#050a14]\" data-kid=\"2-5-1-3-2-2-4-2-1\" data-name=\"feature icon 2-2\">\n                                    —\n                                </span>\n                                Kulcs- és csomagnyilvántartás\n                            </li>\n                        </ul>\n                    </div>\n                </article>\n                <article class=\"ph group border-r border-b border-[#050a14] bg-white\" data-kid=\"2-5-1-3-3\" data-name=\"service card 3\">\n                    <div class=\"overflow-hidden border-b border-[#050a14]\" data-kid=\"2-5-1-3-3-1\" data-name=\"service image container 3\">\n                        <img alt=\"Járőrszolgálat – őr a szolgálati gépjármű mellett\" class=\"photo w-full h-[230px] object-cover\" data-kid=\"2-5-1-3-3-1-1\" data-name=\"service image 3\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image3.jpeg\"/>\n                    </div>\n                    <div class=\"p-8\" data-kid=\"2-5-1-3-3-2\" data-name=\"service content 3\">\n                        <div class=\"flex items-center gap-3 mb-4\" data-kid=\"2-5-1-3-3-2-1\" data-name=\"service icon group 3\">\n                            <span class=\"w-11 h-11 border border-[#050a14] grid place-items-center text-[22px] bg-[#f3f4f6]\" data-kid=\"2-5-1-3-3-2-1-1\" data-name=\"service icon wrapper 3\">\n                                <i class=\"ti ti-route\" data-kid=\"2-5-1-3-3-2-1-1-1\" data-name=\"service icon 3\">\n                                </i>\n                            </span>\n                            <span class=\"mono text-[11px] tracking-[0.16em] text-[#050a14]/50\" data-kid=\"2-5-1-3-3-2-1-2\" data-name=\"service number 3\">\n                                03\n                            </span>\n                        </div>\n                        <h3 class=\"text-[19px] font-bold tracking-[-0.01em]\" data-kid=\"2-5-1-3-3-2-2\" data-name=\"service title 3\">\n                            Járőrszolgálat\n                        </h3>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.65] text-[#050a14]/80\" data-kid=\"2-5-1-3-3-2-3\" data-name=\"service description 3\">\n                            Nappali és éjszakai területellenőrző járőrszolgálat felállítása és üzemeltetése, gépkocsival vagy gyalogosan.\n                        </p>\n                        <ul class=\"mt-5 space-y-2 mono text-[11px] uppercase tracking-[0.1em] text-[#050a14]/65\" data-kid=\"2-5-1-3-3-2-4\" data-name=\"service features list 3\">\n                            <li class=\"flex gap-2\" data-kid=\"2-5-1-3-3-2-4-1\" data-name=\"service feature 3-1\">\n                                <span class=\"text-[#050a14]\" data-kid=\"2-5-1-3-3-2-4-1-1\" data-name=\"feature icon 3-1\">\n                                    —\n                                </span>\n                                Dokumentált ellenőrzőkörök\n                            </li>\n                            <li class=\"flex gap-2\" data-kid=\"2-5-1-3-3-2-4-2\" data-name=\"service feature 3-2\">\n                                <span class=\"text-[#050a14]\" data-kid=\"2-5-1-3-3-2-4-2-1\" data-name=\"feature icon 3-2\">\n                                    —\n                                </span>\n                                Riasztásra kivonulás\n                            </li>\n                        </ul>\n                    </div>\n                </article>\n            </div>\n            <div class=\"mono text-[11px] uppercase tracking-[0.18em] text-[#050a14]/60 border border-[#050a14]/25 inline-block px-3 py-1.5 mt-12 mb-5\" data-kid=\"2-5-1-4\" data-name=\"secondary services badge\">\n                Kiegészítő szolgáltatás\n            </div>\n            <!-- secondary 3 -->\n            <div class=\"grid grid-cols-1 lg:grid-cols-3 border-t border-l border-[#050a14]\" data-kid=\"2-5-1-5\" data-name=\"secondary services grid\">\n                <article class=\"ph border-r border-b border-[#050a14] bg-[#f3f4f6] p-6 flex gap-5\" data-kid=\"2-5-1-5-1\" data-name=\"secondary service card 1\">\n                    <div class=\"shrink-0 overflow-hidden border border-[#050a14] w-[86px] h-[86px]\" data-kid=\"2-5-1-5-1-1\" data-name=\"secondary service image container 1\">\n                        <img alt=\"Rendezvénybiztosítás\" class=\"photo w-full h-full object-cover\" data-kid=\"2-5-1-5-1-1-1\" data-name=\"secondary service image 1\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image2.jpeg\"/>\n                    </div>\n                    <div data-kid=\"2-5-1-5-1-2\" data-name=\"secondary service content 1\">\n                        <div class=\"flex items-center gap-2 text-[16px] text-[#050a14]/70 mb-1.5\" data-kid=\"2-5-1-5-1-2-1\" data-name=\"secondary service icon container 1\">\n                            <i class=\"ti ti-users-group\" data-kid=\"2-5-1-5-1-2-1-1\" data-name=\"secondary service icon 1\">\n                            </i>\n                        </div>\n                        <h3 class=\"text-[15.5px] font-bold\" data-kid=\"2-5-1-5-1-2-2\" data-name=\"secondary service title 1\">\n                            Rendezvénybiztosítás\n                        </h3>\n                        <p class=\"mt-2 text-[13.5px] leading-[1.6] text-[#050a14]/75\" data-kid=\"2-5-1-5-1-2-3\" data-name=\"secondary service description 1\">\n                            Rendezvények biztosítása és személyvédelem a résztvevők és a vagyon védelme érdekében.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"ph border-r border-b border-[#050a14] bg-[#f3f4f6] p-6 flex gap-5\" data-kid=\"2-5-1-5-2\" data-name=\"secondary service card 2\">\n                    <div class=\"shrink-0 overflow-hidden border border-[#050a14] w-[86px] h-[86px]\" data-kid=\"2-5-1-5-2-1\" data-name=\"secondary service image container 2\">\n                        <img alt=\"Takarítás\" class=\"photo w-full h-full object-cover\" data-kid=\"2-5-1-5-2-1-1\" data-name=\"secondary service image 2\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image8.jpeg\"/>\n                    </div>\n                    <div data-kid=\"2-5-1-5-2-2\" data-name=\"secondary service content 2\">\n                        <div class=\"flex items-center gap-2 text-[16px] text-[#050a14]/70 mb-1.5\" data-kid=\"2-5-1-5-2-2-1\" data-name=\"secondary service icon container 2\">\n                            <i class=\"ti ti-spray\" data-kid=\"2-5-1-5-2-2-1-1\" data-name=\"secondary service icon 2\">\n                            </i>\n                        </div>\n                        <h3 class=\"text-[15.5px] font-bold\" data-kid=\"2-5-1-5-2-2-2\" data-name=\"secondary service title 2\">\n                            Takarítás\n                        </h3>\n                        <p class=\"mt-2 text-[13.5px] leading-[1.6] text-[#050a14]/75\" data-kid=\"2-5-1-5-2-2-3\" data-name=\"secondary service description 2\">\n                            Irodaházak, üzemek és közterületek takarítása gépi padló- és szőnyegtisztítással, valamint fertőtlenítő gőztakarítással.\n                        </p>\n                    </div>\n                </article>\n                <article class=\"ph border-r border-b border-[#050a14] bg-[#f3f4f6] p-6 flex gap-5\" data-kid=\"2-5-1-5-3\" data-name=\"secondary service card 3\">\n                    <div class=\"shrink-0 overflow-hidden border border-[#050a14] w-[86px] h-[86px]\" data-kid=\"2-5-1-5-3-1\" data-name=\"secondary service image container 3\">\n                        <img alt=\"Megbízható partner\" class=\"photo w-full h-full object-cover\" data-kid=\"2-5-1-5-3-1-1\" data-name=\"secondary service image 3\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image1.jpeg\"/>\n                    </div>\n                    <div data-kid=\"2-5-1-5-3-2\" data-name=\"secondary service content 3\">\n                        <div class=\"flex items-center gap-2 text-[16px] text-[#050a14]/70 mb-1.5\" data-kid=\"2-5-1-5-3-2-1\" data-name=\"secondary service icon container 3\">\n                            <i class=\"ti ti-handshake\" data-kid=\"2-5-1-5-3-2-1-1\" data-name=\"secondary service icon 3\">\n                            </i>\n                        </div>\n                        <h3 class=\"text-[15.5px] font-bold\" data-kid=\"2-5-1-5-3-2-2\" data-name=\"secondary service title 3\">\n                            Megbízható partner\n                        </h3>\n                        <p class=\"mt-2 text-[13.5px] leading-[1.6] text-[#050a14]/75\" data-kid=\"2-5-1-5-3-2-3\" data-name=\"secondary service description 3\">\n                            Ügyfeleink biztonsága a legfontosabb számunkra. Hosszú távú, megbízható együttműködés.\n                        </p>\n                    </div>\n                </article>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 5. PROCESS ================= -->\n    <section class=\"bg-[#f3f4f6] py-20 border-y border-[#050a14]\" data-kid=\"2-6\" data-name=\"process section\" id=\"process\">\n        <div class=\"mx-auto max-w-[1060px] px-8\" data-kid=\"2-6-1\" data-name=\"process section container\">\n            <div class=\"text-center mb-16\" data-kid=\"2-6-1-1\" data-name=\"process section header\">\n                <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-6-1-1-1\" data-name=\"process section label\">\n                    02 / Folyamat\n                </div>\n                <h2 class=\"text-[36px] font-extrabold tracking-[-0.03em] leading-[1.1]\" data-kid=\"2-6-1-1-2\" data-name=\"process section heading\">\n                    Így dolgozunk\n                </h2>\n                <p class=\"mt-4 text-[15px] text-[#050a14]/75 max-w-[520px] mx-auto leading-[1.65]\" data-kid=\"2-6-1-1-3\" data-name=\"process section lead paragraph\">\n                    A szerződéskötéstől a havi értékelésig minden lépés dokumentált és visszakövethető.\n                </p>\n            </div>\n            <div class=\"relative\" data-kid=\"2-6-1-2\" data-name=\"process steps container\">\n                <div class=\"absolute left-1/2 -translate-x-1/2 top-0 bottom-0 w-[2px] bg-[#050a14] hidden lg:block\" data-kid=\"2-6-1-2-1\" data-name=\"process vertical timeline line\">\n                </div>\n                <!-- step 01 -->\n                <div class=\"relative grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-start gap-6 lg:gap-0 pb-14\" data-kid=\"2-6-1-2-2\" data-name=\"process step 1\">\n                    <div class=\"lg:pr-14 lg:text-right\" data-kid=\"2-6-1-2-2-1\" data-name=\"step content 1\">\n                        <div class=\"mono text-[13px] font-semibold tracking-[0.14em] text-[#050a14]\" data-kid=\"2-6-1-2-2-1-1\" data-name=\"step title 1\">\n                            01 — Felmérés és ajánlat\n                        </div>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80 lg:ml-auto max-w-[400px]\" data-kid=\"2-6-1-2-2-1-2\" data-name=\"step description 1\">\n                            Helyszíni bejárás, kockázatfelmérés, létszám- és óraterv. Írásos ajánlat 24 órán belül.\n                        </p>\n                    </div>\n                    <div class=\"hidden lg:flex w-[18px] h-[18px] bg-[#050a14] translate-y-[6px]\" data-kid=\"2-6-1-2-2-2\" data-name=\"step marker 1\">\n                    </div>\n                    <div class=\"hidden lg:block\" data-kid=\"2-6-1-2-2-3\" data-name=\"step spacer 1\">\n                    </div>\n                </div>\n                <!-- step 02 -->\n                <div class=\"relative grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-start gap-6 lg:gap-0 pb-14\" data-kid=\"2-6-1-2-3\" data-name=\"process step 2\">\n                    <div class=\"hidden lg:block\" data-kid=\"2-6-1-2-3-1\" data-name=\"step spacer 2\">\n                    </div>\n                    <div class=\"hidden lg:flex w-[18px] h-[18px] bg-[#050a14] translate-y-[6px]\" data-kid=\"2-6-1-2-3-2\" data-name=\"step marker 2\">\n                    </div>\n                    <div class=\"lg:pl-14\" data-kid=\"2-6-1-2-3-3\" data-name=\"step content 2\">\n                        <div class=\"mono text-[13px] font-semibold tracking-[0.14em] text-[#050a14]\" data-kid=\"2-6-1-2-3-3-1\" data-name=\"step title 2\">\n                            02 — Átvétel és állományozás\n                        </div>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80 max-w-[400px]\" data-kid=\"2-6-1-2-3-3-2\" data-name=\"step description 2\">\n                            Őrutasítás és posztleírás kidolgozása, dedikált állomány kijelölése, betanítás az objektum sajátosságaira.\n                        </p>\n                    </div>\n                </div>\n                <!-- step 03 -->\n                <div class=\"relative grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-start gap-6 lg:gap-0 pb-14\" data-kid=\"2-6-1-2-4\" data-name=\"process step 3\">\n                    <div class=\"lg:pr-14 lg:text-right\" data-kid=\"2-6-1-2-4-1\" data-name=\"step content 3\">\n                        <div class=\"mono text-[13px] font-semibold tracking-[0.14em] text-[#050a14]\" data-kid=\"2-6-1-2-4-1-1\" data-name=\"step title 3\">\n                            03 — Szolgálat és diszpécserháttér\n                        </div>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80 lg:ml-auto max-w-[400px]\" data-kid=\"2-6-1-2-4-1-2\" data-name=\"step description 3\">\n                            0–24 elérhető diszpécser, ellenőrzőkörök, riasztásra történő kivonulás, gépkocsis vagy gyalogos járőrözés.\n                        </p>\n                    </div>\n                    <div class=\"hidden lg:flex w-[18px] h-[18px] bg-[#050a14] translate-y-[6px]\" data-kid=\"2-6-1-2-4-2\" data-name=\"step marker 3\">\n                    </div>\n                    <div class=\"hidden lg:block\" data-kid=\"2-6-1-2-4-3\" data-name=\"step spacer 3\">\n                    </div>\n                </div>\n                <!-- step 04 -->\n                <div class=\"relative grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] items-start gap-6 lg:gap-0\" data-kid=\"2-6-1-2-5\" data-name=\"process step 4\">\n                    <div class=\"hidden lg:block\" data-kid=\"2-6-1-2-5-1\" data-name=\"step spacer 4\">\n                    </div>\n                    <div class=\"hidden lg:flex w-[18px] h-[18px] bg-[#ffc107] border-2 border-[#050a14] translate-y-[6px]\" data-kid=\"2-6-1-2-5-2\" data-name=\"step marker 4\">\n                    </div>\n                    <div class=\"lg:pl-14\" data-kid=\"2-6-1-2-5-3\" data-name=\"step content 4\">\n                        <div class=\"mono text-[13px] font-semibold tracking-[0.14em] text-[#050a14]\" data-kid=\"2-6-1-2-5-3-1\" data-name=\"step title 4\">\n                            04 — Jelentés és ellenőrzés\n                        </div>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80 max-w-[400px]\" data-kid=\"2-6-1-2-5-3-2\" data-name=\"step description 4\">\n                            Szolgálati napló, rendkívüli események írásos jelentése, rendszeres vezetői ellenőrzés és havi értékelés.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 6. COVERAGE (ink band) ================= -->\n    <section class=\"bg-[#050a14] text-white py-20\" data-kid=\"2-7\" data-name=\"coverage section\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-7-1\" data-name=\"coverage section container\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-12 lg:gap-20\" data-kid=\"2-7-1-1\" data-name=\"coverage section grid\">\n                <div data-kid=\"2-7-1-1-1\" data-name=\"coverage section left content\">\n                    <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#ffc107] mb-4\" data-kid=\"2-7-1-1-1-1\" data-name=\"coverage section label\">\n                        03 / Lefedettség\n                    </div>\n                    <h2 class=\"text-[34px] font-extrabold tracking-[-0.03em] leading-[1.1]\" data-kid=\"2-7-1-1-1-2\" data-name=\"coverage section heading\">\n                        Országos lefedettség\n                    </h2>\n                    <p class=\"mt-5 text-[14.5px] leading-[1.7] text-white/75\" data-kid=\"2-7-1-1-1-3\" data-name=\"coverage section lead paragraph\">\n                        Székhelyünkről szervezzük a szolgálatokat, a kivonulás és az állományozás pedig a helyszín igényéhez igazodik.\n                    </p>\n                    <div class=\"mt-7 inline-flex items-center gap-3 bg-[#ffc107] text-[#050a14] px-4 py-2.5 mono text-[11.5px] font-bold uppercase tracking-[0.1em]\" data-kid=\"2-7-1-1-1-4\" data-name=\"coverage time badge\">\n                        <i class=\"ti ti-clock-hour-4 text-[16px]\" data-kid=\"2-7-1-1-1-4-1\" data-name=\"clock icon\">\n                        </i>\n                        Új helyszín indítása 5–10 munkanap\n                    </div>\n                </div>\n                <div class=\"grid grid-cols-1 md:grid-cols-3 border-t border-l border-white/20\" data-kid=\"2-7-1-1-2\" data-name=\"coverage section right details\">\n                    <div class=\"border-r border-b border-white/20 p-7\" data-kid=\"2-7-1-1-2-1\" data-name=\"coverage detail box 1\">\n                        <div class=\"mono text-[10.5px] uppercase tracking-[0.18em] text-white/45\" data-kid=\"2-7-1-1-2-1-1\" data-name=\"coverage detail label 1\">\n                            Székhely\n                        </div>\n                        <div class=\"mt-3 text-[17px] font-bold leading-[1.35]\" data-kid=\"2-7-1-1-2-1-2\" data-name=\"coverage detail value 1\">\n                            2120 Dunakeszi,\n                            <br data-kid=\"2-7-1-1-2-1-2-1\" data-name=\"address line break\"/>\n                            Fő út 69.\n                        </div>\n                        <div class=\"mt-4 mono text-[11px] uppercase tracking-[0.1em] text-[#ffc107]\" data-kid=\"2-7-1-1-2-1-3\" data-name=\"coverage detail note 1\">\n                            Diszpécser 0–24\n                        </div>\n                    </div>\n                    <div class=\"border-r border-b border-white/20 p-7\" data-kid=\"2-7-1-1-2-2\" data-name=\"coverage detail box 2\">\n                        <div class=\"mono text-[10.5px] uppercase tracking-[0.18em] text-white/45\" data-kid=\"2-7-1-1-2-2-1\" data-name=\"coverage detail label 2\">\n                            Kiemelt működési terület\n                        </div>\n                        <ul class=\"mt-3 space-y-2.5 text-[14.5px] leading-[1.45]\" data-kid=\"2-7-1-1-2-2-2\" data-name=\"coverage list 2\">\n                            <li class=\"flex gap-2.5\" data-kid=\"2-7-1-1-2-2-2-1\" data-name=\"coverage list item 2-1\">\n                                <i class=\"ti ti-point-filled text-[#ffc107] text-[16px] leading-[1.35]\" data-kid=\"2-7-1-1-2-2-2-1-1\" data-name=\"list item bullet 2-1\">\n                                </i>\n                                Budapest és Pest megye\n                            </li>\n                            <li class=\"flex gap-2.5\" data-kid=\"2-7-1-1-2-2-2-2\" data-name=\"coverage list item 2-2\">\n                                <i class=\"ti ti-point-filled text-[#ffc107] text-[16px] leading-[1.35]\" data-kid=\"2-7-1-1-2-2-2-2-1\" data-name=\"list item bullet 2-2\">\n                                </i>\n                                Közép-Magyarország\n                            </li>\n                        </ul>\n                    </div>\n                    <div class=\"border-r border-b border-white/20 p-7\" data-kid=\"2-7-1-1-2-3\" data-name=\"coverage detail box 3\">\n                        <div class=\"mono text-[10.5px] uppercase tracking-[0.18em] text-white/45\" data-kid=\"2-7-1-1-2-3-1\" data-name=\"coverage detail label 3\">\n                            Ezen kívül\n                        </div>\n                        <p class=\"mt-3 text-[14.5px] leading-[1.55]\" data-kid=\"2-7-1-1-2-3-2\" data-name=\"coverage detail text 3\">\n                            Országos kivonulás egyedi megállapodás szerint.\n                        </p>\n                        <p class=\"mt-4 mono text-[11px] uppercase tracking-[0.1em] text-white/45\" data-kid=\"2-7-1-1-2-3-3\" data-name=\"coverage detail note 3\">\n                            Egyeztetés: ajánlatkéréskor\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 7. LICENCES / CERTIFICATE ================= -->\n    <section class=\"bg-white py-20\" data-kid=\"2-8\" data-name=\"licensing section\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-8-1\" data-name=\"licensing section container\">\n            <div class=\"bg-[#f3f4f6] border border-[#050a14] p-3\" data-kid=\"2-8-1-1\" data-name=\"licensing box wrapper\">\n                <div class=\"border border-[#050a14]/30 px-8 lg:px-14 py-12\" data-kid=\"2-8-1-1-1\" data-name=\"licensing internal content\">\n                    <div class=\"flex flex-wrap items-end justify-between gap-6 mb-10\" data-kid=\"2-8-1-1-1-1\" data-name=\"licensing header container\">\n                        <div data-kid=\"2-8-1-1-1-1-1\" data-name=\"licensing label\">\n                            <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-8-1-1-1-1-1-1\" data-name=\"licensing section title\">\n                                04 / Megfelelés\n                            </div>\n                            <h2 class=\"text-[32px] font-extrabold tracking-[-0.03em] leading-[1.12] max-w-[560px]\" data-kid=\"2-8-1-1-1-1-1-2\">\n                                Engedélyek, biztosítás, alkalmassági követelmények\n                            </h2>\n                        </div>\n                        <div class=\"mono text-[10.5px] uppercase tracking-[0.16em] text-[#050a14]/55 border-l-2 border-[#ffc107] pl-4 leading-[1.8]\" data-kid=\"2-8-1-1-1-1-2\" data-name=\"licensing metadata\">\n                            Kiállítva: Dunakeszi\n                            <br data-kid=\"2-8-1-1-1-1-2-1\" data-name=\"metadata line break\"/>\n                            Hatály: folyamatos\n                        </div>\n                    </div>\n                    <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-14 gap-y-1\" data-kid=\"2-8-1-1-1-2\" data-name=\"licensing grid\">\n                        <div class=\"flex items-start gap-4 py-4 border-b border-[#050a14]/15\" data-kid=\"2-8-1-1-1-2-1\" data-name=\"licensing item 1\">\n                            <i class=\"ti ti-shield-check text-[22px] text-[#050a14] mt-[2px]\" data-kid=\"2-8-1-1-1-2-1-1\" data-name=\"licensing icon 1\">\n                            </i>\n                            <span class=\"text-[15px] leading-[1.55] font-medium\" data-kid=\"2-8-1-1-1-2-1-2\" data-name=\"licensing text 1\">\n                                Vagyonvédelmi tevékenységi engedély és kamarai nyilvántartás\n                            </span>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-4 border-b border-[#050a14]/15\" data-kid=\"2-8-1-1-1-2-2\" data-name=\"licensing item 2\">\n                            <i class=\"ti ti-file-text text-[22px] text-[#050a14] mt-[2px]\" data-kid=\"2-8-1-1-1-2-2-1\" data-name=\"licensing icon 2\">\n                            </i>\n                            <span class=\"text-[15px] leading-[1.55] font-medium\" data-kid=\"2-8-1-1-1-2-2-2\" data-name=\"licensing text 2\">\n                                Szakmai felelősségbiztosítás\n                            </span>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-4 border-b border-[#050a14]/15\" data-kid=\"2-8-1-1-1-2-3\" data-name=\"licensing item 3\">\n                            <i class=\"ti ti-user-check text-[22px] text-[#050a14] mt-[2px]\" data-kid=\"2-8-1-1-1-2-3-1\" data-name=\"licensing icon 3\">\n                            </i>\n                            <span class=\"text-[15px] leading-[1.55] font-medium\" data-kid=\"2-8-1-1-1-2-3-2\" data-name=\"licensing text 3\">\n                                Feddhetetlenségi vizsgálat minden munkatársnál\n                            </span>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-4 border-b border-[#050a14]/15\" data-kid=\"2-8-1-1-1-2-4\" data-name=\"licensing item 4\">\n                            <i class=\"ti ti-stethoscope text-[22px] text-[#050a14] mt-[2px]\" data-kid=\"2-8-1-1-1-2-4-1\" data-name=\"licensing icon 4\">\n                            </i>\n                            <span class=\"text-[15px] leading-[1.55] font-medium\" data-kid=\"2-8-1-1-1-2-4-2\" data-name=\"licensing text 4\">\n                                Kétévente kötelező orvosi és pszichológiai vizsgálat\n                            </span>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-4 border-b border-[#050a14]/15 md:border-b-0\" data-kid=\"2-8-1-1-1-2-5\" data-name=\"licensing item 5\">\n                            <i class=\"ti ti-flag text-[22px] text-[#050a14] mt-[2px]\" data-kid=\"2-8-1-1-1-2-5-1\" data-name=\"licensing icon 5\">\n                            </i>\n                            <span class=\"text-[15px] leading-[1.55] font-medium\" data-kid=\"2-8-1-1-1-2-5-2\" data-name=\"licensing text 5\">\n                                100%-ban magyar tulajdonú társaság, stabil tőkeháttérrel\n                            </span>\n                        </div>\n                        <div class=\"flex items-start gap-4 py-4\" data-kid=\"2-8-1-1-1-2-6\" data-name=\"licensing item 6\">\n                            <i class=\"ti ti-calendar-check text-[22px] text-[#050a14] mt-[2px]\" data-kid=\"2-8-1-1-1-2-6-1\" data-name=\"licensing icon 6\">\n                            </i>\n                            <span class=\"text-[15px] leading-[1.55] font-medium\" data-kid=\"2-8-1-1-1-2-6-2\" data-name=\"licensing text 6\">\n                                2019 óta folyamatos működés\n                            </span>\n                        </div>\n                    </div>\n                    <p class=\"mt-9 pt-6 border-t border-[#050a14]/20 text-[13px] italic text-[#6b7280]\" data-kid=\"2-8-1-1-1-3\" data-name=\"licensing footer text\">\n                        A dokumentumok másolata ajánlatkérésre rendelkezésre áll.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 8. ABOUT ================= -->\n    <section class=\"bg-white pb-20\" data-kid=\"2-9\" data-name=\"about section\" id=\"about\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-9-1\" data-name=\"about section container\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-[440px_1fr] gap-12 lg:gap-16 items-start\" data-kid=\"2-9-1-1\" data-name=\"about grid\">\n                <div class=\"ph border border-[#050a14] overflow-hidden\" data-kid=\"2-9-1-1-1\" data-name=\"about image wrapper\">\n                    <img alt=\"Szolgálatot teljesítő biztonsági munkatárs irodaházban\" class=\"photo w-full h-[520px] object-cover\" data-kid=\"2-9-1-1-1-1\" data-name=\"about image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image5.jpeg\"/>\n                    <div class=\"mono text-[10.5px] uppercase tracking-[0.16em] text-[#050a14]/70 border-t border-[#050a14] px-5 py-3 bg-[#f3f4f6]\" data-kid=\"2-9-1-1-1-2\" data-name=\"about image caption\">\n                        Szolgálatban · irodaházi poszt\n                    </div>\n                </div>\n                <div data-kid=\"2-9-1-1-2\" data-name=\"about content\">\n                    <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-9-1-1-2-1\" data-name=\"about section label\">\n                        05 / Rólunk\n                    </div>\n                    <h2 class=\"text-[36px] font-extrabold tracking-[-0.03em] leading-[1.1]\" data-kid=\"2-9-1-1-2-2\" data-name=\"about section heading\">\n                        Rólunk\n                    </h2>\n                    <p class=\"mt-6 text-[19px] leading-[1.55] font-medium max-w-[640px]\" data-kid=\"2-9-1-1-2-3\" data-name=\"about lead text\">\n                        A Dog Race Security Kft. 2019 óta van jelen a magyar vagyonvédelmi és takarítási\n            szolgáltatásokat nyújtó cégek piacán.\n                    </p>\n                    <div class=\"mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-8\" data-kid=\"2-9-1-1-2-4\" data-name=\"about info grid\">\n                        <div data-kid=\"2-9-1-1-2-4-1\" data-name=\"about column 1\">\n                            <h3 class=\"mono text-[11px] font-semibold uppercase tracking-[0.16em] text-[#050a14] border-l-2 border-[#ffc107] pl-3\" data-kid=\"2-9-1-1-2-4-1-1\" data-name=\"about col 1 label\">\n                                Tevékenységi köreink\n                            </h3>\n                            <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80\" data-kid=\"2-9-1-1-2-4-1-2\" data-name=\"about col 1 text\">\n                                Létesítmények és irodaházak őrzése, építési területek őrzésvédelme, vagyonvédelmi és\n                tűzvédelmi rendszerek – beléptető- és kamerarendszerek – telepítése és igény szerinti\n                karbantartása, valamint rendezvények biztosítása.\n                            </p>\n                        </div>\n                        <div data-kid=\"2-9-1-1-2-4-2\" data-name=\"about column 2\">\n                            <h3 class=\"mono text-[11px] font-semibold uppercase tracking-[0.16em] text-[#050a14] border-l-2 border-[#ffc107] pl-3\" data-kid=\"2-9-1-1-2-4-2-1\" data-name=\"about col 2 label\">\n                                Háttér és tulajdonosi szerkezet\n                            </h3>\n                            <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80\" data-kid=\"2-9-1-1-2-4-2-2\" data-name=\"about col 2 text\">\n                                100%-ban magyar tulajdonú cégünk stabil tőkeháttérrel és többéves szakmai\n                tapasztalattal, a hazai piaci igények alapos ismeretével nyújt teljes körű\n                szolgáltatást üzleti ügyfelei részére.\n                            </p>\n                        </div>\n                        <div class=\"md:col-span-2\" data-kid=\"2-9-1-1-2-4-3\" data-name=\"about full width column\">\n                            <h3 class=\"mono text-[11px] font-semibold uppercase tracking-[0.16em] text-[#050a14] border-l-2 border-[#ffc107] pl-3\" data-kid=\"2-9-1-1-2-4-3-1\" data-name=\"about full label\">\n                                Ügyfélkezelés\n                            </h3>\n                            <p class=\"mt-3 text-[14.5px] leading-[1.7] text-[#050a14]/80 max-w-[700px]\" data-kid=\"2-9-1-1-2-4-3-2\" data-name=\"about full text\">\n                                Célunk, hogy Ügyfeleinket ne csak a szerződéskötés pillanatáig kezeljük kitüntetett\n                figyelemmel, hanem a szolgáltatás teljes időtartama alatt készen álljunk minden\n                felmerülő igény azonnali kiszolgálására – erről eddigi megrendelőink is tanúskodhatnak.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-10 border-t border-[#050a14] pt-6 flex flex-wrap gap-x-10 gap-y-3 mono text-[11px] uppercase tracking-[0.12em] text-[#050a14]/70\" data-kid=\"2-9-1-1-2-5\" data-name=\"about stats footer\">\n                        <span data-kid=\"2-9-1-1-2-5-1\" data-name=\"about stat 1\">\n                            Alapítás: 2019\n                        </span>\n                        <span data-kid=\"2-9-1-1-2-5-2\" data-name=\"about stat 2\">\n                            Székhely: Dunakeszi\n                        </span>\n                        <span data-kid=\"2-9-1-1-2-5-3\" data-name=\"about stat 3\">\n                            Állomány: 40+ fő\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 9. QUOTES ================= -->\n    <section class=\"bg-[#f3f4f6] border-y border-[#050a14] py-20\" data-kid=\"2-10\" data-name=\"quotes section\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-10-1\" data-name=\"quotes section container\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4 mb-12\" data-kid=\"2-10-1-1\" data-name=\"quotes header\">\n                <div data-kid=\"2-10-1-1-1\" data-name=\"quotes section label container\">\n                    <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-10-1-1-1-1\" data-name=\"quotes section label\">\n                        06 / Visszajelzés\n                    </div>\n                    <h2 class=\"text-[36px] font-extrabold tracking-[-0.03em] leading-[1.1]\" data-kid=\"2-10-1-1-1-2\" data-name=\"quotes section heading\">\n                        Ügyfeleink mondták\n                    </h2>\n                </div>\n                <span class=\"mono text-[10.5px] uppercase tracking-[0.16em] text-[#6b7280] border border-[#050a14]/25 px-3 py-1.5\" data-kid=\"2-10-1-1-2\" data-name=\"quotes status badge\">\n                    [ jóváhagyásra vár ]\n                </span>\n            </div>\n            <div class=\"grid grid-cols-1 lg:grid-cols-2 border-t border-l border-[#050a14]\" data-kid=\"2-10-1-2\" data-name=\"quotes grid\">\n                <blockquote class=\"border-r border-b border-[#050a14] bg-white p-10 flex flex-col\" data-kid=\"2-10-1-2-1\" data-name=\"quote 1\">\n                    <i class=\"ti ti-quote text-[28px] text-[#ffc107] mb-5\" data-kid=\"2-10-1-2-1-1\" data-name=\"quote 1 icon\">\n                    </i>\n                    <p class=\"text-[21px] leading-[1.5] font-medium tracking-[-0.01em]\" data-kid=\"2-10-1-2-1-2\" data-name=\"quote 1 text\">\n                        „Éjszakai és hétvégi szolgálatot vettünk át tőlük egy hét alatt, a jelentések azóta\n            minden hétfőn az asztalunkon vannak.”\n                    </p>\n                    <footer class=\"mt-8 pt-5 border-t border-[#050a14]/15 mono text-[11px] uppercase tracking-[0.14em] text-[#050a14]/70\" data-kid=\"2-10-1-2-1-3\" data-name=\"quote 1 footer\">\n                        Létesítménygazdálkodási vezető, ipari park\n                    </footer>\n                </blockquote>\n                <blockquote class=\"border-r border-b border-[#050a14] bg-white p-10 flex flex-col\" data-kid=\"2-10-1-2-2\" data-name=\"quote 2\">\n                    <i class=\"ti ti-quote text-[28px] text-[#ffc107] mb-5\" data-kid=\"2-10-1-2-2-1\" data-name=\"quote 2 icon\">\n                    </i>\n                    <p class=\"text-[21px] leading-[1.5] font-medium tracking-[-0.01em]\" data-kid=\"2-10-1-2-2-2\" data-name=\"quote 2 text\">\n                        „Az őrök megjelenése és a diszpécser elérhetősége az, amiért maradtunk.”\n                    </p>\n                    <footer class=\"mt-8 pt-5 border-t border-[#050a14]/15 mono text-[11px] uppercase tracking-[0.14em] text-[#050a14]/70\" data-kid=\"2-10-1-2-2-3\" data-name=\"quote 2 footer\">\n                        Beruházási igazgató, építőipar\n                    </footer>\n                </blockquote>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 10. REFERENCES ================= -->\n    <section class=\"bg-white py-20\" data-kid=\"2-11\" data-name=\"references section\" id=\"references\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-11-1\" data-name=\"references section container\">\n            <div class=\"flex flex-wrap items-end justify-between gap-4 mb-12\" data-kid=\"2-11-1-1\" data-name=\"references header\">\n                <div data-kid=\"2-11-1-1-1\" data-name=\"references section label container\">\n                    <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-11-1-1-1-1\" data-name=\"references section label\">\n                        07 / Referenciák\n                    </div>\n                    <h2 class=\"text-[36px] font-extrabold tracking-[-0.03em] leading-[1.1]\" data-kid=\"2-11-1-1-1-2\" data-name=\"references section heading\">\n                        Referenciák\n                    </h2>\n                </div>\n                <p class=\"mono text-[11px] uppercase tracking-[0.14em] text-[#050a14]/60\" data-kid=\"2-11-1-1-2\" data-name=\"references lead text\">\n                    Partnercégeink megbíznak bennünk\n                </p>\n            </div>\n            <div class=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 border-t border-l border-[#050a14]\" data-kid=\"2-11-1-2\" data-name=\"references logo grid\">\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-1\" data-name=\"logo 1\">\n                    <img alt=\"ATEV Zrt.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-1-1\" data-name=\"logo 1 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/atev.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-2\" data-name=\"logo 2\">\n                    <img alt=\"STRABAG\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-2-1\" data-name=\"logo 2 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/strabag.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-3\" data-name=\"logo 3\">\n                    <img alt=\"Proform Ingatlanbefektetési Zrt.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-3-1\" data-name=\"logo 3 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/proform.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-4\" data-name=\"logo 4\">\n                    <img alt=\"Titán 94 Kft.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-4-1\" data-name=\"logo 4 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/titan-94.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-5\" data-name=\"logo 5\">\n                    <img alt=\"Toperini Ipari Park\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-5-1\" data-name=\"logo 5 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/toperini-ipari-park.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-6\" data-name=\"logo 6\">\n                    <img alt=\"Pallér Csarnok\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-6-1\" data-name=\"logo 6 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/paller-csarnok.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-7\" data-name=\"logo 7\">\n                    <img alt=\"Légió 2000 Security\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-7-1\" data-name=\"logo 7 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/legio-2000-security.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-8\" data-name=\"logo 8\">\n                    <img alt=\"HDR Hard Dog Race\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-8-1\" data-name=\"logo 8 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/hdr-hard-dog-race.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-9\" data-name=\"logo 9\">\n                    <img alt=\"Dogatlon\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-9-1\" data-name=\"logo 9 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dogatlon.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-10\" data-name=\"logo 10\">\n                    <img alt=\"DPD\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-10-1\" data-name=\"logo 10 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dpd.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-11\" data-name=\"logo 11\">\n                    <img alt=\"TRT Europe\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-11-1\" data-name=\"logo 11 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/trt-europe.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-12\" data-name=\"logo 12\">\n                    <img alt=\"Republic Group\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-12-1\" data-name=\"logo 12 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/republic-group.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-13\" data-name=\"logo 13\">\n                    <img alt=\"LBT Kft.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-13-1\" data-name=\"logo 13 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/lbt-kft.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-14\" data-name=\"logo 14\">\n                    <img alt=\"dr. Lenkei Vitamin\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-14-1\" data-name=\"logo 14 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dr-lenkei-vitamin.png\"/>\n                </div>\n                <div class=\"logo-chip border-r border-b border-[#050a14] h-[118px] grid place-items-center p-6 bg-white\" data-kid=\"2-11-1-2-15\" data-name=\"logo 15\">\n                    <img alt=\"Yellow Premium Bananas\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-11-1-2-15-1\" data-name=\"logo 15 img\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/yellow-premium-bananas.png\"/>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 11. CONTACT ================= -->\n    <section class=\"bg-[#f3f4f6] border-t border-[#050a14] py-20\" data-kid=\"2-12\" data-name=\"contact section\" id=\"contact\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-12-1\" data-name=\"contact section container\">\n            <div class=\"mb-12\" data-kid=\"2-12-1-1\" data-name=\"contact section header\">\n                <div class=\"mono text-[11px] font-semibold uppercase tracking-[0.22em] text-[#050a14]/60 mb-4\" data-kid=\"2-12-1-1-1\" data-name=\"contact section label\">\n                    08 / Kapcsolat\n                </div>\n                <h2 class=\"text-[36px] font-extrabold tracking-[-0.03em] leading-[1.1]\" data-kid=\"2-12-1-1-2\" data-name=\"contact section heading\">\n                    Kérjen ajánlatot\n                </h2>\n                <p class=\"mt-4 text-[15px] leading-[1.7] text-[#050a14]/80 max-w-[560px]\" data-kid=\"2-12-1-1-3\" data-name=\"contact section lead paragraph\">\n                    Írja le, mit kell őriznünk, és 24 órán belül írásos ajánlatot adunk. Sürgős esetben\n          hívjon: a diszpécser 0–24 elérhető.\n                </p>\n            </div>\n            <div class=\"grid grid-cols-1 lg:grid-cols-[1.15fr_1fr] border-t border-l border-[#050a14]\" data-kid=\"2-12-1-2\" data-name=\"contact layout\">\n                <!-- form -->\n                <div class=\"border-r border-b border-[#050a14] bg-white p-10\" data-kid=\"2-12-1-2-1\" data-name=\"contact form wrapper\">\n                    <div class=\"mono text-[10.5px] uppercase tracking-[0.18em] text-[#050a14]/55 mb-8\" data-kid=\"2-12-1-2-1-1\" data-name=\"form title\">\n                        Ajánlatkérő adatlap\n                    </div>\n                    <form data-dynamic=\"true\" data-kid=\"2-12-1-2-1-2\" data-name=\"contact form\" data-reason=\"text/form values submitted via script\">\n                        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-7\" data-kid=\"2-12-1-2-1-2-1\" data-name=\"form fields container\">\n                            <div data-kid=\"2-12-1-2-1-2-1-1\" data-name=\"field label 1\">\n                                <label class=\"mono block text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[#050a14] mb-1\" data-kid=\"2-12-1-2-1-2-1-1-1\" data-name=\"field name label\" for=\"f-nev\">\n                                    Név\n                                </label>\n                                <input class=\"field\" data-kid=\"2-12-1-2-1-2-1-1-2\" data-name=\"field name input\" id=\"f-nev\" name=\"nev\" placeholder=\"Kovács Péter\" type=\"text\"/>\n                            </div>\n                            <div data-kid=\"2-12-1-2-1-2-1-2\" data-name=\"field label 2\">\n                                <label class=\"mono block text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[#050a14] mb-1\" data-kid=\"2-12-1-2-1-2-1-2-1\" data-name=\"field company label\" for=\"f-ceg\">\n                                    Cég\n                                </label>\n                                <input class=\"field\" data-kid=\"2-12-1-2-1-2-1-2-2\" data-name=\"field company input\" id=\"f-ceg\" name=\"ceg\" placeholder=\"Példa Kft.\" type=\"text\"/>\n                            </div>\n                            <div data-kid=\"2-12-1-2-1-2-1-3\" data-name=\"field label 3\">\n                                <label class=\"mono block text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[#050a14] mb-1\" data-kid=\"2-12-1-2-1-2-1-3-1\" data-name=\"field phone label\" for=\"f-tel\">\n                                    Telefonszám\n                                </label>\n                                <input class=\"field\" data-kid=\"2-12-1-2-1-2-1-3-2\" data-name=\"field phone input\" id=\"f-tel\" name=\"telefon\" placeholder=\"+36 30 123 4567\" type=\"tel\"/>\n                            </div>\n                            <div data-kid=\"2-12-1-2-1-2-1-4\" data-name=\"field label 4\">\n                                <label class=\"mono block text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[#050a14] mb-1\" data-kid=\"2-12-1-2-1-2-1-4-1\" data-name=\"field email label\" for=\"f-email\">\n                                    E-mail\n                                </label>\n                                <input class=\"field\" data-kid=\"2-12-1-2-1-2-1-4-2\" data-name=\"field email input\" id=\"f-email\" name=\"email\" placeholder=\"nev@pelda.hu\" type=\"email\"/>\n                            </div>\n                            <div class=\"md:col-span-2\" data-kid=\"2-12-1-2-1-2-1-5\" data-name=\"field label 5\">\n                                <label class=\"mono block text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[#050a14] mb-1\" data-kid=\"2-12-1-2-1-2-1-5-1\" data-name=\"field object label\" for=\"f-tipus\">\n                                    Objektum típusa\n                                </label>\n                                <select class=\"field\" data-kid=\"2-12-1-2-1-2-1-5-2\" data-name=\"field object select\" id=\"f-tipus\" name=\"tipus\">\n                                    <option data-kid=\"2-12-1-2-1-2-1-5-2-1\" data-name=\"object option 1\">\n                                        Irodaház\n                                    </option>\n                                    <option data-kid=\"2-12-1-2-1-2-1-5-2-2\" data-name=\"object option 2\">\n                                        Ipari park / telephely\n                                    </option>\n                                    <option data-kid=\"2-12-1-2-1-2-1-5-2-3\" data-name=\"object option 3\">\n                                        Építési terület\n                                    </option>\n                                    <option data-kid=\"2-12-1-2-1-2-1-5-2-4\" data-name=\"object option 4\">\n                                        Logisztikai központ\n                                    </option>\n                                    <option data-kid=\"2-12-1-2-1-2-1-5-2-5\" data-name=\"object option 5\">\n                                        Rendezvény\n                                    </option>\n                                    <option data-kid=\"2-12-1-2-1-2-1-5-2-6\" data-name=\"object option 6\">\n                                        Egyéb\n                                    </option>\n                                </select>\n                            </div>\n                            <div class=\"md:col-span-2\" data-kid=\"2-12-1-2-1-2-1-6\" data-name=\"field label 6\">\n                                <label class=\"mono block text-[10.5px] font-semibold uppercase tracking-[0.14em] text-[#050a14] mb-1\" data-kid=\"2-12-1-2-1-2-1-6-1\" data-name=\"field msg label\" for=\"f-msg\">\n                                    Üzenet\n                                </label>\n                                <textarea class=\"field\" data-kid=\"2-12-1-2-1-2-1-6-2\" data-name=\"field msg input\" id=\"f-msg\" name=\"uzenet\" placeholder=\"Helyszín, óraszám, kezdés tervezett ideje…\" rows=\"4\"></textarea>\n                            </div>\n                        </div>\n                        <div class=\"mt-9 flex flex-wrap items-center gap-5\" data-kid=\"2-12-1-2-1-2-2\" data-name=\"form action group\">\n                            <button class=\"yellow-btn bg-[#ffc107] border-2 border-[#050a14] px-7 py-4 mono text-[12px] font-bold uppercase tracking-[0.12em]\" data-kid=\"2-12-1-2-1-2-2-1\" data-name=\"submit button\" type=\"submit\">\n                                Ajánlatkérés elküldése\n                            </button>\n                            <p class=\"mono text-[10.5px] uppercase tracking-[0.1em] text-[#6b7280] max-w-[210px] leading-[1.7]\" data-kid=\"2-12-1-2-1-2-2-2\" data-name=\"form note\">\n                                A gomb az e-mail kliensét nyitja meg az adatokkal.\n                            </p>\n                        </div>\n                    </form>\n                </div>\n                <!-- details + map -->\n                <div class=\"border-r border-b border-[#050a14] bg-[#050a14] text-white flex flex-col\" data-kid=\"2-12-1-2-2\" data-name=\"contact details area\">\n                    <div class=\"p-10\" data-kid=\"2-12-1-2-2-1\" data-name=\"contact info box\">\n                        <div class=\"mono text-[10.5px] uppercase tracking-[0.18em] text-[#ffc107] mb-8\" data-kid=\"2-12-1-2-2-1-1\" data-name=\"contact info label\">\n                            Elérhetőség\n                        </div>\n                        <div class=\"divide-y divide-white/15\" data-kid=\"2-12-1-2-2-1-2\" data-name=\"contact info list\">\n                            <div class=\"flex items-start gap-4 py-5\" data-kid=\"2-12-1-2-2-1-2-1\" data-name=\"contact info item 1\">\n                                <i class=\"ti ti-map-pin text-[20px] text-[#ffc107] mt-[2px]\" data-kid=\"2-12-1-2-2-1-2-1-1\" data-name=\"contact icon 1\">\n                                </i>\n                                <div data-kid=\"2-12-1-2-2-1-2-1-2\" data-name=\"contact box 1\">\n                                    <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-white/45\" data-kid=\"2-12-1-2-2-1-2-1-2-1\" data-name=\"contact label 1\">\n                                        Cím\n                                    </div>\n                                    <div class=\"mt-1 text-[15.5px] font-medium\" data-kid=\"2-12-1-2-2-1-2-1-2-2\" data-name=\"contact value 1\">\n                                        2120 Dunakeszi, Fő út 69.\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"flex items-start gap-4 py-5\" data-kid=\"2-12-1-2-2-1-2-2\" data-name=\"contact info item 2\">\n                                <i class=\"ti ti-phone text-[20px] text-[#ffc107] mt-[2px]\" data-kid=\"2-12-1-2-2-1-2-2-1\" data-name=\"contact icon 2\">\n                                </i>\n                                <div data-kid=\"2-12-1-2-2-1-2-2-2\" data-name=\"contact box 2\">\n                                    <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-white/45\" data-kid=\"2-12-1-2-2-1-2-2-2-1\" data-name=\"contact label 2\">\n                                        Telefonszám\n                                    </div>\n                                    <a class=\"mt-1 block text-[15.5px] font-medium hover:text-[#ffc107]\" data-kid=\"2-12-1-2-2-1-2-2-2-2\" data-name=\"contact value 2\" href=\"tel:+36706069802\">\n                                        06 70 606 9802\n                                    </a>\n                                </div>\n                            </div>\n                            <div class=\"flex items-start gap-4 py-5\" data-kid=\"2-12-1-2-2-1-2-3\" data-name=\"contact info item 3\">\n                                <i class=\"ti ti-mail text-[20px] text-[#ffc107] mt-[2px]\" data-kid=\"2-12-1-2-2-1-2-3-1\" data-name=\"contact icon 3\">\n                                </i>\n                                <div data-kid=\"2-12-1-2-2-1-2-3-2\" data-name=\"contact box 3\">\n                                    <div class=\"mono text-[10px] uppercase tracking-[0.16em] text-white/45\" data-kid=\"2-12-1-2-2-1-2-3-2-1\" data-name=\"contact label 3\">\n                                        E-mail\n                                    </div>\n                                    <a class=\"mt-1 block text-[15.5px] font-medium hover:text-[#ffc107] break-all\" data-kid=\"2-12-1-2-2-1-2-3-2-2\" data-name=\"contact value 3\" href=\"mailto:dograceseckft@gmail.com\">\n                                        dograceseckft@gmail.com\n                                    </a>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-auto border-t border-white/20\" data-kid=\"2-12-1-2-2-2\" data-name=\"map wrapper\">\n                        <iframe class=\"mapframe w-full h-[260px] block border-0\" data-kid=\"2-12-1-2-2-2-1\" data-name=\"embedded map\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps?q=2120+Dunakeszi,+F%C5%91+%C3%BAt+69&output=embed\" title=\"DOG RACE SECURITY Kft. térkép\">\n                        </iframe>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ================= 12. FOOTER ================= -->\n    <footer class=\"bg-[#050a14] text-white pt-14\" data-kid=\"2-13\" data-name=\"footer\">\n        <div class=\"mx-auto max-w-[1320px] px-8\" data-kid=\"2-13-1\" data-name=\"footer main container\">\n            <div class=\"flex flex-wrap items-center justify-between gap-8 pb-10 border-b border-white/15\" data-kid=\"2-13-1-1\" data-name=\"footer top row\">\n                <img alt=\"DOG RACE SECURITY Kft. logó\" data-kid=\"2-13-1-1-1\" data-name=\"footer logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\" style=\"height:44px;width:auto;\"/>\n                <nav aria-label=\"Lábléc navigáció\" class=\"flex flex-wrap gap-x-8 gap-y-3 mono text-[11px] font-semibold uppercase tracking-[0.14em] text-white/70\" data-kid=\"2-13-1-1-2\" data-name=\"footer nav\">\n                    <a class=\"hover:text-[#ffc107]\" data-kid=\"2-13-1-1-2-1\" data-name=\"footer nav link 1\" href=\"#services\">\n                        Szolgáltatások\n                    </a>\n                    <a class=\"hover:text-[#ffc107]\" data-kid=\"2-13-1-1-2-2\" data-name=\"footer nav link 2\" href=\"#about\">\n                        Rólunk\n                    </a>\n                    <a class=\"hover:text-[#ffc107]\" data-kid=\"2-13-1-1-2-3\" data-name=\"footer nav link 3\" href=\"#process\">\n                        Folyamat\n                    </a>\n                    <a class=\"hover:text-[#ffc107]\" data-kid=\"2-13-1-1-2-4\" data-name=\"footer nav link 4\" href=\"#references\">\n                        Referenciák\n                    </a>\n                    <a class=\"hover:text-[#ffc107]\" data-kid=\"2-13-1-1-2-5\" data-name=\"footer nav link 5\" href=\"#contact\">\n                        Kapcsolat\n                    </a>\n                </nav>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-between gap-4 py-7\" data-kid=\"2-13-1-2\" data-name=\"footer bottom row\">\n                <p class=\"mono text-[11px] uppercase tracking-[0.1em] text-white/50\" data-kid=\"2-13-1-2-1\" data-name=\"footer copyright\">\n                    © 2026 Dog Race Security Kft. Minden jog fenntartva.\n                </p>\n                <div class=\"flex gap-6 mono text-[11px] uppercase tracking-[0.1em]\" data-kid=\"2-13-1-2-2\" data-name=\"footer policy links\">\n                    <a class=\"underline underline-offset-4 text-white/70 hover:text-[#ffc107]\" data-kid=\"2-13-1-2-2-1\" data-name=\"footer link 1\" href=\"/adatkezelesi-tajekoztato\">\n                        Adatkezelési tájékoztató\n                    </a>\n                    <a class=\"underline underline-offset-4 text-white/70 hover:text-[#ffc107]\" data-kid=\"2-13-1-2-2-2\" data-name=\"footer link 2\" href=\"/aszf\">\n                        Általános szerződési feltételek\n                    </a>\n                </div>\n            </div>\n        </div>\n        <!-- static demo of the mobile sticky bar -->\n        <div class=\"mx-auto max-w-[1320px] px-8 pb-12\" data-kid=\"2-13-2\" data-name=\"sticky bar static demo\">\n            <div class=\"mono text-[10px] uppercase tracking-[0.18em] text-white/35 mb-3\" data-kid=\"2-13-2-1\" data-name=\"demo title\">\n                Mobil sticky sáv (700px alatt jelenik meg)\n            </div>\n            <div class=\"max-w-[380px] border border-white/20\" data-kid=\"2-13-2-2\" data-name=\"sticky demo wrapper\">\n                <div class=\"flex\" data-kid=\"2-13-2-2-1\" data-name=\"demo links container\">\n                    <a class=\"flex-1 flex items-center justify-center gap-2 bg-[#ffc107] text-[#050a14] py-4 mono text-[12px] font-bold uppercase tracking-[0.12em] border-r-2 border-[#050a14]\" data-kid=\"2-13-2-2-1-1\" data-name=\"demo call button\" href=\"tel:+36706069802\">\n                        <i class=\"ti ti-phone text-[16px]\" data-kid=\"2-13-2-2-1-1-1\" data-name=\"call icon\">\n                        </i>\n                        Hívás\n                    </a>\n                    <a class=\"flex-1 flex items-center justify-center gap-2 bg-[#ffc107] text-[#050a14] py-4 mono text-[12px] font-bold uppercase tracking-[0.12em]\" data-kid=\"2-13-2-2-1-2\" data-name=\"demo request button\" href=\"#contact\">\n                        <i class=\"ti ti-file-text text-[16px]\" data-kid=\"2-13-2-2-1-2-1\" data-name=\"request icon\">\n                        </i>\n                        Ajánlatkérés\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- ================= 13. STICKY MOBILE CALL / QUOTE BAR (live, <700px) ================= -->\n    <div class=\"fixed bottom-0 left-0 right-0 z-50 lg:hidden border-t-2 border-[#050a14] flex\" data-kid=\"2-14\" data-name=\"sticky mobile bar\">\n        <a class=\"flex-1 flex items-center justify-center gap-2 bg-[#ffc107] text-[#050a14] py-4 mono text-[12px] font-bold uppercase tracking-[0.12em] border-r-2 border-[#050a14]\" data-kid=\"2-14-1\" data-name=\"sticky call button\" href=\"tel:+36706069802\">\n            <i class=\"ti ti-phone text-[16px]\" data-kid=\"2-14-1-1\" data-name=\"sticky call icon\">\n            </i>\n            Hívás\n        </a>\n        <a class=\"flex-1 flex items-center justify-center gap-2 bg-[#ffc107] text-[#050a14] py-4 mono text-[12px] font-bold uppercase tracking-[0.12em]\" data-kid=\"2-14-2\" data-name=\"sticky request button\" href=\"#contact\">\n            <i class=\"ti ti-file-text text-[16px]\" data-kid=\"2-14-2-1\" data-name=\"sticky request icon\">\n            </i>\n            Ajánlatkérés\n        </a>\n    </div>\n</div>\n",
