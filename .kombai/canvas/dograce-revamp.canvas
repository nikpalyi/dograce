    "var_68b847849655": {
      "type": "variant",
      "label": "B — Command Center (dark tactical, alert red)",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<link data-kid=\"1\" data-name=\"webfont stylesheet link\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<style>\n    @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500;600&display=swap');\n\n  .dr { font-family: 'Roboto', system-ui, sans-serif; }\n  .dsp { font-family: 'Oswald', 'Roboto', sans-serif; text-transform: uppercase; }\n  .mono { font-family: 'Roboto Mono', ui-monospace, monospace; }\n\n  /* cinematic cooled photo treatment */\n  .cine { filter: brightness(.84) sepia(.16) hue-rotate(172deg) saturate(1.18) contrast(1.04); transition: filter .45s ease, transform .6s ease; }\n  .group:hover .cine { filter: brightness(.98) sepia(.06) hue-rotate(172deg) saturate(1.1) contrast(1.02); }\n\n  /* reticle corner markers — 2px L shapes, sides left open */\n  .retic { position: relative; }\n  .retic::before, .retic::after {\n    content: \"\"; position: absolute; width: 20px; height: 20px; pointer-events: none; z-index: 2;\n    border-color: rgba(226, 232, 240, .55);\n  }\n  .retic::before { top: 8px; left: 8px; border-top: 2px solid; border-left: 2px solid; }\n  .retic::after { bottom: 8px; right: 8px; border-bottom: 2px solid; border-right: 2px solid; }\n  .retic-red::before, .retic-red::after { border-color: rgba(239, 68, 68, .75); }\n\n  /* live indicator */\n  .live { position: relative; display: inline-block; width: 8px; height: 8px; border-radius: 9999px; background: #ef4444; }\n  .live::after {\n    content: \"\"; position: absolute; inset: -5px; border-radius: 9999px; border: 1px solid rgba(239,68,68,.7);\n    animation: pulse 2.4s ease-out infinite;\n  }\n  @keyframes pulse { 0% { transform: scale(.5); opacity: .9 } 100% { transform: scale(1.6); opacity: 0 } }\n\n  /* radar ping on coverage map */\n  .ping { position: absolute; width: 10px; height: 10px; border-radius: 9999px; background: #ef4444; box-shadow: 0 0 12px rgba(239,68,68,.8); }\n  .ping::before, .ping::after {\n    content: \"\"; position: absolute; inset: 0; border-radius: 9999px; border: 1px solid rgba(239,68,68,.6);\n    animation: radar 3.6s cubic-bezier(.2,.6,.3,1) infinite;\n  }\n  .ping::after { animation-delay: 1.8s; }\n  @keyframes radar { 0% { transform: scale(1); opacity: .85 } 100% { transform: scale(7); opacity: 0 } }\n\n  /* terminal inputs */\n  .term { background: #0c1110; border: 1px solid #2a3634; color: #e2e8f0; caret-color: #ef4444; }\n  .term::placeholder { color: #6c7a78; }\n  .term:focus { outline: 2px solid #ef4444; outline-offset: 2px; border-color: #ef4444; }\n  .dr a:focus-visible, .dr button:focus-visible { outline: 2px solid #ef4444; outline-offset: 3px; }\n\n  .ulink { position: relative; }\n  .ulink::after { content: \"\"; position: absolute; left: 0; right: 100%; bottom: -6px; height: 2px; background: #ef4444; transition: right .25s ease; }\n  .ulink:hover::after { right: 0; }\n\n  .mapfx { filter: grayscale(.55) contrast(1.06) brightness(.88); }\n  .hu-map { filter: brightness(0) invert(1) opacity(.07); }\n\n  /* client logo chips — keep every logo inside its chip */\n  #references .bg-white { display: flex; align-items: center; justify-content: center; overflow: hidden; }\n  #references .bg-white img { max-height: 60px; max-width: 100%; width: auto; object-fit: contain; filter: saturate(.95); }\n</style>\n<div class=\"dr bg-[#0c1110] text-[#e2e8f0] text-[15px] leading-relaxed antialiased\" data-kid=\"2\" data-name=\"page wrapper\">\n    <!-- ══ 1. UTILITY STRIP ══ -->\n    <div class=\"bg-[#080c0b] border-b border-[#1e2827]\" data-kid=\"2-1\" data-name=\"utility strip container\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))] flex items-center justify-between py-2.5\" data-kid=\"2-1-1\" data-name=\"utility strip content layout\">\n            <p class=\"mono text-[11px] tracking-[0.18em] text-[#7d8a88] m-0\" data-kid=\"2-1-1-1\" data-name=\"company legal name text\">\n                DOG RACE SECURITY KFT. · VAGYONVÉDELEM ÉS LÉTESÍTMÉNYSZOLGÁLTATÁS\n            </p>\n            <div class=\"flex items-center gap-6 text-[12.5px]\" data-kid=\"2-1-1-2\" data-name=\"utility contact information\">\n                <span class=\"hidden lg:flex items-center gap-2 text-[#8a9694]\" data-kid=\"2-1-1-2-1\" data-name=\"location indicator\">\n                    <i class=\"ti ti-map-pin text-[15px] text-[#8a9694]\" data-kid=\"2-1-1-2-1-1\" data-name=\"location pin icon\">\n                    </i>\n                    2120 Dunakeszi, Fő út 69.\n                </span>\n                <a class=\"hidden lg:flex items-center gap-2 text-[#8a9694] hover:text-[#e2e8f0] transition-colors\" data-kid=\"2-1-1-2-2\" data-name=\"email link\" href=\"mailto:dograceseckft@gmail.com\">\n                    <i class=\"ti ti-mail text-[15px]\" data-kid=\"2-1-1-2-2-1\" data-name=\"mail icon\">\n                    </i>\n                    dograceseckft@gmail.com\n                </a>\n                <a class=\"mono flex items-center gap-2 text-[#e2e8f0] tracking-[0.06em] font-medium hover:text-[#ef4444] transition-colors\" data-kid=\"2-1-1-2-3\" data-name=\"phone call link\" href=\"tel:+36706069802\">\n                    <i class=\"ti ti-phone text-[15px]\" data-kid=\"2-1-1-2-3-1\" data-name=\"phone icon\">\n                    </i>\n                    06 70 606 9802\n                </a>\n            </div>\n        </div>\n    </div>\n    <!-- ══ 1b. HEADER ══ -->\n    <header class=\"sticky top-0 z-40 bg-[#0c1110]/92 backdrop-blur-md border-b border-[#1e2827]\" data-kid=\"2-2\" data-name=\"sticky header\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))] flex items-center justify-between py-4\" data-kid=\"2-2-1\" data-name=\"header content wrapper\">\n            <a class=\"flex items-center shrink-0\" data-kid=\"2-2-1-1\" data-name=\"logo link\" href=\"#top\">\n                <img alt=\"DOG RACE SECURITY Kft. logó\" class=\"h-14 w-auto\" data-kid=\"2-2-1-1-1\" data-name=\"company logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\"/>\n            </a>\n            <nav aria-label=\"Fő navigáció\" class=\"dsp hidden md:flex items-center gap-8 text-[13px] tracking-[0.14em] font-medium text-[#a8b4b2]\" data-kid=\"2-2-1-2\" data-name=\"main navigation menu\">\n                <a class=\"ulink hover:text-white transition-colors\" data-kid=\"2-2-1-2-1\" data-name=\"services link\" href=\"#services\">\n                    Szolgáltatások\n                </a>\n                <a class=\"ulink hover:text-white transition-colors\" data-kid=\"2-2-1-2-2\" data-name=\"about link\" href=\"#about\">\n                    Rólunk\n                </a>\n                <a class=\"ulink hover:text-white transition-colors\" data-kid=\"2-2-1-2-3\" data-name=\"process link\" href=\"#process\">\n                    Folyamat\n                </a>\n                <a class=\"ulink hover:text-white transition-colors\" data-kid=\"2-2-1-2-4\" data-name=\"references link\" href=\"#references\">\n                    Referenciák\n                </a>\n                <a class=\"ulink hover:text-white transition-colors\" data-kid=\"2-2-1-2-5\" data-name=\"contact link\" href=\"#contact\">\n                    Kapcsolat\n                </a>\n            </nav>\n            <a class=\"dsp shrink-0 inline-flex items-center gap-2 bg-[#ef4444] hover:bg-[#dc2626] text-white text-[13px] tracking-[0.12em] font-semibold px-6 py-3.5 rounded-[2px] transition-colors\" data-kid=\"2-2-1-3\" data-name=\"primary call-to-action button\" href=\"#contact\">\n                Ajánlatkérés\n                <i class=\"ti ti-arrow-narrow-right text-[17px]\" data-kid=\"2-2-1-3-1\" data-name=\"arrow icon\">\n                </i>\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"2-3\" data-name=\"main page content\" id=\"top\">\n        <!-- ══ 2. HERO ══ -->\n        <section class=\"relative overflow-hidden\" data-kid=\"2-3-1\" data-name=\"hero section\">\n            <img alt=\"DOG RACE SECURITY feliratú szolgálati gépjármű\" class=\"absolute inset-0 w-full h-full object-cover object-[68%_center] cine\" data-kid=\"2-3-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image7.jpeg\" style=\"filter:brightness(.42) sepia(.2) hue-rotate(172deg) saturate(1.2) contrast(1.05)\"/>\n            <div class=\"absolute inset-0\" data-kid=\"2-3-1-2\" data-name=\"hero background gradient\" style=\"background:linear-gradient(96deg,#0c1110 0%,rgba(12,17,16,.92) 34%,rgba(12,17,16,.55) 64%,rgba(12,17,16,.75) 100%)\">\n            </div>\n            <div class=\"absolute inset-x-0 bottom-0 h-40\" data-kid=\"2-3-1-3\" data-name=\"hero bottom fade gradient\" style=\"background:linear-gradient(180deg,rgba(12,17,16,0),#0c1110)\">\n            </div>\n            <div class=\"relative mx-auto w-[min(1240px,calc(100%-3rem))] pt-24 pb-28\" data-kid=\"2-3-1-4\" data-name=\"hero content container\">\n                <div class=\"max-w-[760px] bg-[#0c1110]/72 backdrop-blur-xl border border-white/10 p-10 md:p-12\" data-kid=\"2-3-1-4-1\" data-name=\"hero text card\" style=\"border-left:2px solid #ef4444\">\n                    <div class=\"mono flex flex-wrap items-center gap-x-5 gap-y-2 text-[11.5px] tracking-[0.2em] text-[#a8b4b2] mb-8\" data-kid=\"2-3-1-4-1-1\" data-name=\"hero status badge container\">\n                        <span class=\"inline-flex items-center gap-2.5 text-white\" data-kid=\"2-3-1-4-1-1-1\" data-name=\"live status indicator\">\n                            <span class=\"live\" data-kid=\"2-3-1-4-1-1-1-1\" data-name=\"pulsing live indicator\">\n                            </span>\n                            DISZPÉCSER: AKTÍV · 0–24\n                        </span>\n                        <span class=\"text-[#4a5654]\" data-kid=\"2-3-1-4-1-1-2\" data-name=\"separator text\">\n                            |\n                        </span>\n                        <span data-kid=\"2-3-1-4-1-1-3\" data-name=\"coverage description text\">\n                            DUNAKESZI · ORSZÁGOS KIVONULÁS\n                        </span>\n                    </div>\n                    <h1 class=\"dsp text-white font-bold text-[42px] md:text-[52px] leading-[0.99] tracking-[-0.01em] m-0\" data-kid=\"2-3-1-4-1-2\" data-name=\"hero headline\">\n                        2019 óta őrizzük ipari parkok, irodaházak és építési területek vagyonát.\n                    </h1>\n                    <p class=\"text-[16.5px] leading-[1.72] text-[#e2e8f0] max-w-[610px] mt-7 mb-9\" data-kid=\"2-3-1-4-1-3\" data-name=\"hero subheadline\">\n                        Objektumőrzés, portaszolgálat és járőrszolgálat országos lefedettséggel — 40 fős, feddhetetlenségi vizsgálaton átesett állománnyal, 0–24 diszpécserháttérrel.\n                    </p>\n                    <div class=\"flex flex-wrap items-center gap-4\" data-kid=\"2-3-1-4-1-4\" data-name=\"hero primary buttons\">\n                        <a class=\"dsp inline-flex items-center gap-2.5 bg-[#ef4444] hover:bg-[#dc2626] text-white text-[14px] tracking-[0.1em] font-semibold px-8 py-4 rounded-[2px] transition-colors\" data-kid=\"2-3-1-4-1-4-1\" data-name=\"primary get-quote button\" href=\"#contact\">\n                            Ajánlatkérés 24 órán belül\n                            <i class=\"ti ti-arrow-narrow-right text-[19px]\" data-kid=\"2-3-1-4-1-4-1-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                        <a class=\"mono inline-flex items-center gap-2.5 border border-[#3a4644] hover:border-[#e2e8f0] text-white text-[14.5px] tracking-[0.08em] font-medium px-7 py-4 rounded-[2px] transition-colors\" data-kid=\"2-3-1-4-1-4-2\" data-name=\"phone call button\" href=\"tel:+36706069802\">\n                            <i class=\"ti ti-phone text-[18px]\" data-kid=\"2-3-1-4-1-4-2-1\" data-name=\"phone icon\">\n                            </i>\n                            06 70 606 9802\n                        </a>\n                    </div>\n                    <div class=\"mono flex flex-wrap items-center gap-x-4 gap-y-2 text-[11.5px] tracking-[0.14em] text-[#8a9694] mt-9 pt-7 border-t border-white/10\" data-kid=\"2-3-1-4-1-5\" data-name=\"hero footer text list\">\n                        <span data-kid=\"2-3-1-4-1-5-1\" data-name=\"service permit status\">\n                            VAGYONVÉDELMI TEVÉKENYSÉGI ENGEDÉLY\n                        </span>\n                        <span class=\"text-[#3a4644]\" data-kid=\"2-3-1-4-1-5-2\" data-name=\"separator bullet\">\n                            ·\n                        </span>\n                        <span data-kid=\"2-3-1-4-1-5-3\" data-name=\"insurance status\">\n                            FELELŐSSÉGBIZTOSÍTÁS\n                        </span>\n                        <span class=\"text-[#3a4644]\" data-kid=\"2-3-1-4-1-5-4\" data-name=\"separator bullet\">\n                            ·\n                        </span>\n                        <span data-kid=\"2-3-1-4-1-5-5\" data-name=\"company ownership status\">\n                            100%-BAN MAGYAR TULAJDON\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 3. STATS READOUT ══ -->\n        <section class=\"bg-[#0f1514] border-y border-[#1e2827]\" data-kid=\"2-3-2\" data-name=\"stats section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-2-1\" data-name=\"stats section layout\">\n                <div class=\"grid grid-cols-2 lg:grid-cols-4 divide-x divide-y lg:divide-y-0 divide-[#1e2827]\" data-kid=\"2-3-2-1-1\" data-name=\"stats grid\">\n                    <div class=\"px-2 lg:px-0 lg:pr-10 py-9\" data-kid=\"2-3-2-1-1-1\" data-name=\"stat year count\">\n                        <div class=\"mono text-white text-[40px] leading-none font-medium\" data-kid=\"2-3-2-1-1-1-1\" data-name=\"stat number\">\n                            7+\n                        </div>\n                        <div class=\"dsp text-[13px] tracking-[0.14em] text-[#e2e8f0] mt-3\" data-kid=\"2-3-2-1-1-1-2\" data-name=\"stat label\">\n                            év\n                        </div>\n                        <p class=\"text-[13.5px] text-[#8a9694] m-0 mt-1.5\" data-kid=\"2-3-2-1-1-1-3\" data-name=\"stat description\">\n                            folyamatos működés 2019 óta\n                        </p>\n                    </div>\n                    <div class=\"px-2 lg:px-10 py-9\" data-kid=\"2-3-2-1-1-2\" data-name=\"stat staff count\">\n                        <div class=\"mono text-white text-[40px] leading-none font-medium\" data-kid=\"2-3-2-1-1-2-1\" data-name=\"stat number\">\n                            40+\n                        </div>\n                        <div class=\"dsp text-[13px] tracking-[0.14em] text-[#e2e8f0] mt-3\" data-kid=\"2-3-2-1-1-2-2\" data-name=\"stat label\">\n                            szakember\n                        </div>\n                        <p class=\"text-[13.5px] text-[#8a9694] m-0 mt-1.5\" data-kid=\"2-3-2-1-1-2-3\" data-name=\"stat description\">\n                            saját, bejelentett állomány\n                        </p>\n                    </div>\n                    <div class=\"px-2 lg:px-10 py-9\" data-kid=\"2-3-2-1-1-3\" data-name=\"stat client count\">\n                        <div class=\"mono text-white text-[40px] leading-none font-medium\" data-kid=\"2-3-2-1-1-3-1\" data-name=\"stat number\">\n                            15+\n                        </div>\n                        <div class=\"dsp text-[13px] tracking-[0.14em] text-[#e2e8f0] mt-3\" data-kid=\"2-3-2-1-1-3-2\" data-name=\"stat label\">\n                            ügyfél\n                        </div>\n                        <p class=\"text-[13.5px] text-[#8a9694] m-0 mt-1.5\" data-kid=\"2-3-2-1-1-3-3\" data-name=\"stat description\">\n                            ipari park, logisztika, építőipar\n                        </p>\n                    </div>\n                    <div class=\"px-2 lg:px-10 py-9\" data-kid=\"2-3-2-1-1-4\" data-name=\"stat availability\">\n                        <div class=\"mono text-white text-[40px] leading-none font-medium flex items-center gap-3\" data-kid=\"2-3-2-1-1-4-1\" data-name=\"stat number\">\n                            0–24\n                            <span class=\"live mb-3\" data-kid=\"2-3-2-1-1-4-1-1\" data-name=\"pulsing live indicator\">\n                            </span>\n                        </div>\n                        <div class=\"dsp text-[13px] tracking-[0.14em] text-[#e2e8f0] mt-3\" data-kid=\"2-3-2-1-1-4-2\" data-name=\"stat label\">\n                            diszpécserszolgálat\n                        </div>\n                        <p class=\"text-[13.5px] text-[#8a9694] m-0 mt-1.5\" data-kid=\"2-3-2-1-1-4-3\" data-name=\"stat description\">\n                            minden nap, az év minden napján\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 4. SERVICES ══ -->\n        <section class=\"bg-[#0c1110] py-28\" data-kid=\"2-3-3\" data-name=\"services section\" id=\"services\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-3-1\" data-name=\"services content container\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 mb-12\" data-kid=\"2-3-3-1-1\" data-name=\"section header group\">\n                    <div data-kid=\"2-3-3-1-1-1\" data-name=\"section label container\">\n                        <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-3-1-1-1-1\" data-name=\"section section-id label\">\n                            // 01 — SZOLGÁLTATÁSOK\n                        </p>\n                        <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0\" data-kid=\"2-3-3-1-1-1-2\" data-name=\"section title\">\n                            Szolgáltatásaink\n                        </h2>\n                    </div>\n                    <p class=\"text-[15px] text-[#8a9694] max-w-[380px] m-0\" data-kid=\"2-3-3-1-1-2\" data-name=\"section description\">\n                        Három őrzési alapszolgáltatás, kiegészítő létesítményszolgáltatásokkal. Minden posztra dedikált állomány és írásos őrutasítás készül.\n                    </p>\n                </div>\n                <!-- primary: three core guarding services -->\n                <div class=\"grid md:grid-cols-3 gap-6\" data-kid=\"2-3-3-1-2\" data-name=\"primary services grid\">\n                    <article class=\"group bg-[#161e1d] border border-[#26302e]\" data-kid=\"2-3-3-1-2-1\" data-name=\"object guarding card\" style=\"border-top:2px solid #ef4444\">\n                        <div class=\"retic h-[210px] overflow-hidden\" data-kid=\"2-3-3-1-2-1-1\" data-name=\"image container\">\n                            <img alt=\"Irodaház és telephely objektumőrzése\" class=\"w-full h-full object-cover cine\" data-kid=\"2-3-3-1-2-1-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image4.jpeg\"/>\n                        </div>\n                        <div class=\"p-7\" data-kid=\"2-3-3-1-2-1-2\" data-name=\"card content\">\n                            <div class=\"flex items-center justify-between mb-5\" data-kid=\"2-3-3-1-2-1-2-1\" data-name=\"icon header container\">\n                                <span class=\"inline-grid place-items-center w-11 h-11 border border-[#3a4644] text-[22px] text-[#e2e8f0]\" data-kid=\"2-3-3-1-2-1-2-1-1\" data-name=\"icon wrapper\">\n                                    <i class=\"ti ti-building-warehouse\" data-kid=\"2-3-3-1-2-1-2-1-1-1\" data-name=\"icon\">\n                                    </i>\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-3-1-2-1-2-1-2\" data-name=\"service type label\">\n                                    ALAP\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[19px] tracking-[0.06em] font-semibold m-0 mb-3\" data-kid=\"2-3-3-1-2-1-2-2\" data-name=\"card title\">\n                                Objektumőrzés\n                            </h3>\n                            <p class=\"text-[14.5px] leading-[1.65] text-[#c3cdcb] m-0\" data-kid=\"2-3-3-1-2-1-2-3\" data-name=\"card description\">\n                                Épületek, telephelyek, irodaházak és ipari létesítmények komplett objektumvédelme, igény esetén kutyás őrszolgálattal.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"group bg-[#161e1d] border border-[#26302e]\" data-kid=\"2-3-3-1-2-2\" data-name=\"reception guarding card\" style=\"border-top:2px solid #ef4444\">\n                        <div class=\"retic h-[210px] overflow-hidden\" data-kid=\"2-3-3-1-2-2-1\" data-name=\"image container\">\n                            <img alt=\"Portaszolgálat és recepciós feladatok\" class=\"w-full h-full object-cover cine\" data-kid=\"2-3-3-1-2-2-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image6.jpeg\"/>\n                        </div>\n                        <div class=\"p-7\" data-kid=\"2-3-3-1-2-2-2\" data-name=\"card content\">\n                            <div class=\"flex items-center justify-between mb-5\" data-kid=\"2-3-3-1-2-2-2-1\" data-name=\"icon header container\">\n                                <span class=\"inline-grid place-items-center w-11 h-11 border border-[#3a4644] text-[22px] text-[#e2e8f0]\" data-kid=\"2-3-3-1-2-2-2-1-1\" data-name=\"icon wrapper\">\n                                    <i class=\"ti ti-id-badge-2\" data-kid=\"2-3-3-1-2-2-2-1-1-1\" data-name=\"icon\">\n                                    </i>\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-3-1-2-2-2-1-2\" data-name=\"service type label\">\n                                    ALAP\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[19px] tracking-[0.06em] font-semibold m-0 mb-3\" data-kid=\"2-3-3-1-2-2-2-2\" data-name=\"card title\">\n                                Portaszolgálat\n                            </h3>\n                            <p class=\"text-[14.5px] leading-[1.65] text-[#c3cdcb] m-0\" data-kid=\"2-3-3-1-2-2-2-3\" data-name=\"card description\">\n                                Recepciós, diszpécseri és operátori feladatok ellátása, beléptetés és információs szolgáltatások.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"group bg-[#161e1d] border border-[#26302e]\" data-kid=\"2-3-3-1-2-3\" data-name=\"patrol guarding card\" style=\"border-top:2px solid #ef4444\">\n                        <div class=\"retic h-[210px] overflow-hidden\" data-kid=\"2-3-3-1-2-3-1\" data-name=\"image container\">\n                            <img alt=\"Járőrszolgálat szolgálati gépjárművel éjszaka\" class=\"w-full h-full object-cover cine\" data-kid=\"2-3-3-1-2-3-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image3.jpeg\"/>\n                        </div>\n                        <div class=\"p-7\" data-kid=\"2-3-3-1-2-3-2\" data-name=\"card content\">\n                            <div class=\"flex items-center justify-between mb-5\" data-kid=\"2-3-3-1-2-3-2-1\" data-name=\"icon header container\">\n                                <span class=\"inline-grid place-items-center w-11 h-11 border border-[#3a4644] text-[22px] text-[#e2e8f0]\" data-kid=\"2-3-3-1-2-3-2-1-1\" data-name=\"icon wrapper\">\n                                    <i class=\"ti ti-radar-2\" data-kid=\"2-3-3-1-2-3-2-1-1-1\" data-name=\"icon\">\n                                    </i>\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-3-1-2-3-2-1-2\" data-name=\"service type label\">\n                                    ALAP\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[19px] tracking-[0.06em] font-semibold m-0 mb-3\" data-kid=\"2-3-3-1-2-3-2-2\" data-name=\"card title\">\n                                Járőrszolgálat\n                            </h3>\n                            <p class=\"text-[14.5px] leading-[1.65] text-[#c3cdcb] m-0\" data-kid=\"2-3-3-1-2-3-2-3\" data-name=\"card description\">\n                                Nappali és éjszakai területellenőrző járőrszolgálat felállítása és üzemeltetése, gépkocsival vagy gyalogosan.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n                <!-- secondary: supporting services, lighter weight -->\n                <div class=\"mono text-[11.5px] tracking-[0.22em] text-[#6c7a78] mt-14 mb-5 flex items-center gap-4\" data-kid=\"2-3-3-1-3\" data-name=\"secondary services heading\">\n                    KIEGÉSZÍTŐ SZOLGÁLTATÁSOK\n                    <span class=\"h-px flex-1 bg-[#1e2827]\" data-kid=\"2-3-3-1-3-1\" data-name=\"decorative separator\">\n                    </span>\n                </div>\n                <div class=\"grid md:grid-cols-3 gap-x-6 gap-y-4\" data-kid=\"2-3-3-1-4\" data-name=\"secondary services grid\">\n                    <article class=\"group flex items-start gap-5 border border-[#1e2827] hover:border-[#3a4644] bg-[#0f1514] p-4 transition-colors\" data-kid=\"2-3-3-1-4-1\" data-name=\"event security card\">\n                        <div class=\"retic shrink-0 w-[86px] h-[86px] overflow-hidden\" data-kid=\"2-3-3-1-4-1-1\" data-name=\"image container\">\n                            <img alt=\"Rendezvénybiztosítás\" class=\"w-full h-full object-cover cine\" data-kid=\"2-3-3-1-4-1-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image2.jpeg\"/>\n                        </div>\n                        <div data-kid=\"2-3-3-1-4-1-2\" data-name=\"card text\">\n                            <h3 class=\"dsp text-white text-[15.5px] tracking-[0.06em] font-semibold m-0 mb-2 flex items-center gap-2\" data-kid=\"2-3-3-1-4-1-2-1\" data-name=\"title\">\n                                <i class=\"ti ti-users-group text-[18px] text-[#8a9694]\" data-kid=\"2-3-3-1-4-1-2-1-1\" data-name=\"icon\">\n                                </i>\n                                Rendezvénybiztosítás\n                            </h3>\n                            <p class=\"text-[13.5px] leading-[1.6] text-[#a8b4b2] m-0\" data-kid=\"2-3-3-1-4-1-2-2\" data-name=\"description\">\n                                Rendezvények biztosítása és személyvédelem a résztvevők és a vagyon védelme érdekében.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"group flex items-start gap-5 border border-[#1e2827] hover:border-[#3a4644] bg-[#0f1514] p-4 transition-colors\" data-kid=\"2-3-3-1-4-2\" data-name=\"cleaning service card\">\n                        <div class=\"retic shrink-0 w-[86px] h-[86px] overflow-hidden\" data-kid=\"2-3-3-1-4-2-1\" data-name=\"image container\">\n                            <img alt=\"Gépi takarítás irodaházban\" class=\"w-full h-full object-cover cine\" data-kid=\"2-3-3-1-4-2-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image8.jpeg\"/>\n                        </div>\n                        <div data-kid=\"2-3-3-1-4-2-2\" data-name=\"card text\">\n                            <h3 class=\"dsp text-white text-[15.5px] tracking-[0.06em] font-semibold m-0 mb-2 flex items-center gap-2\" data-kid=\"2-3-3-1-4-2-2-1\" data-name=\"title\">\n                                <i class=\"ti ti-spray text-[18px] text-[#8a9694]\" data-kid=\"2-3-3-1-4-2-2-1-1\" data-name=\"icon\">\n                                </i>\n                                Takarítás\n                            </h3>\n                            <p class=\"text-[13.5px] leading-[1.6] text-[#a8b4b2] m-0\" data-kid=\"2-3-3-1-4-2-2-2\" data-name=\"description\">\n                                Irodaházak, üzemek és közterületek takarítása gépi padló- és szőnyegtisztítással, fertőtlenítő gőztakarítással.\n                            </p>\n                        </div>\n                    </article>\n                    <article class=\"group flex items-start gap-5 border border-[#1e2827] hover:border-[#3a4644] bg-[#0f1514] p-4 transition-colors\" data-kid=\"2-3-3-1-4-3\" data-name=\"partnership card\">\n                        <div class=\"retic shrink-0 w-[86px] h-[86px] overflow-hidden\" data-kid=\"2-3-3-1-4-3-1\" data-name=\"image container\">\n                            <img alt=\"Hosszú távú partneri együttműködés\" class=\"w-full h-full object-cover cine\" data-kid=\"2-3-3-1-4-3-1-1\" data-name=\"card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image1.jpeg\"/>\n                        </div>\n                        <div data-kid=\"2-3-3-1-4-3-2\" data-name=\"card text\">\n                            <h3 class=\"dsp text-white text-[15.5px] tracking-[0.06em] font-semibold m-0 mb-2 flex items-center gap-2\" data-kid=\"2-3-3-1-4-3-2-1\" data-name=\"title\">\n                                <i class=\"ti ti-handshake text-[18px] text-[#8a9694]\" data-kid=\"2-3-3-1-4-3-2-1-1\" data-name=\"icon\">\n                                </i>\n                                Megbízható partner\n                            </h3>\n                            <p class=\"text-[13.5px] leading-[1.6] text-[#a8b4b2] m-0\" data-kid=\"2-3-3-1-4-3-2-2\" data-name=\"description\">\n                                Ügyfeleink biztonsága a legfontosabb számunkra. Hosszú távú, megbízható együttműködés.\n                            </p>\n                        </div>\n                    </article>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 5. PROCESS ══ -->\n        <section class=\"bg-[#0f1514] border-y border-[#1e2827] py-28\" data-kid=\"2-3-4\" data-name=\"process section\" id=\"process\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-4-1\" data-name=\"process content\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 mb-16\" data-kid=\"2-3-4-1-1\" data-name=\"section header group\">\n                    <div data-kid=\"2-3-4-1-1-1\" data-name=\"section label container\">\n                        <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-4-1-1-1-1\" data-name=\"section section-id label\">\n                            // 02 — FOLYAMAT\n                        </p>\n                        <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0\" data-kid=\"2-3-4-1-1-1-2\" data-name=\"section title\">\n                            Így dolgozunk\n                        </h2>\n                    </div>\n                    <p class=\"text-[15px] text-[#8a9694] max-w-[400px] m-0\" data-kid=\"2-3-4-1-1-2\" data-name=\"section description\">\n                        Az első bejárástól a havi értékelésig — dokumentált, ellenőrizhető átvételi és szolgálati rend.\n                    </p>\n                </div>\n                <div class=\"relative\" data-kid=\"2-3-4-1-2\" data-name=\"process steps container\">\n                    <div class=\"hidden lg:block absolute left-[6%] right-[6%] top-[19px] border-t-2 border-dashed border-[#2a3634]\" data-kid=\"2-3-4-1-2-1\" data-name=\"dashed background line\">\n                    </div>\n                    <div class=\"grid md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12\" data-kid=\"2-3-4-1-2-2\" data-name=\"process steps grid\">\n                        <div class=\"relative\" data-kid=\"2-3-4-1-2-2-1\" data-name=\"step 1\">\n                            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"2-3-4-1-2-2-1-1\" data-name=\"step header\">\n                                <span class=\"relative z-10 grid place-items-center w-10 h-10 bg-[#0f1514] border-2 border-[#ef4444] mono text-[13px] font-semibold text-white\" data-kid=\"2-3-4-1-2-2-1-1-1\" data-name=\"step index label\">\n                                    01\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-4-1-2-2-1-1-2\" data-name=\"timeframe label\">\n                                    24 ÓRA\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[17px] tracking-[0.05em] font-semibold m-0 mb-3\" data-kid=\"2-3-4-1-2-2-1-2\" data-name=\"title\">\n                                Felmérés és ajánlat\n                            </h3>\n                            <p class=\"text-[14px] leading-[1.68] text-[#c3cdcb] m-0\" data-kid=\"2-3-4-1-2-2-1-3\" data-name=\"description\">\n                                Helyszíni bejárás, kockázatfelmérés, létszám- és óraterv. Írásos ajánlat 24 órán belül.\n                            </p>\n                        </div>\n                        <div class=\"relative\" data-kid=\"2-3-4-1-2-2-2\" data-name=\"step 2\">\n                            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"2-3-4-1-2-2-2-1\" data-name=\"step header\">\n                                <span class=\"relative z-10 grid place-items-center w-10 h-10 bg-[#0f1514] border-2 border-[#3a4644] mono text-[13px] font-semibold text-white\" data-kid=\"2-3-4-1-2-2-2-1-1\" data-name=\"step index label\">\n                                    02\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-4-1-2-2-2-1-2\" data-name=\"timeframe label\">\n                                    5–10 MUNKANAP\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[17px] tracking-[0.05em] font-semibold m-0 mb-3\" data-kid=\"2-3-4-1-2-2-2-2\" data-name=\"title\">\n                                Átvétel és állományozás\n                            </h3>\n                            <p class=\"text-[14px] leading-[1.68] text-[#c3cdcb] m-0\" data-kid=\"2-3-4-1-2-2-2-3\" data-name=\"description\">\n                                Őrutasítás és posztleírás kidolgozása, dedikált állomány kijelölése, betanítás az objektum sajátosságaira.\n                            </p>\n                        </div>\n                        <div class=\"relative\" data-kid=\"2-3-4-1-2-2-3\" data-name=\"step 3\">\n                            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"2-3-4-1-2-2-3-1\" data-name=\"step header\">\n                                <span class=\"relative z-10 grid place-items-center w-10 h-10 bg-[#0f1514] border-2 border-[#3a4644] mono text-[13px] font-semibold text-white\" data-kid=\"2-3-4-1-2-2-3-1-1\" data-name=\"step index label\">\n                                    03\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-4-1-2-2-3-1-2\" data-name=\"timeframe label\">\n                                    FOLYAMATOS\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[17px] tracking-[0.05em] font-semibold m-0 mb-3\" data-kid=\"2-3-4-1-2-2-3-2\" data-name=\"title\">\n                                Szolgálat és diszpécserháttér\n                            </h3>\n                            <p class=\"text-[14px] leading-[1.68] text-[#c3cdcb] m-0\" data-kid=\"2-3-4-1-2-2-3-3\" data-name=\"description\">\n                                0–24 elérhető diszpécser, ellenőrzőkörök, riasztásra történő kivonulás, gépkocsis vagy gyalogos járőrözés.\n                            </p>\n                        </div>\n                        <div class=\"relative\" data-kid=\"2-3-4-1-2-2-4\" data-name=\"step 4\">\n                            <div class=\"flex items-center gap-4 mb-6\" data-kid=\"2-3-4-1-2-2-4-1\" data-name=\"step header\">\n                                <span class=\"relative z-10 grid place-items-center w-10 h-10 bg-[#0f1514] border-2 border-[#3a4644] mono text-[13px] font-semibold text-white\" data-kid=\"2-3-4-1-2-2-4-1-1\" data-name=\"step index label\">\n                                    04\n                                </span>\n                                <span class=\"mono text-[11px] tracking-[0.2em] text-[#6c7a78]\" data-kid=\"2-3-4-1-2-2-4-1-2\" data-name=\"timeframe label\">\n                                    HAVI\n                                </span>\n                            </div>\n                            <h3 class=\"dsp text-white text-[17px] tracking-[0.05em] font-semibold m-0 mb-3\" data-kid=\"2-3-4-1-2-2-4-2\" data-name=\"title\">\n                                Jelentés és ellenőrzés\n                            </h3>\n                            <p class=\"text-[14px] leading-[1.68] text-[#c3cdcb] m-0\" data-kid=\"2-3-4-1-2-2-4-3\" data-name=\"description\">\n                                Szolgálati napló, rendkívüli események írásos jelentése, rendszeres vezetői ellenőrzés és havi értékelés.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 6. COVERAGE ══ -->\n        <section class=\"relative bg-[#0c1110] py-28 overflow-hidden\" data-kid=\"2-3-5\" data-name=\"coverage section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))] grid lg:grid-cols-[1fr_1.05fr] gap-16 items-center\" data-kid=\"2-3-5-1\" data-name=\"coverage content\">\n                <div data-kid=\"2-3-5-1-1\" data-name=\"coverage text column\">\n                    <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-5-1-1-1\" data-name=\"section section-id label\">\n                        // 03 — LEFEDETTSÉG\n                    </p>\n                    <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0 mb-8\" data-kid=\"2-3-5-1-1-2\" data-name=\"section title\">\n                        Országos lefedettség\n                    </h2>\n                    <dl class=\"m-0 divide-y divide-[#1e2827] border-y border-[#1e2827]\" data-kid=\"2-3-5-1-1-3\" data-name=\"coverage definition list\">\n                        <div class=\"flex items-baseline gap-6 py-5\" data-kid=\"2-3-5-1-1-3-1\" data-name=\"headquarters row\">\n                            <dt class=\"mono text-[11.5px] tracking-[0.18em] text-[#6c7a78] w-[132px] shrink-0\" data-kid=\"2-3-5-1-1-3-1-1\" data-name=\"label\">\n                                KÖZPONT\n                            </dt>\n                            <dd class=\"m-0 text-[15.5px] text-[#e2e8f0]\" data-kid=\"2-3-5-1-1-3-1-2\" data-name=\"value\">\n                                2120 Dunakeszi, Fő út 69.\n                            </dd>\n                        </div>\n                        <div class=\"flex items-baseline gap-6 py-5\" data-kid=\"2-3-5-1-1-3-2\" data-name=\"primary area row\">\n                            <dt class=\"mono text-[11.5px] tracking-[0.18em] text-[#6c7a78] w-[132px] shrink-0\" data-kid=\"2-3-5-1-1-3-2-1\" data-name=\"label\">\n                                ELSŐDLEGES\n                            </dt>\n                            <dd class=\"m-0 text-[15.5px] text-[#e2e8f0]\" data-kid=\"2-3-5-1-1-3-2-2\" data-name=\"value\">\n                                Budapest és Pest megye\n                            </dd>\n                        </div>\n                        <div class=\"flex items-baseline gap-6 py-5\" data-kid=\"2-3-5-1-1-3-3\" data-name=\"priority area row\">\n                            <dt class=\"mono text-[11.5px] tracking-[0.18em] text-[#6c7a78] w-[132px] shrink-0\" data-kid=\"2-3-5-1-1-3-3-1\" data-name=\"label\">\n                                KIEMELT\n                            </dt>\n                            <dd class=\"m-0 text-[15.5px] text-[#e2e8f0]\" data-kid=\"2-3-5-1-1-3-3-2\" data-name=\"value\">\n                                Közép-Magyarország\n                            </dd>\n                        </div>\n                        <div class=\"flex items-baseline gap-6 py-5\" data-kid=\"2-3-5-1-1-3-4\" data-name=\"national area row\">\n                            <dt class=\"mono text-[11.5px] tracking-[0.18em] text-[#6c7a78] w-[132px] shrink-0\" data-kid=\"2-3-5-1-1-3-4-1\" data-name=\"label\">\n                                ORSZÁGOS\n                            </dt>\n                            <dd class=\"m-0 text-[15.5px] text-[#e2e8f0]\" data-kid=\"2-3-5-1-1-3-4-2\" data-name=\"value\">\n                                kivonulás egyedi megállapodás szerint\n                            </dd>\n                        </div>\n                    </dl>\n                    <p class=\"mono text-[12.5px] tracking-[0.1em] text-[#a8b4b2] mt-7 mb-0 flex items-center gap-3\" data-kid=\"2-3-5-1-1-4\" data-name=\"setup timeframe text\">\n                        <i class=\"ti ti-clock-play text-[17px] text-[#ef4444]\" data-kid=\"2-3-5-1-1-4-1\" data-name=\"icon\">\n                        </i>\n                        ÚJ HELYSZÍN INDÍTÁSA JELLEMZŐEN 5–10 MUNKANAP.\n                    </p>\n                </div>\n                <div class=\"relative min-h-[420px] border border-[#1e2827] bg-[#0f1514] grid place-items-center overflow-hidden\" data-kid=\"2-3-5-1-2\" data-name=\"coverage visual container\">\n                    <div class=\"absolute inset-0 opacity-70\" data-kid=\"2-3-5-1-2-1\" data-name=\"grid background overlay\" style=\"background-image:linear-gradient(#1a2422 1px,transparent 1px),linear-gradient(90deg,#1a2422 1px,transparent 1px);background-size:44px 44px\">\n                    </div>\n                    <img alt=\"\" aria-hidden=\"true\" class=\"hu-map relative w-[86%] max-w-[560px]\" data-kid=\"2-3-5-1-2-2\" data-name=\"hungary map image\" decoding=\"async\" loading=\"lazy\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/delapouite/hungary.svg\"/>\n                    <span class=\"ping\" data-kid=\"2-3-5-1-2-3\" data-name=\"coverage ping point\" style=\"left:47%;top:41%\">\n                    </span>\n                    <span class=\"ping\" data-kid=\"2-3-5-1-2-4\" data-name=\"coverage ping point\" style=\"left:42%;top:47%;animation-delay:.9s\">\n                    </span>\n                    <span class=\"ping\" data-kid=\"2-3-5-1-2-5\" data-name=\"coverage ping point\" style=\"left:62%;top:38%;animation-delay:1.4s\">\n                    </span>\n                    <span class=\"ping\" data-kid=\"2-3-5-1-2-6\" data-name=\"coverage ping point\" style=\"left:33%;top:55%;animation-delay:2.1s\">\n                    </span>\n                    <div class=\"absolute left-5 bottom-5 mono text-[10.5px] tracking-[0.2em] text-[#6c7a78] flex items-center gap-2.5\" data-kid=\"2-3-5-1-2-7\" data-name=\"map legend container\">\n                        <span class=\"live\" data-kid=\"2-3-5-1-2-7-1\" data-name=\"live indicator\">\n                        </span>\n                        AKTÍV SZOLGÁLATI TERÜLETEK\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 7. LICENCES / VETTING ══ -->\n        <section class=\"bg-[#0f1514] border-y border-[#1e2827] py-28\" data-kid=\"2-3-6\" data-name=\"licences and vetting section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-6-1\" data-name=\"licences content\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 mb-12\" data-kid=\"2-3-6-1-1\" data-name=\"section header group\">\n                    <div data-kid=\"2-3-6-1-1-1\" data-name=\"section label container\">\n                        <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-6-1-1-1-1\" data-name=\"section section-id label\">\n                            // 04 — MEGFELELÉS\n                        </p>\n                        <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0\" data-kid=\"2-3-6-1-1-1-2\" data-name=\"section title\">\n                            Engedélyek, biztosítás,\n                            <br data-kid=\"2-3-6-1-1-1-2-1\"/>\n                            alkalmassági követelmények\n                        </h2>\n                    </div>\n                    <p class=\"text-[15px] text-[#8a9694] max-w-[350px] m-0\" data-kid=\"2-3-6-1-1-2\" data-name=\"section description\">\n                        Amit egy létesítménygazdálkodási vezetőnek ellenőriznie kell, mielőtt szerződést ír alá.\n                    </p>\n                </div>\n                <ul class=\"grid md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-0 list-none p-0 m-0\" data-kid=\"2-3-6-1-2\" data-name=\"licence list\">\n                    <li class=\"flex items-start gap-4 py-6 border-t border-[#26302e]\" data-kid=\"2-3-6-1-2-1\" data-name=\"licence item 1\">\n                        <i class=\"ti ti-shield-check text-[24px] text-[#ef4444] shrink-0 mt-0.5\" data-kid=\"2-3-6-1-2-1-1\" data-name=\"icon\">\n                        </i>\n                        <span class=\"text-[15px] leading-[1.6] text-[#e2e8f0]\" data-kid=\"2-3-6-1-2-1-2\" data-name=\"text\">\n                            Vagyonvédelmi tevékenységi engedély és kamarai nyilvántartás\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-4 py-6 border-t border-[#26302e]\" data-kid=\"2-3-6-1-2-2\" data-name=\"licence item 2\">\n                        <i class=\"ti ti-file-text text-[24px] text-[#8a9694] shrink-0 mt-0.5\" data-kid=\"2-3-6-1-2-2-1\" data-name=\"icon\">\n                        </i>\n                        <span class=\"text-[15px] leading-[1.6] text-[#e2e8f0]\" data-kid=\"2-3-6-1-2-2-2\" data-name=\"text\">\n                            Szakmai felelősségbiztosítás\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-4 py-6 border-t border-[#26302e]\" data-kid=\"2-3-6-1-2-3\" data-name=\"licence item 3\">\n                        <i class=\"ti ti-user-check text-[24px] text-[#8a9694] shrink-0 mt-0.5\" data-kid=\"2-3-6-1-2-3-1\" data-name=\"icon\">\n                        </i>\n                        <span class=\"text-[15px] leading-[1.6] text-[#e2e8f0]\" data-kid=\"2-3-6-1-2-3-2\" data-name=\"text\">\n                            Feddhetetlenségi vizsgálat minden munkatársnál\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-4 py-6 border-t border-[#26302e]\" data-kid=\"2-3-6-1-2-4\" data-name=\"licence item 4\">\n                        <i class=\"ti ti-stethoscope text-[24px] text-[#8a9694] shrink-0 mt-0.5\" data-kid=\"2-3-6-1-2-4-1\" data-name=\"icon\">\n                        </i>\n                        <span class=\"text-[15px] leading-[1.6] text-[#e2e8f0]\" data-kid=\"2-3-6-1-2-4-2\" data-name=\"text\">\n                            Kétévente kötelező orvosi és pszichológiai vizsgálat\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-4 py-6 border-t border-[#26302e]\" data-kid=\"2-3-6-1-2-5\" data-name=\"licence item 5\">\n                        <i class=\"ti ti-flag text-[24px] text-[#8a9694] shrink-0 mt-0.5\" data-kid=\"2-3-6-1-2-5-1\" data-name=\"icon\">\n                        </i>\n                        <span class=\"text-[15px] leading-[1.6] text-[#e2e8f0]\" data-kid=\"2-3-6-1-2-5-2\" data-name=\"text\">\n                            100%-ban magyar tulajdonú társaság, stabil tőkeháttérrel\n                        </span>\n                    </li>\n                    <li class=\"flex items-start gap-4 py-6 border-t border-[#26302e]\" data-kid=\"2-3-6-1-2-6\" data-name=\"licence item 6\">\n                        <i class=\"ti ti-calendar-stats text-[24px] text-[#8a9694] shrink-0 mt-0.5\" data-kid=\"2-3-6-1-2-6-1\" data-name=\"icon\">\n                        </i>\n                        <span class=\"text-[15px] leading-[1.6] text-[#e2e8f0]\" data-kid=\"2-3-6-1-2-6-2\" data-name=\"text\">\n                            2019 óta folyamatos működés\n                        </span>\n                    </li>\n                </ul>\n                <p class=\"mono text-[11.5px] tracking-[0.14em] text-[#6c7a78] mt-8 mb-0 border-t border-[#26302e] pt-7\" data-kid=\"2-3-6-1-3\" data-name=\"legal notice text\">\n                    A DOKUMENTUMOK MÁSOLATA AJÁNLATKÉRÉSRE RENDELKEZÉSRE ÁLL.\n                </p>\n            </div>\n        </section>\n        <!-- ══ 8. ABOUT ══ -->\n        <section class=\"bg-[#0c1110] py-28\" data-kid=\"2-3-7\" data-name=\"about section\" id=\"about\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))] grid lg:grid-cols-[0.85fr_1.15fr] gap-14 items-start\" data-kid=\"2-3-7-1\" data-name=\"about content\">\n                <div class=\"retic retic-red overflow-hidden lg:sticky lg:top-28\" data-kid=\"2-3-7-1-1\" data-name=\"about image container\">\n                    <img alt=\"Szolgálatot adó biztonsági őr irodaházi folyosón\" class=\"w-full h-[520px] object-cover cine\" data-kid=\"2-3-7-1-1-1\" data-name=\"about section image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image5.jpeg\"/>\n                </div>\n                <div data-kid=\"2-3-7-1-2\" data-name=\"about text\">\n                    <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-7-1-2-1\" data-name=\"section section-id label\">\n                        // 05 — RÓLUNK\n                    </p>\n                    <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0 mb-7\" data-kid=\"2-3-7-1-2-2\" data-name=\"section title\">\n                        Dog Race Security Kft.\n                    </h2>\n                    <p class=\"text-[17px] leading-[1.72] text-[#e2e8f0] m-0 pb-8 border-b border-[#1e2827]\" data-kid=\"2-3-7-1-2-3\" data-name=\"about description\">\n                        A Dog Race Security Korlátolt Felelősségű Társaság 2019 óta van jelen a magyar vagyonvédelmi és takarítási szolgáltatásokat nyújtó cégek piacán.\n                    </p>\n                    <div class=\"grid sm:grid-cols-2 gap-x-10 gap-y-9 mt-9\" data-kid=\"2-3-7-1-2-4\" data-name=\"about details grid\">\n                        <div data-kid=\"2-3-7-1-2-4-1\" data-name=\"activity scope box\">\n                            <h3 class=\"dsp text-white text-[14.5px] tracking-[0.12em] font-semibold m-0 mb-3\" data-kid=\"2-3-7-1-2-4-1-1\" data-name=\"title\">\n                                Tevékenységi köreink\n                            </h3>\n                            <p class=\"text-[14.5px] leading-[1.7] text-[#c3cdcb] m-0\" data-kid=\"2-3-7-1-2-4-1-2\" data-name=\"description\">\n                                Létesítmények és irodaházak őrzése, építési területek őrzésvédelme, vagyonvédelmi és tűzvédelmi rendszerek – beléptető- és kamerarendszerek – telepítése és igény szerinti karbantartása, valamint rendezvények biztosítása.\n                            </p>\n                        </div>\n                        <div data-kid=\"2-3-7-1-2-4-2\" data-name=\"background box\">\n                            <h3 class=\"dsp text-white text-[14.5px] tracking-[0.12em] font-semibold m-0 mb-3\" data-kid=\"2-3-7-1-2-4-2-1\" data-name=\"title\">\n                                Háttér és állomány\n                            </h3>\n                            <p class=\"text-[14.5px] leading-[1.7] text-[#c3cdcb] m-0\" data-kid=\"2-3-7-1-2-4-2-2\" data-name=\"description\">\n                                100%-ban magyar tulajdonú cégünk stabil tőkeháttérrel és többéves szakmai tapasztalattal, a hazai piaci igények alapos ismeretével nyújt teljes körű szolgáltatást üzleti ügyfelei részére, alapos szakmai tudással rendelkező munkaerővel.\n                            </p>\n                        </div>\n                        <div class=\"sm:col-span-2 border-l-2 border-[#ef4444] pl-6\" data-kid=\"2-3-7-1-2-4-3\" data-name=\"commitment box\">\n                            <h3 class=\"dsp text-white text-[14.5px] tracking-[0.12em] font-semibold m-0 mb-3\" data-kid=\"2-3-7-1-2-4-3-1\" data-name=\"title\">\n                                Amit a szerződés után is tartunk\n                            </h3>\n                            <p class=\"text-[14.5px] leading-[1.7] text-[#c3cdcb] m-0\" data-kid=\"2-3-7-1-2-4-3-2\" data-name=\"description\">\n                                Célunk, hogy Ügyfeleinket ne csak a szerződéskötés pillanatáig kezeljük kitüntetett figyelemmel, hanem a szolgáltatás teljes időtartama alatt készen álljunk minden felmerülő igény azonnali kiszolgálására – erről eddigi megrendelőink is tanúskodhatnak.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 9. TESTIMONIALS ══ -->\n        <section class=\"bg-[#0f1514] border-y border-[#1e2827] py-24\" data-kid=\"2-3-8\" data-name=\"testimonials section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-8-1\" data-name=\"testimonials content\">\n                <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-8-1-1\" data-name=\"section section-id label\">\n                    // 06 — VISSZAJELZÉSEK\n                </p>\n                <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0 mb-12\" data-kid=\"2-3-8-1-2\" data-name=\"section title\">\n                    Ügyfeleink mondták\n                </h2>\n                <div class=\"grid md:grid-cols-2 gap-8\" data-kid=\"2-3-8-1-3\" data-name=\"testimonials grid\">\n                    <figure class=\"m-0 bg-[#0c1110] border border-[#26302e] p-9 relative\" data-kid=\"2-3-8-1-3-1\" data-name=\"testimonial 1\">\n                        <i class=\"ti ti-quote absolute right-7 top-7 text-[30px] text-[#26302e]\" data-kid=\"2-3-8-1-3-1-1\" data-name=\"quote icon\">\n                        </i>\n                        <blockquote class=\"m-0 text-[19px] leading-[1.6] text-white font-light\" data-kid=\"2-3-8-1-3-1-2\" data-name=\"quote text\">\n                            „Éjszakai és hétvégi szolgálatot vettünk át tőlük egy hét alatt, a jelentések azóta minden hétfőn az asztalunkon vannak.”\n                        </blockquote>\n                        <figcaption class=\"mt-7 pt-6 border-t border-[#1e2827] flex flex-wrap items-center justify-between gap-3\" data-kid=\"2-3-8-1-3-1-3\" data-name=\"testimonial footer\">\n                            <span class=\"dsp text-[13px] tracking-[0.12em] text-[#e2e8f0]\" data-kid=\"2-3-8-1-3-1-3-1\" data-name=\"author title\">\n                                Létesítménygazdálkodási vezető, ipari park\n                            </span>\n                            <span class=\"mono text-[10.5px] tracking-[0.16em] text-[#6c7a78]\" data-kid=\"2-3-8-1-3-1-3-2\" data-name=\"status\">\n                                [ jóváhagyásra vár ]\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <figure class=\"m-0 bg-[#0c1110] border border-[#26302e] p-9 relative\" data-kid=\"2-3-8-1-3-2\" data-name=\"testimonial 2\">\n                        <i class=\"ti ti-quote absolute right-7 top-7 text-[30px] text-[#26302e]\" data-kid=\"2-3-8-1-3-2-1\" data-name=\"quote icon\">\n                        </i>\n                        <blockquote class=\"m-0 text-[19px] leading-[1.6] text-white font-light\" data-kid=\"2-3-8-1-3-2-2\" data-name=\"quote text\">\n                            „Az őrök megjelenése és a diszpécser elérhetősége az, amiért maradtunk.”\n                        </blockquote>\n                        <figcaption class=\"mt-7 pt-6 border-t border-[#1e2827] flex flex-wrap items-center justify-between gap-3\" data-kid=\"2-3-8-1-3-2-3\" data-name=\"testimonial footer\">\n                            <span class=\"dsp text-[13px] tracking-[0.12em] text-[#e2e8f0]\" data-kid=\"2-3-8-1-3-2-3-1\" data-name=\"author title\">\n                                Beruházási igazgató, építőipar\n                            </span>\n                            <span class=\"mono text-[10.5px] tracking-[0.16em] text-[#6c7a78]\" data-kid=\"2-3-8-1-3-2-3-2\" data-name=\"status\">\n                                [ jóváhagyásra vár ]\n                            </span>\n                        </figcaption>\n                    </figure>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 10. REFERENCES — LIGHT STRIP ══ -->\n        <section class=\"bg-[#e2e8f0] py-20\" data-kid=\"2-3-9\" data-name=\"references section\" id=\"references\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-9-1\" data-name=\"references content\">\n                <div class=\"flex flex-wrap items-end justify-between gap-5 mb-10 pb-6 border-b-2 border-[#0c1110]\" data-kid=\"2-3-9-1-1\" data-name=\"section header\">\n                    <div data-kid=\"2-3-9-1-1-1\" data-name=\"section label container\">\n                        <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#b91c1c] m-0 mb-3\" data-kid=\"2-3-9-1-1-1-1\" data-name=\"section-id\">\n                            // 07 — REFERENCIÁK\n                        </p>\n                        <h2 class=\"dsp text-[#0c1110] font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0\" data-kid=\"2-3-9-1-1-1-2\" data-name=\"section title\">\n                            Referenciák\n                        </h2>\n                    </div>\n                    <p class=\"dsp text-[13px] tracking-[0.14em] text-[#3d4a52] m-0\" data-kid=\"2-3-9-1-1-2\" data-name=\"description\">\n                        Partnercégeink megbíznak bennünk\n                    </p>\n                </div>\n                <div class=\"grid grid-cols-3 md:grid-cols-5 gap-4\" data-kid=\"2-3-9-1-2\" data-name=\"logo grid\">\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-1\" data-name=\"client logo container\">\n                        <img alt=\"ATEV Zrt.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-1-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/atev.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-2\" data-name=\"client logo container\">\n                        <img alt=\"STRABAG\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-2-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/strabag.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-3\" data-name=\"client logo container\">\n                        <img alt=\"Proform Ingatlanbefektetési Zrt.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-3-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/proform.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-4\" data-name=\"client logo container\">\n                        <img alt=\"Titán 94 Kft.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-4-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/titan-94.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-5\" data-name=\"client logo container\">\n                        <img alt=\"Toperini Ipari Park\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-5-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/toperini-ipari-park.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-6\" data-name=\"client logo container\">\n                        <img alt=\"Pallér Csarnok\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-6-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/paller-csarnok.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-7\" data-name=\"client logo container\">\n                        <img alt=\"Légió 2000 Security\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-7-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/legio-2000-security.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-8\" data-name=\"client logo container\">\n                        <img alt=\"HDR Hard Dog Race\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-8-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/hdr-hard-dog-race.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-9\" data-name=\"client logo container\">\n                        <img alt=\"Dogatlon\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-9-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dogatlon.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-10\" data-name=\"client logo container\">\n                        <img alt=\"DPD\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-10-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dpd.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-11\" data-name=\"client logo container\">\n                        <img alt=\"TRT Europe\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-11-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/trt-europe.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-12\" data-name=\"client logo container\">\n                        <img alt=\"Republic Group\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-12-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/republic-group.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-13\" data-name=\"client logo container\">\n                        <img alt=\"LBT Kft.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-13-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/lbt-kft.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-14\" data-name=\"client logo container\">\n                        <img alt=\"dr. Lenkei Vitamin\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-14-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dr-lenkei-vitamin.png\"/>\n                    </div>\n                    <div class=\"bg-white h-[104px] grid place-items-center p-5 border border-[#cbd3dd]\" data-kid=\"2-3-9-1-2-15\" data-name=\"client logo container\">\n                        <img alt=\"Yellow Premium Bananas\" class=\"max-h-full max-w-full object-contain\" data-kid=\"2-3-9-1-2-15-1\" data-name=\"logo\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/yellow-premium-bananas.png\"/>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══ 11. CONTACT ══ -->\n        <section class=\"bg-[#0c1110] py-28\" data-kid=\"2-3-10\" data-name=\"contact section\" id=\"contact\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-3-10-1\" data-name=\"contact content\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6 mb-12\" data-kid=\"2-3-10-1-1\" data-name=\"section header\">\n                    <div data-kid=\"2-3-10-1-1-1\" data-name=\"section label container\">\n                        <p class=\"mono text-[11.5px] tracking-[0.24em] text-[#ef4444] m-0 mb-4\" data-kid=\"2-3-10-1-1-1-1\" data-name=\"section-id\">\n                            // 08 — KAPCSOLAT\n                        </p>\n                        <h2 class=\"dsp text-white font-semibold text-[38px] leading-[1.06] tracking-[-0.01em] m-0\" data-kid=\"2-3-10-1-1-1-2\" data-name=\"section title\">\n                            Ajánlatkérés\n                        </h2>\n                    </div>\n                    <p class=\"text-[15px] text-[#8a9694] max-w-[400px] m-0\" data-kid=\"2-3-10-1-1-2\" data-name=\"section description\">\n                        Írja le az objektumot és a kívánt szolgálati rendet — írásos ajánlatot 24 órán belül küldünk.\n                    </p>\n                </div>\n                <div class=\"grid lg:grid-cols-[1.05fr_0.95fr] gap-8 items-start\" data-kid=\"2-3-10-1-2\" data-name=\"contact layout\">\n                    <!-- terminal form -->\n                    <form class=\"bg-[#0f1514] border border-[#26302e] p-8\" data-kid=\"2-3-10-1-2-1\" data-name=\"contact form\" id=\"dr-quote\" style=\"border-top:2px solid #ef4444\">\n                        <div class=\"mono flex items-center justify-between text-[11px] tracking-[0.2em] text-[#6c7a78] pb-6 mb-7 border-b border-[#1e2827]\" data-kid=\"2-3-10-1-2-1-1\" data-name=\"form header\">\n                            <span data-kid=\"2-3-10-1-2-1-1-1\" data-name=\"form id label\">\n                                AJANLATKERES.FORM\n                            </span>\n                            <span class=\"flex items-center gap-2.5 text-[#a8b4b2]\" data-kid=\"2-3-10-1-2-1-1-2\" data-name=\"status indicator\">\n                                <span class=\"live\" data-kid=\"2-3-10-1-2-1-1-2-1\" data-name=\"pulsing live indicator\">\n                                </span>\n                                DISZPÉCSER ONLINE\n                            </span>\n                        </div>\n                        <div class=\"grid sm:grid-cols-2 gap-5\" data-kid=\"2-3-10-1-2-1-2\" data-name=\"form fields\">\n                            <label class=\"block\" data-kid=\"2-3-10-1-2-1-2-1\" data-name=\"name field\">\n                                <span class=\"mono block text-[11px] tracking-[0.18em] text-[#8a9694] mb-2\" data-kid=\"2-3-10-1-2-1-2-1-1\" data-name=\"label\">\n                                    > NÉV *\n                                </span>\n                                <input class=\"term mono w-full px-4 py-3 text-[14px] rounded-none\" data-kid=\"2-3-10-1-2-1-2-1-2\" data-name=\"input\" name=\"nev\" placeholder=\"Kovács Péter\" required=\"\" type=\"text\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"2-3-10-1-2-1-2-2\" data-name=\"company field\">\n                                <span class=\"mono block text-[11px] tracking-[0.18em] text-[#8a9694] mb-2\" data-kid=\"2-3-10-1-2-1-2-2-1\" data-name=\"label\">\n                                    > CÉG\n                                </span>\n                                <input class=\"term mono w-full px-4 py-3 text-[14px] rounded-none\" data-kid=\"2-3-10-1-2-1-2-2-2\" data-name=\"input\" name=\"ceg\" placeholder=\"Példa Kft.\" type=\"text\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"2-3-10-1-2-1-2-3\" data-name=\"phone field\">\n                                <span class=\"mono block text-[11px] tracking-[0.18em] text-[#8a9694] mb-2\" data-kid=\"2-3-10-1-2-1-2-3-1\" data-name=\"label\">\n                                    > TELEFONSZÁM *\n                                </span>\n                                <input class=\"term mono w-full px-4 py-3 text-[14px] rounded-none\" data-kid=\"2-3-10-1-2-1-2-3-2\" data-name=\"input\" name=\"telefon\" placeholder=\"+36 30 123 4567\" required=\"\" type=\"tel\"/>\n                            </label>\n                            <label class=\"block\" data-kid=\"2-3-10-1-2-1-2-4\" data-name=\"email field\">\n                                <span class=\"mono block text-[11px] tracking-[0.18em] text-[#8a9694] mb-2\" data-kid=\"2-3-10-1-2-1-2-4-1\" data-name=\"label\">\n                                    > E-MAIL *\n                                </span>\n                                <input class=\"term mono w-full px-4 py-3 text-[14px] rounded-none\" data-kid=\"2-3-10-1-2-1-2-4-2\" data-name=\"input\" name=\"email\" placeholder=\"nev@pelda.hu\" required=\"\" type=\"email\"/>\n                            </label>\n                            <label class=\"block sm:col-span-2\" data-kid=\"2-3-10-1-2-1-2-5\" data-name=\"object type field\">\n                                <span class=\"mono block text-[11px] tracking-[0.18em] text-[#8a9694] mb-2\" data-kid=\"2-3-10-1-2-1-2-5-1\" data-name=\"label\">\n                                    > OBJEKTUM TÍPUSA\n                                </span>\n                                <select class=\"term mono w-full px-4 py-3 text-[14px] rounded-none\" data-kid=\"2-3-10-1-2-1-2-5-2\" data-name=\"select\" name=\"objektum\">\n                                    <option data-kid=\"2-3-10-1-2-1-2-5-2-1\" data-name=\"option\">\n                                        Irodaház\n                                    </option>\n                                    <option data-kid=\"2-3-10-1-2-1-2-5-2-2\" data-name=\"option\">\n                                        Ipari park / telephely\n                                    </option>\n                                    <option data-kid=\"2-3-10-1-2-1-2-5-2-3\" data-name=\"option\">\n                                        Építési terület\n                                    </option>\n                                    <option data-kid=\"2-3-10-1-2-1-2-5-2-4\" data-name=\"option\">\n                                        Logisztikai központ\n                                    </option>\n                                    <option data-kid=\"2-3-10-1-2-1-2-5-2-5\" data-name=\"option\">\n                                        Rendezvény\n                                    </option>\n                                    <option data-kid=\"2-3-10-1-2-1-2-5-2-6\" data-name=\"option\">\n                                        Egyéb\n                                    </option>\n                                </select>\n                            </label>\n                            <label class=\"block sm:col-span-2\" data-kid=\"2-3-10-1-2-1-2-6\" data-name=\"message field\">\n                                <span class=\"mono block text-[11px] tracking-[0.18em] text-[#8a9694] mb-2\" data-kid=\"2-3-10-1-2-1-2-6-1\" data-name=\"label\">\n                                    > ÜZENET\n                                </span>\n                                <textarea class=\"term mono w-full px-4 py-3 text-[14px] rounded-none min-h-[112px] resize-y\" data-kid=\"2-3-10-1-2-1-2-6-2\" data-name=\"textarea\" name=\"uzenet\" placeholder=\"Objektum mérete, kívánt szolgálati rend, kezdés tervezett időpontja…\"></textarea>\n                            </label>\n                        </div>\n                        <div class=\"flex flex-wrap items-center gap-5 mt-8\" data-kid=\"2-3-10-1-2-1-3\" data-name=\"submit action\">\n                            <button class=\"dsp inline-flex items-center gap-2.5 bg-[#ef4444] hover:bg-[#dc2626] text-white text-[14px] tracking-[0.1em] font-semibold px-8 py-4 rounded-[2px] transition-colors\" data-kid=\"2-3-10-1-2-1-3-1\" data-name=\"button\" type=\"submit\">\n                                Ajánlatkérés elküldése\n                                <i class=\"ti ti-send text-[18px]\" data-kid=\"2-3-10-1-2-1-3-1-1\" data-name=\"icon\">\n                                </i>\n                            </button>\n                            <p class=\"text-[12.5px] text-[#8a9694] m-0 max-w-[240px]\" data-kid=\"2-3-10-1-2-1-3-2\" data-name=\"submit hint\">\n                                A gomb az e-mail kliensét nyitja meg az adatokkal.\n                            </p>\n                        </div>\n                    </form>\n                    <!-- details + map -->\n                    <div data-kid=\"2-3-10-1-2-2\" data-name=\"contact info block\">\n                        <div class=\"bg-[#0f1514] border border-[#26302e] p-8\" data-kid=\"2-3-10-1-2-2-1\" data-name=\"info container\">\n                            <h3 class=\"dsp text-white text-[16px] tracking-[0.12em] font-semibold m-0 mb-6\" data-kid=\"2-3-10-1-2-2-1-1\" data-name=\"info title\">\n                                Elérhetőség\n                            </h3>\n                            <dl class=\"m-0 divide-y divide-[#1e2827]\" data-kid=\"2-3-10-1-2-2-1-2\" data-name=\"info list\">\n                                <div class=\"flex items-start gap-4 py-4\" data-kid=\"2-3-10-1-2-2-1-2-1\" data-name=\"address row\">\n                                    <i class=\"ti ti-map-pin text-[20px] text-[#8a9694] mt-0.5\" data-kid=\"2-3-10-1-2-2-1-2-1-1\" data-name=\"icon\">\n                                    </i>\n                                    <div data-kid=\"2-3-10-1-2-2-1-2-1-2\" data-name=\"info text\">\n                                        <dt class=\"mono text-[10.5px] tracking-[0.18em] text-[#6c7a78] mb-1\" data-kid=\"2-3-10-1-2-2-1-2-1-2-1\" data-name=\"label\">\n                                            CÍM\n                                        </dt>\n                                        <dd class=\"m-0 text-[15px] text-[#e2e8f0]\" data-kid=\"2-3-10-1-2-2-1-2-1-2-2\" data-name=\"value\">\n                                            2120 Dunakeszi, Fő út 69.\n                                        </dd>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-start gap-4 py-4\" data-kid=\"2-3-10-1-2-2-1-2-2\" data-name=\"phone row\">\n                                    <i class=\"ti ti-phone text-[20px] text-[#8a9694] mt-0.5\" data-kid=\"2-3-10-1-2-2-1-2-2-1\" data-name=\"icon\">\n                                    </i>\n                                    <div data-kid=\"2-3-10-1-2-2-1-2-2-2\" data-name=\"info text\">\n                                        <dt class=\"mono text-[10.5px] tracking-[0.18em] text-[#6c7a78] mb-1\" data-kid=\"2-3-10-1-2-2-1-2-2-2-1\" data-name=\"label\">\n                                            TELEFONSZÁM · 0–24\n                                        </dt>\n                                        <dd class=\"m-0 text-[15px]\" data-kid=\"2-3-10-1-2-2-1-2-2-2-2\" data-name=\"value\">\n                                            <a class=\"mono text-white hover:text-[#ef4444] transition-colors\" data-kid=\"2-3-10-1-2-2-1-2-2-2-2-1\" data-name=\"link\" href=\"tel:+36706069802\">\n                                                06 70 606 9802\n                                            </a>\n                                        </dd>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-start gap-4 py-4\" data-kid=\"2-3-10-1-2-2-1-2-3\" data-name=\"email row\">\n                                    <i class=\"ti ti-mail text-[20px] text-[#8a9694] mt-0.5\" data-kid=\"2-3-10-1-2-2-1-2-3-1\" data-name=\"icon\">\n                                    </i>\n                                    <div data-kid=\"2-3-10-1-2-2-1-2-3-2\" data-name=\"info text\">\n                                        <dt class=\"mono text-[10.5px] tracking-[0.18em] text-[#6c7a78] mb-1\" data-kid=\"2-3-10-1-2-2-1-2-3-2-1\" data-name=\"label\">\n                                            E-MAIL\n                                        </dt>\n                                        <dd class=\"m-0 text-[15px]\" data-kid=\"2-3-10-1-2-2-1-2-3-2-2\" data-name=\"value\">\n                                            <a class=\"text-white hover:text-[#ef4444] transition-colors\" data-kid=\"2-3-10-1-2-2-1-2-3-2-2-1\" data-name=\"link\" href=\"mailto:dograceseckft@gmail.com\">\n                                                dograceseckft@gmail.com\n                                            </a>\n                                        </dd>\n                                    </div>\n                                </div>\n                            </dl>\n                        </div>\n                        <div class=\"mt-6 border border-[#26302e] overflow-hidden\" data-kid=\"2-3-10-1-2-2-2\" data-name=\"map frame\">\n                            <iframe allowfullscreen=\"\" class=\"mapfx w-full h-[300px] block border-0\" data-kid=\"2-3-10-1-2-2-2-1\" data-name=\"embed\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps?q=2120+Dunakeszi,+F%C5%91+%C3%BAt+69&output=embed\" title=\"DOG RACE SECURITY Kft. székhelye a térképen\">\n                            </iframe>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <!-- ══ 12. FOOTER ══ -->\n    <footer class=\"bg-[#080c0b] border-t border-[#1e2827] pt-14 pb-28\" data-kid=\"2-4\" data-name=\"footer\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-3rem))]\" data-kid=\"2-4-1\" data-name=\"footer container\">\n            <div class=\"flex flex-wrap items-center justify-between gap-8 pb-9 border-b border-[#1e2827]\" data-kid=\"2-4-1-1\" data-name=\"footer top row\">\n                <a class=\"flex items-center\" data-kid=\"2-4-1-1-1\" data-name=\"logo link\" href=\"#top\">\n                    <img alt=\"DOG RACE SECURITY Kft. logó\" class=\"h-12 w-auto\" data-kid=\"2-4-1-1-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\"/>\n                </a>\n                <nav aria-label=\"Lábléc navigáció\" class=\"dsp flex flex-wrap gap-x-8 gap-y-3 text-[12.5px] tracking-[0.14em] text-[#a8b4b2]\" data-kid=\"2-4-1-1-2\" data-name=\"footer nav\">\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"2-4-1-1-2-1\" data-name=\"services link\" href=\"#services\">\n                        Szolgáltatások\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"2-4-1-1-2-2\" data-name=\"about link\" href=\"#about\">\n                        Rólunk\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"2-4-1-1-2-3\" data-name=\"process link\" href=\"#process\">\n                        Folyamat\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"2-4-1-1-2-4\" data-name=\"references link\" href=\"#references\">\n                        Referenciák\n                    </a>\n                    <a class=\"hover:text-white transition-colors\" data-kid=\"2-4-1-1-2-5\" data-name=\"contact link\" href=\"#contact\">\n                        Kapcsolat\n                    </a>\n                </nav>\n            </div>\n            <div class=\"flex flex-wrap items-center justify-between gap-4 pt-7\" data-kid=\"2-4-1-2\" data-name=\"footer bottom row\">\n                <p class=\"text-[13px] text-[#7d8a88] m-0\" data-kid=\"2-4-1-2-1\" data-name=\"copyright text\">\n                    © 2026 Dog Race Security Kft. Minden jog fenntartva.\n                </p>\n                <p class=\"text-[13px] m-0 flex items-center gap-3 text-[#7d8a88]\" data-kid=\"2-4-1-2-2\" data-name=\"footer legal links\">\n                    <a class=\"hover:text-[#e2e8f0] transition-colors underline underline-offset-4 decoration-[#3a4644]\" data-kid=\"2-4-1-2-2-1\" data-name=\"data policy link\" href=\"#\">\n                        Adatkezelési tájékoztató\n                    </a>\n                    <span class=\"text-[#3a4644]\" data-kid=\"2-4-1-2-2-2\" data-name=\"separator bullet\">\n                        ·\n                    </span>\n                    <a class=\"hover:text-[#e2e8f0] transition-colors underline underline-offset-4 decoration-[#3a4644]\" data-kid=\"2-4-1-2-2-3\" data-name=\"terms link\" href=\"#\">\n                        Általános szerződési feltételek\n                    </a>\n                </p>\n            </div>\n        </div>\n    </footer>\n    <!-- ══ 13. STICKY MOBILE CTA (floating pill) ══ -->\n    <div class=\"fixed left-1/2 -translate-x-1/2 bottom-5 z-50 flex items-center gap-1 bg-[#ef4444] rounded-full shadow-[0_10px_30px_rgba(239,68,68,.35)] p-1.5\" data-kid=\"2-5\" data-name=\"floating mobile action bar\">\n        <a class=\"dsp inline-flex items-center gap-2 text-white text-[13px] tracking-[0.12em] font-semibold px-5 py-3 rounded-full hover:bg-white/15 transition-colors\" data-kid=\"2-5-1\" data-name=\"phone call button\" href=\"tel:+36706069802\">\n            <i class=\"ti ti-phone text-[17px]\" data-kid=\"2-5-1-1\" data-name=\"phone icon\">\n            </i>\n            Hívás\n        </a>\n        <span class=\"w-px h-6 bg-white/30\" data-kid=\"2-5-2\" data-name=\"separator\">\n        </span>\n        <a class=\"dsp inline-flex items-center gap-2 bg-[#0c1110] text-white text-[13px] tracking-[0.12em] font-semibold px-5 py-3 rounded-full hover:bg-[#161e1d] transition-colors\" data-kid=\"2-5-3\" data-name=\"request offer button\" href=\"#contact\">\n            Ajánlatkérés\n            <i class=\"ti ti-arrow-narrow-right text-[17px]\" data-kid=\"2-5-3-1\" data-name=\"arrow icon\">\n            </i>\n        </a>\n    </div>\n</div>\n<script>\n    (function () {\n    var form = document.getElementById('dr-quote');\n    if (!form) return;\n    form.addEventListener('submit', function (e) {\n      e.preventDefault();\n      var d = new FormData(form);\n      var subject = 'Ajánlatkérés – ' + (d.get('ceg') || d.get('nev') || 'Weboldal');\n      var body = [\n        'Név: ' + (d.get('nev') || ''),\n        'Cég: ' + (d.get('ceg') || ''),\n        'Telefonszám: ' + (d.get('telefon') || ''),\n        'E-mail: ' + (d.get('email') || ''),\n        'Objektum típusa: ' + (d.get('objektum') || ''),\n        '',\n        (d.get('uzenet') || '')\n      ].join('\\n');\n      window.location.href = 'mailto:dograceseckft@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);\n    });\n  })();\n</script>\n",
