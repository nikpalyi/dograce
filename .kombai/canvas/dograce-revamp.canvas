grid grid-cols-1 lg:grid-cols-[minmax(0,54fr)_minmax(0,46fr)] gap-14\" data-kid=\"1-3-10-1-1-1\" data-name=\"contact content grid\">\n                        <!-- form -->\n                        <div data-kid=\"1-3-10-1-1-1-1\" data-name=\"form container\">\n                            <p class=\"label text-[#9a7644] mb-5\" data-kid=\"1-3-10-1-1-1-1-1\" data-name=\"form label\">\n                                Ajánlatkérés\n                            </p>\n                            <h2 class=\"pf text-[#0a1428] font-semibold text-[clamp(1.8rem,2.3vw,2.3rem)] leading-[1.15] tracking-[-.01em]\" data-kid=\"1-3-10-1-1-1-1-2\" data-name=\"form headline\">\n                                Írásos ajánlat 24 órán belül.\n                            </h2>\n                            <div class=\"brass-rule w-[64px] mt-6\" data-kid=\"1-3-10-1-1-1-1-3\" data-name=\"decorative brass rule\">\n                            </div>\n                            <form class=\"mt-9 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-7\" data-kid=\"1-3-10-1-1-1-1-4\" data-name=\"quote contact form\" id=\"quote-form\">\n                                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-10-1-1-1-1-4-1\" data-name=\"form field name\">\n                                    <label class=\"label text-[#8a8579]\" data-kid=\"1-3-10-1-1-1-1-4-1-1\" data-name=\"field label\" for=\"q-nev\">\n                                        Név\n                                    </label>\n                                    <input class=\"field bg-transparent border-0 border-b-2 border-[#b8905b]/70 pb-2.5 text-[1rem] text-[#0a1428] placeholder:text-[#a8a293]\" data-kid=\"1-3-10-1-1-1-1-4-1-2\" data-name=\"name input\" id=\"q-nev\" name=\"nev\" placeholder=\"Kovács Péter\" required=\"\" type=\"text\"/>\n                                </div>\n                                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-10-1-1-1-1-4-2\" data-name=\"form field company\">\n                                    <label class=\"label text-[#8a8579]\" data-kid=\"1-3-10-1-1-1-1-4-2-1\" data-name=\"field label\" for=\"q-ceg\">\n                                        Cég\n                                    </label>\n                                    <input class=\"field bg-transparent border-0 border-b-2 border-[#b8905b]/70 pb-2.5 text-[1rem] text-[#0a1428] placeholder:text-[#a8a293]\" data-kid=\"1-3-10-1-1-1-1-4-2-2\" data-name=\"company input\" id=\"q-ceg\" name=\"ceg\" placeholder=\"Példa Ingatlan Zrt.\" type=\"text\"/>\n                                </div>\n                                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-10-1-1-1-1-4-3\" data-name=\"form field phone\">\n                                    <label class=\"label text-[#8a8579]\" data-kid=\"1-3-10-1-1-1-1-4-3-1\" data-name=\"field label\" for=\"q-tel\">\n                                        Telefonszám\n                                    </label>\n                                    <input class=\"field bg-transparent border-0 border-b-2 border-[#b8905b]/70 pb-2.5 text-[1rem] text-[#0a1428] placeholder:text-[#a8a293]\" data-kid=\"1-3-10-1-1-1-1-4-3-2\" data-name=\"phone input\" id=\"q-tel\" name=\"telefon\" placeholder=\"+36 30 123 4567\" required=\"\" type=\"tel\"/>\n                                </div>\n                                <div class=\"flex flex-col gap-2\" data-kid=\"1-3-10-1-1-1-1-4-4\" data-name=\"form field email\">\n                                    <label class=\"label text-[#8a8579]\" data-kid=\"1-3-10-1-1-1-1-4-4-1\" data-name=\"field label\" for=\"q-email\">\n                                        E-mail\n                                    </label>\n                                    <input class=\"field bg-transparent border-0 border-b-2 border-[#b8905b]/70 pb-2.5 text-[1rem] text-[#0a1428] placeholder:text-[#a8a293]\" data-kid=\"1-3-10-1-1-1-1-4-4-2\" data-name=\"email input\" id=\"q-email\" name=\"email\" placeholder=\"nev@pelda.hu\" required=\"\" type=\"email\"/>\n                                </div>\n                                <div class=\"flex flex-col gap-2 sm:col-span-2\" data-kid=\"1-3-10-1-1-1-1-4-5\" data-name=\"form field type\">\n                                    <label class=\"label text-[#8a8579]\" data-kid=\"1-3-10-1-1-1-1-4-5-1\" data-name=\"field label\" for=\"q-tipus\">\n                                        Objektum típusa\n                                    </label>\n                                    <select class=\"field bg-transparent border-0 border-b-2 border-[#b8905b]/70 pb-2.5 text-[1rem] text-[#0a1428]\" data-kid=\"1-3-10-1-1-1-1-4-5-2\" data-name=\"type select\" id=\"q-tipus\" name=\"tipus\">\n                                        <option data-kid=\"1-3-10-1-1-1-1-4-5-2-1\">\n                                            Irodaház\n                                        </option>\n                                        <option data-kid=\"1-3-10-1-1-1-1-4-5-2-2\">\n                                            Ipari park / telephely\n                                        </option>\n                                        <option data-kid=\"1-3-10-1-1-1-1-4-5-2-3\">\n                                            Építési terület\n                                        </option>\n                                        <option data-kid=\"1-3-10-1-1-1-1-4-5-2-4\">\n                                            Logisztikai központ\n                                        </option>\n                                        <option data-kid=\"1-3-10-1-1-1-1-4-5-2-5\">\n                                            Rendezvény\n                                        </option>\n                                        <option data-kid=\"1-3-10-1-1-1-1-4-5-2-6\">\n                                            Egyéb\n                                        </option>\n                                    </select>\n                                </div>\n                                <div class=\"flex flex-col gap-2 sm:col-span-2\" data-kid=\"1-3-10-1-1-1-1-4-6\" data-name=\"form field message\">\n                                    <label class=\"label text-[#8a8579]\" data-kid=\"1-3-10-1-1-1-1-4-6-1\" data-name=\"field label\" for=\"q-uzenet\">\n                                        Üzenet\n                                    </label>\n                                    <textarea class=\"field bg-transparent border-0 border-b-2 border-[#b8905b]/70 pb-2.5 text-[1rem] text-[#0a1428] placeholder:text-[#a8a293] resize-y\" data-kid=\"1-3-10-1-1-1-1-4-6-2\" data-name=\"message textarea\" id=\"q-uzenet\" name=\"uzenet\" placeholder=\"Objektum címe, kért szolgálati rend, létszám…\" rows=\"3\"></textarea>\n                                </div>\n                                <div class=\"sm:col-span-2 flex flex-wrap items-center gap-5 pt-1\" data-kid=\"1-3-10-1-1-1-1-4-7\" data-name=\"form footer\">\n                                    <button class=\"inline-flex items-center gap-2.5 bg-[#0a1428] text-[#fcfbf9] px-8 py-4 label text-[.74rem] rounded-[3px] hover:bg-[#b8905b] hover:text-[#0a1428] transition-colors\" data-kid=\"1-3-10-1-1-1-1-4-7-1\" data-name=\"submit button\" type=\"submit\">\n                                        Ajánlatkérés elküldése\n                                        <i class=\"ti ti-arrow-narrow-right text-[1.05rem]\" data-kid=\"1-3-10-1-1-1-1-4-7-1-1\" data-name=\"arrow right icon\">\n                                        </i>\n                                    </button>\n                                    <p class=\"text-[.8rem] text-[#8a8579] max-w-[260px] leading-snug\" data-kid=\"1-3-10-1-1-1-1-4-7-2\" data-name=\"submit hint\">\n                                        A gomb az e-mail kliensét nyitja meg az adatokkal.\n                                    </p>\n                                </div>\n                            </form>\n                        </div>\n                        <!-- details + map -->\n                        <div class=\"flex flex-col\" data-kid=\"1-3-10-1-1-1-2\" data-name=\"contact details container\">\n                            <p class=\"label text-[#9a7644] mb-6\" data-kid=\"1-3-10-1-1-1-2-1\" data-name=\"contact detail label\">\n                                Elérhetőség\n                            </p>\n                            <dl class=\"divide-y divide-[#0a1428]/12 border-y border-[#0a1428]/12\" data-kid=\"1-3-10-1-1-1-2-2\" data-name=\"contact list\">\n                                <div class=\"flex items-start gap-4 py-5\" data-kid=\"1-3-10-1-1-1-2-2-1\" data-name=\"address row\">\n                                    <i class=\"ti ti-map-pin text-[#9a7644] text-[1.25rem] mt-0.5\" data-kid=\"1-3-10-1-1-1-2-2-1-1\" data-name=\"map pin icon\">\n                                    </i>\n                                    <div data-kid=\"1-3-10-1-1-1-2-2-1-2\" data-name=\"address details\">\n                                        <dt class=\"label text-[#8a8579] mb-1\" data-kid=\"1-3-10-1-1-1-2-2-1-2-1\" data-name=\"address label\">\n                                            Cím\n                                        </dt>\n                                        <dd class=\"text-[1rem] text-[#0a1428] font-medium\" data-kid=\"1-3-10-1-1-1-2-2-1-2-2\" data-name=\"address value\">\n                                            2120 Dunakeszi, Fő út 69.\n                                        </dd>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-start gap-4 py-5\" data-kid=\"1-3-10-1-1-1-2-2-2\" data-name=\"phone row\">\n                                    <i class=\"ti ti-phone text-[#9a7644] text-[1.25rem] mt-0.5\" data-kid=\"1-3-10-1-1-1-2-2-2-1\" data-name=\"phone icon\">\n                                    </i>\n                                    <div data-kid=\"1-3-10-1-1-1-2-2-2-2\" data-name=\"phone details\">\n                                        <dt class=\"label text-[#8a8579] mb-1\" data-kid=\"1-3-10-1-1-1-2-2-2-2-1\" data-name=\"phone label\">\n                                            Telefonszám\n                                        </dt>\n                                        <dd class=\"text-[1rem] font-medium\" data-kid=\"1-3-10-1-1-1-2-2-2-2-2\" data-name=\"phone value\">\n                                            <a class=\"text-[#0a1428] underline decoration-[#b8905b] decoration-2 underline-offset-4 hover:text-[#9a7644] transition-colors\" data-kid=\"1-3-10-1-1-1-2-2-2-2-2-1\" data-name=\"phone link\" href=\"tel:+36706069802\">\n                                                06 70 606 9802\n                                            </a>\n                                        </dd>\n                                    </div>\n                                </div>\n                                <div class=\"flex items-start gap-4 py-5\" data-kid=\"1-3-10-1-1-1-2-2-3\" data-name=\"email row\">\n                                    <i class=\"ti ti-mail text-[#9a7644] text-[1.25rem] mt-0.5\" data-kid=\"1-3-10-1-1-1-2-2-3-1\" data-name=\"email icon\">\n                                    </i>\n                                    <div data-kid=\"1-3-10-1-1-1-2-2-3-2\" data-name=\"email details\">\n                                        <dt class=\"label text-[#8a8579] mb-1\" data-kid=\"1-3-10-1-1-1-2-2-3-2-1\" data-name=\"email label\">\n                                            E-mail\n                                        </dt>\n                                        <dd class=\"text-[1rem] font-medium\" data-kid=\"1-3-10-1-1-1-2-2-3-2-2\" data-name=\"email value\">\n                                            <a class=\"text-[#0a1428] underline decoration-[#b8905b] decoration-2 underline-offset-4 hover:text-[#9a7644] transition-colors\" data-kid=\"1-3-10-1-1-1-2-2-3-2-2-1\" data-name=\"email link\" href=\"mailto:dograceseckft@gmail.com\">\n                                                dograceseckft@gmail.com\n                                            </a>\n                                        </dd>\n                                    </div>\n                                </div>\n                            </dl>\n                            <div class=\"mt-8 overflow-hidden rounded-[12px] grow min-h-[280px] bg-[#e6e2da]\" data-kid=\"1-3-10-1-1-1-2-3\" data-name=\"map container\">\n                                <iframe class=\"w-full h-full min-h-[280px] border-0 block\" data-kid=\"1-3-10-1-1-1-2-3-1\" data-name=\"map iframe\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" src=\"https://www.google.com/maps?q=2120+Dunakeszi,+F%C5%91+%C3%BAt+69&output=embed\" style=\"filter: grayscale(1) contrast(.92) brightness(1.06);\" title=\"Dog Race Security Kft. térkép\">\n                                </iframe>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <!-- ══════════ 12. FOOTER ══════════ -->\n    <footer class=\"bg-[#0a1428] pt-16 pb-10\" data-kid=\"1-4\" data-name=\"footer section\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))]\" data-kid=\"1-4-1\" data-name=\"footer container\">\n            <div class=\"flex flex-wrap items-center justify-between gap-8 pb-10 border-b border-[#b8905b]/25\" data-kid=\"1-4-1-1\" data-name=\"footer header\">\n                <img alt=\"DOG RACE SECURITY Kft. logó\" class=\"h-[50px] w-auto\" data-kid=\"1-4-1-1-1\" data-name=\"footer logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\"/>\n                <nav class=\"flex flex-wrap gap-x-8 gap-y-3 label text-[#b8905b]\" data-kid=\"1-4-1-1-2\" data-name=\"footer navigation\">\n                    <a class=\"hover:text-[#e0bd8c] transition-colors\" data-kid=\"1-4-1-1-2-1\" data-name=\"footer nav services\" href=\"#services\">\n                        Szolgáltatások\n                    </a>\n                    <a class=\"hover:text-[#e0bd8c] transition-colors\" data-kid=\"1-4-1-1-2-2\" data-name=\"footer nav about\" href=\"#about\">\n                        Rólunk\n                    </a>\n                    <a class=\"hover:text-[#e0bd8c] transition-colors\" data-kid=\"1-4-1-1-2-3\" data-name=\"footer nav process\" href=\"#process\">\n                        Folyamat\n                    </a>\n                    <a class=\"hover:text-[#e0bd8c] transition-colors\" data-kid=\"1-4-1-1-2-4\" data-name=\"footer nav references\" href=\"#references\">\n                        Referenciák\n                    </a>\n                    <a class=\"hover:text-[#e0bd8c] transition-colors\" data-kid=\"1-4-1-1-2-5\" data-name=\"footer nav contact\" href=\"#contact\">\n                        Kapcsolat\n                    </a>\n                </nav>\n            </div>\n            <div class=\"pt-8 flex flex-wrap items-center justify-between gap-5 text-[.84rem] text-[#8f97a8]\" data-kid=\"1-4-1-2\" data-name=\"footer bottom\">\n                <p data-kid=\"1-4-1-2-1\" data-name=\"copyright text\">\n                    © 2026 Dog Race Security Kft. Minden jog fenntartva.\n                </p>\n                <div class=\"flex flex-wrap gap-x-6 gap-y-2\" data-kid=\"1-4-1-2-2\" data-name=\"footer policy links\">\n                    <a class=\"hover:text-[#b8905b] transition-colors\" data-kid=\"1-4-1-2-2-1\" data-name=\"privacy policy link\" href=\"#\">\n                        Adatkezelési tájékoztató\n                    </a>\n                    <a class=\"hover:text-[#b8905b] transition-colors\" data-kid=\"1-4-1-2-2-2\" data-name=\"tos link\" href=\"#\">\n                        Általános szerződési feltételek\n                    </a>\n                </div>\n            </div>\n        </div>\n    </footer>\n    <!-- ══════════ 13. STICKY MOBILE CALL / QUOTE BAR (live markup, mobile only) ══════════ -->\n    <div class=\"md:hidden fixed bottom-0 left-0 right-0 z-50 grid grid-cols-2 border-t border-[#b8905b]/40 bg-[#0a1428]\" data-kid=\"1-5\" data-name=\"mobile sticky action bar\">\n        <a class=\"flex items-center justify-center gap-2 py-4 label text-[.72rem] text-[#fcfbf9]\" data-kid=\"1-5-1\" data-name=\"mobile call button\" href=\"tel:+36706069802\">\n            <i class=\"ti ti-phone text-[1.05rem] text-[#b8905b]\" data-kid=\"1-5-1-1\" data-name=\"mobile phone icon\">\n            </i>\n            Hívás\n        </a>\n        <a class=\"flex items-center justify-center gap-2 py-4 label text-[.72rem] text-[#0a1428] bg-[#b8905b]\" data-kid=\"1-5-2\" data-name=\"mobile quote button\" href=\"#contact\">\n            <i class=\"ti ti-file-text text-[1.05rem]\" data-kid=\"1-5-2-1\" data-name=\"mobile file icon\">\n            </i>\n            Ajánlatkérés\n        </a>\n    </div>\n    <!-- desktop demonstration of the mobile bar -->\n    <section class=\"bg-[#f4f1ec] py-16 border-t border-[#0a1428]/10\" data-kid=\"1-6\" data-name=\"desktop demonstration section\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] flex flex-wrap items-center gap-14\" data-kid=\"1-6-1\" data-name=\"demo layout container\">\n            <div data-kid=\"1-6-1-1\" data-name=\"demo info column\">\n                <p class=\"label text-[#8a8579] mb-4\" data-kid=\"1-6-1-1-1\" data-name=\"demo section label\">\n                    Mobil nézet — rögzített gyors elérés\n                </p>\n                <h3 class=\"pf text-[#0a1428] text-[1.5rem] font-semibold leading-tight max-w-[420px]\" data-kid=\"1-6-1-1-2\" data-name=\"demo headline\">\n                    Telefonon a hívás és az ajánlatkérés mindig a képernyő alján marad.\n                </h3>\n                <p class=\"mt-4 text-[.92rem] leading-[1.7] text-[#4a5470] max-w-[420px]\" data-kid=\"1-6-1-1-3\" data-name=\"demo description\">\n                    A jelenlegi oldalon a telefonszám mobilon teljesen eltűnik — itt tapintható méretű, állandóan látható sávban van.\n                </p>\n            </div>\n            <div class=\"w-[288px] shrink-0 rounded-[26px] border-[7px] border-[#0a1428] overflow-hidden bg-[#fcfbf9] shadow-[0_30px_60px_-25px_rgba(10,20,40,.4)]\" data-kid=\"1-6-1-2\" data-name=\"mobile interface mock\">\n                <div class=\"bg-[#0a1428] text-[#c9cfdd] text-[.6rem] px-4 py-1.5 flex justify-between\" data-kid=\"1-6-1-2-1\" data-name=\"mock status bar\">\n                    <span data-kid=\"1-6-1-2-1-1\" data-name=\"mock time\">\n                        09:41\n                    </span>\n                    <span class=\"inline-flex gap-1\" data-kid=\"1-6-1-2-1-2\" data-name=\"mock signals\">\n                        <i class=\"ti ti-signal-4g\" data-kid=\"1-6-1-2-1-2-1\" data-name=\"mock signal icon\">\n                        </i>\n                        <i class=\"ti ti-battery-3\" data-kid=\"1-6-1-2-1-2-2\" data-name=\"mock battery icon\">\n                        </i>\n                    </span>\n                </div>\n                <div class=\"px-4 pt-4 pb-3 flex items-center justify-between border-b border-[#0a1428]/10\" data-kid=\"1-6-1-2-2\" data-name=\"mock header\">\n                    <img alt=\"DOG RACE SECURITY logó\" class=\"h-[30px] w-auto\" data-kid=\"1-6-1-2-2-1\" data-name=\"mock logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\" style=\"filter: invert(1);\"/>\n                    <i class=\"ti ti-menu-2 text-[1.15rem] text-[#0a1428]\" data-kid=\"1-6-1-2-2-2\" data-name=\"mock hamburger menu icon\">\n                    </i>\n                </div>\n                <div class=\"px-4 pt-5\" data-kid=\"1-6-1-2-3\" data-name=\"mock content area\">\n                    <p class=\"label text-[#9a7644] text-[.55rem] mb-2.5\" data-kid=\"1-6-1-2-3-1\" data-name=\"mock label\">\n                        Vagyonvédelem · Portaszolgálat\n                    </p>\n                    <p class=\"pf text-[#0a1428] text-[1.22rem] font-semibold leading-[1.16]\" data-kid=\"1-6-1-2-3-2\" data-name=\"mock headline\">\n                        2019 óta őrizzük ipari parkok és irodaházak vagyonát.\n                    </p>\n                    <div class=\"brass-rule w-[46px] mt-4\" data-kid=\"1-6-1-2-3-3\" data-name=\"mock decorative rule\">\n                    </div>\n                    <div class=\"mt-4 arch-sm overflow-hidden aspect-[4/2.6] bg-[#0a1428]\" data-kid=\"1-6-1-2-3-4\" data-name=\"mock card image container\">\n                        <img alt=\"Szolgálatban lévő biztonsági munkatárs\" class=\"w-full h-full object-cover photo\" data-kid=\"1-6-1-2-3-4-1\" data-name=\"mock card image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image5.jpeg\"/>\n                    </div>\n                </div>\n                <div class=\"mt-4 grid grid-cols-2 border-t border-[#b8905b]/40 bg-[#0a1428]\" data-kid=\"1-6-1-2-4\" data-name=\"mock action bar\">\n                    <span class=\"flex items-center justify-center gap-1.5 py-3 label text-[.6rem] text-[#fcfbf9]\" data-kid=\"1-6-1-2-4-1\" data-name=\"mock call button\">\n                        <i class=\"ti ti-phone text-[.9rem] text-[#b8905b]\" data-kid=\"1-6-1-2-4-1-1\" data-name=\"mock phone icon\">\n                        </i>\n                        Hívás\n                    </span>\n                    <span class=\"flex items-center justify-center gap-1.5 py-3 label text-[.6rem] text-[#0a1428] bg-[#b8905b]\" data-kid=\"1-6-1-2-4-2\" data-name=\"mock quote button\">\n                        <i class=\"ti ti-file-text text-[.9rem]\" data-kid=\"1-6-1-2-4-2-1\" data-name=\"mock file icon\">\n                        </i>\n                        Ajánlatkérés\n                    </span>\n                </div>\n            </div>\n        </div>\n    </section>\n</div>\n<script>\n    document.getElementById('quote-form').addEventListener('submit', function (event) {\n    event.preventDefault();\n    var d = new FormData(event.target);\n    var subject = 'Ajánlatkérés – ' + (d.get('ceg') || d.get('nev') || 'Weboldal');\n    var body =\n      'Név: ' + (d.get('nev') || '') + '\\n' +\n      'Cég: ' + (d.get('ceg') || '') + '\\n' +\n      'Telefonszám: ' + (d.get('telefon') || '') + '\\n' +\n      'E-mail: ' + (d.get('email') || '') + '\\n' +\n      'Objektum típusa: ' + (d.get('tipus') || '') + '\\n\\n' +\n      (d.get('uzenet') || '');\n    window.location.href = 'mailto:dograceseckft@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);\n  });\n</script>\n",
