      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  .pf { font-family: 'Playfair Display', Georgia, serif; }\n  .dm { font-family: 'DM Sans', system-ui, sans-serif; }\n  .label { font-family: 'DM Sans', system-ui, sans-serif; letter-spacing: .18em; text-transform: uppercase; font-weight: 700; font-size: .68rem; }\n  .arch { border-radius: 260px 260px 10px 10px; }\n  .arch-sm { border-radius: 160px 160px 8px 8px; }\n  .photo { filter: grayscale(.18) brightness(.94) contrast(1.06); }\n  .brass-rule { height: 2px; background: #b8905b; }\n  .field { transition: border-color .18s ease, background-color .18s ease; }\n  .field:focus { outline: 2px solid #b8905b; outline-offset: 3px; border-bottom-color: #0a1428; background: #ffffff; }\n  .lift { transition: transform .25s ease, box-shadow .25s ease; }\n  .lift:hover { transform: translateY(-3px); box-shadow: 0 26px 50px rgba(10,20,40,.10); }\n  .logo-chip img { transition: transform .25s ease; }\n  .logo-chip:hover img { transform: scale(1.04); }\n  .navlink { position: relative; }\n  .navlink::after { content: ''; position: absolute; left: 0; bottom: -6px; height: 1px; width: 0; background: #b8905b; transition: width .22s ease; }\n  .navlink:hover::after { width: 100%; }\n</style>\n<div class=\"dm bg-[#fcfbf9] text-[#16213a] antialiased\" data-kid=\"1\" data-name=\"page layout container\">\n    <!-- ══════════ 1. UTILITY STRIP ══════════ -->\n    <div class=\"bg-[#0a1428] text-[#c9cfdd]\" data-kid=\"1-1\" data-name=\"utility strip container\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] flex items-center justify-between py-2.5 text-[.78rem]\" data-kid=\"1-1-1\" data-name=\"utility strip content wrapper\">\n            <div class=\"flex items-center gap-7\" data-kid=\"1-1-1-1\" data-name=\"contact details group\">\n                <span class=\"inline-flex items-center gap-2 text-[.95em]\" data-kid=\"1-1-1-1-1\" data-name=\"location display\">\n                    <i class=\"ti ti-map-pin text-[#b8905b] text-[1.05rem]\" data-kid=\"1-1-1-1-1-1\" data-name=\"location marker icon\">\n                    </i>\n                    2120 Dunakeszi, Fő út 69.\n                </span>\n                <a class=\"inline-flex items-center gap-2 hover:text-white transition-colors\" data-kid=\"1-1-1-1-2\" data-name=\"email link\" href=\"mailto:dograceseckft@gmail.com\">\n                    <i class=\"ti ti-mail text-[#b8905b] text-[1.05rem]\" data-kid=\"1-1-1-1-2-1\" data-name=\"email icon\">\n                    </i>\n                    dograceseckft@gmail.com\n                </a>\n            </div>\n            <div class=\"flex items-center gap-6\" data-kid=\"1-1-1-2\" data-name=\"service hours and phone group\">\n                <span class=\"hidden lg:inline text-[#8f97a8]\" data-kid=\"1-1-1-2-1\" data-name=\"service hours label\">\n                    Diszpécserszolgálat 0–24\n                </span>\n                <a class=\"inline-flex items-center gap-2 font-bold text-white tracking-wide hover:text-[#e0bd8c] transition-colors\" data-kid=\"1-1-1-2-2\" data-name=\"phone call link\" href=\"tel:+36706069802\">\n                    <i class=\"ti ti-phone text-[#b8905b] text-[1.05rem]\" data-kid=\"1-1-1-2-2-1\" data-name=\"phone icon\">\n                    </i>\n                    06 70 606 9802\n                </a>\n            </div>\n        </div>\n    </div>\n    <!-- ══════════ 1b. HEADER ══════════ -->\n    <header class=\"sticky top-0 z-40 bg-[#fcfbf9]/94 backdrop-blur-md border-b border-[#0a1428]/10\" data-kid=\"1-2\" data-name=\"sticky header section\">\n        <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] flex items-center justify-between py-4\" data-kid=\"1-2-1\" data-name=\"header content wrapper\">\n            <a class=\"flex items-center shrink-0\" data-kid=\"1-2-1-1\" data-name=\"logo link\" href=\"#top\">\n                <img alt=\"DOG RACE SECURITY Kft. logó\" class=\"h-[54px] w-auto\" data-kid=\"1-2-1-1-1\" data-name=\"company logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/dograce_logo_transparent.png\" style=\"filter: invert(1);\"/>\n            </a>\n            <nav class=\"hidden md:flex items-center gap-9 text-[.82rem] font-medium text-[#3c4762]\" data-kid=\"1-2-1-2\" data-name=\"main navigation menu\">\n                <a class=\"navlink\" data-kid=\"1-2-1-2-1\" data-name=\"services nav link\" href=\"#services\">\n                    Szolgáltatások\n                </a>\n                <a class=\"navlink\" data-kid=\"1-2-1-2-2\" data-name=\"about nav link\" href=\"#about\">\n                    Rólunk\n                </a>\n                <a class=\"navlink\" data-kid=\"1-2-1-2-3\" data-name=\"process nav link\" href=\"#process\">\n                    Folyamat\n                </a>\n                <a class=\"navlink\" data-kid=\"1-2-1-2-4\" data-name=\"references nav link\" href=\"#references\">\n                    Referenciák\n                </a>\n                <a class=\"navlink\" data-kid=\"1-2-1-2-5\" data-name=\"contact nav link\" href=\"#contact\">\n                    Kapcsolat\n                </a>\n            </nav>\n            <a class=\"hidden sm:inline-flex items-center gap-2 bg-[#0a1428] text-[#fcfbf9] px-6 py-3 text-[.78rem] label rounded-[3px] hover:bg-[#b8905b] hover:text-[#0a1428] transition-colors\" data-kid=\"1-2-1-3\" data-name=\"header quote call-to-action button\" href=\"#contact\">\n                Ajánlatkérés\n            </a>\n        </div>\n    </header>\n    <main data-kid=\"1-3\" data-name=\"main page content\" id=\"top\">\n        <!-- ══════════ 2. HERO ══════════ -->\n        <section class=\"relative overflow-hidden\" data-kid=\"1-3-1\" data-name=\"hero section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] grid grid-cols-1 lg:grid-cols-[minmax(0,60fr)_minmax(0,40fr)] gap-16 items-center pt-20 pb-24\" data-kid=\"1-3-1-1\" data-name=\"hero layout grid\">\n                <div data-kid=\"1-3-1-1-1\" data-name=\"hero content column\">\n                    <p class=\"label text-[#9a7644] mb-7\" data-kid=\"1-3-1-1-1-1\" data-name=\"hero pre-headline label\">\n                        Vagyonvédelem · Portaszolgálat · Járőrszolgálat\n                    </p>\n                    <h1 class=\"pf text-[#0a1428] font-semibold leading-[1.06] tracking-[-.015em] text-[clamp(2.6rem,3.9vw,3.85rem)]\" data-kid=\"1-3-1-1-1-2\" data-name=\"hero main headline\">\n                        2019 óta őrizzük ipari parkok, irodaházak és építési területek vagyonát.\n                    </h1>\n                    <div class=\"brass-rule w-[110px] mt-9\" data-kid=\"1-3-1-1-1-3\" data-name=\"decorative brass rule\">\n                    </div>\n                    <p class=\"mt-8 text-[1.06rem] leading-[1.72] text-[#3c4762] max-w-[560px]\" data-kid=\"1-3-1-1-1-4\" data-name=\"hero description paragraph\">\n                        Objektumőrzés, portaszolgálat és járőrszolgálat országos lefedettséggel — 40 fős, feddhetetlenségi vizsgálaton átesett állománnyal, 0–24 diszpécserháttérrel.\n                    </p>\n                    <div class=\"mt-10 flex flex-wrap items-center gap-4\" data-kid=\"1-3-1-1-1-5\" data-name=\"hero buttons container\">\n                        <a class=\"inline-flex items-center gap-2.5 bg-[#b8905b] text-[#0a1428] px-8 py-4 label text-[.76rem] rounded-[3px] hover:bg-[#0a1428] hover:text-[#fcfbf9] transition-colors\" data-kid=\"1-3-1-1-1-5-1\" data-name=\"hero primary quote button\" href=\"#contact\">\n                            Ajánlatkérés 24 órán belül\n                            <i class=\"ti ti-arrow-narrow-right text-[1.1rem]\" data-kid=\"1-3-1-1-1-5-1-1\" data-name=\"arrow right icon\">\n                            </i>\n                        </a>\n                        <a class=\"inline-flex items-center gap-2.5 border border-[#0a1428]/25 text-[#0a1428] px-7 py-4 rounded-[3px] font-bold text-[.95rem] hover:border-[#b8905b] hover:bg-white transition-colors\" data-kid=\"1-3-1-1-1-5-2\" data-name=\"hero secondary call button\" href=\"tel:+36706069802\">\n                            <i class=\"ti ti-phone text-[1.15rem] text-[#9a7644]\" data-kid=\"1-3-1-1-1-5-2-1\" data-name=\"phone icon\">\n                            </i>\n                            06 70 606 9802\n                        </a>\n                    </div>\n                    <ul class=\"mt-11 pt-7 border-t border-[#0a1428]/12 flex flex-wrap gap-x-8 gap-y-3 text-[.83rem] text-[#4a5470]\" data-kid=\"1-3-1-1-1-6\" data-name=\"hero trust signals list\">\n                        <li class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-1-1-6-1\" data-name=\"trust signal item 1\">\n                            <i class=\"ti ti-shield-check text-[#9a7644] text-[1.05rem]\" data-kid=\"1-3-1-1-1-6-1-1\" data-name=\"shield check icon\">\n                            </i>\n                            Vagyonvédelmi tevékenységi engedély\n                        </li>\n                        <li class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-1-1-6-2\" data-name=\"trust signal item 2\">\n                            <i class=\"ti ti-file-text text-[#9a7644] text-[1.05rem]\" data-kid=\"1-3-1-1-1-6-2-1\" data-name=\"document icon\">\n                            </i>\n                            Felelősségbiztosítás\n                        </li>\n                        <li class=\"inline-flex items-center gap-2\" data-kid=\"1-3-1-1-1-6-3\" data-name=\"trust signal item 3\">\n                            <i class=\"ti ti-flag text-[#9a7644] text-[1.05rem]\" data-kid=\"1-3-1-1-1-6-3-1\" data-name=\"flag icon\">\n                            </i>\n                            100%-ban magyar tulajdon\n                        </li>\n                    </ul>\n                </div>\n                <div class=\"relative\" data-kid=\"1-3-1-1-2\" data-name=\"hero visual column\">\n                    <div class=\"absolute -left-8 -top-8 w-[190px] h-[190px] border border-[#b8905b]/45 arch-sm hidden lg:block\" data-kid=\"1-3-1-1-2-1\" data-name=\"hero background decorative element\">\n                    </div>\n                    <div class=\"relative arch overflow-hidden aspect-[3/4.15] bg-[#0a1428] shadow-[0_40px_80px_-30px_rgba(10,20,40,.45)]\" data-kid=\"1-3-1-1-2-2\" data-name=\"hero image card\">\n                        <img alt=\"Biztonsági szolgálat munkatársa objektumon belüli szolgálatban\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-1-1-2-2-1\" data-name=\"hero image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image5.jpeg\"/>\n                        <div class=\"absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#0a1428] via-[#0a1428]/70 to-transparent pt-16 pb-6 px-7\" data-kid=\"1-3-1-1-2-2-2\" data-name=\"hero image card overlay\">\n                            <p class=\"label text-[#b8905b] mb-1.5\" data-kid=\"1-3-1-1-2-2-2-1\" data-name=\"hero image card title\">\n                                Objektumőrzés\n                            </p>\n                            <p class=\"text-[#e8eaf0] text-[.9rem] leading-snug\" data-kid=\"1-3-1-1-2-2-2-2\" data-name=\"hero image card description\">\n                                Saját, betanított állomány — nem alvállalkozói lánc.\n                            </p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 3. STATS BANNER ══════════ -->\n        <section class=\"bg-[#0a1428]\" data-kid=\"1-3-2\" data-name=\"stats banner section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] grid grid-cols-2 lg:grid-cols-4 divide-y lg:divide-y-0 lg:divide-x divide-[#b8905b]/30 border-x border-[#b8905b]/0\" data-kid=\"1-3-2-1\" data-name=\"stats grid container\">\n                <div class=\"px-2 lg:px-9 py-11 first:pl-0\" data-kid=\"1-3-2-1-1\" data-name=\"stat item 1\">\n                    <p class=\"pf text-[#b8905b] text-[2.9rem] leading-none font-semibold\" data-kid=\"1-3-2-1-1-1\" data-name=\"stat 1 value\">\n                        7+ év\n                    </p>\n                    <p class=\"mt-3 text-[#aeb6c6] text-[.86rem] leading-snug max-w-[190px]\" data-kid=\"1-3-2-1-1-2\" data-name=\"stat 1 label\">\n                        folyamatos működés 2019 óta\n                    </p>\n                </div>\n                <div class=\"px-2 lg:px-9 py-11\" data-kid=\"1-3-2-1-2\" data-name=\"stat item 2\">\n                    <p class=\"pf text-[#b8905b] text-[2.9rem] leading-none font-semibold\" data-kid=\"1-3-2-1-2-1\" data-name=\"stat 2 value\">\n                        40+ szakember\n                    </p>\n                    <p class=\"mt-3 text-[#aeb6c6] text-[.86rem] leading-snug max-w-[190px]\" data-kid=\"1-3-2-1-2-2\" data-name=\"stat 2 label\">\n                        saját, bejelentett állomány\n                    </p>\n                </div>\n                <div class=\"px-2 lg:px-9 py-11\" data-kid=\"1-3-2-1-3\" data-name=\"stat item 3\">\n                    <p class=\"pf text-[#b8905b] text-[2.9rem] leading-none font-semibold\" data-kid=\"1-3-2-1-3-1\" data-name=\"stat 3 value\">\n                        15+ ügyfél\n                    </p>\n                    <p class=\"mt-3 text-[#aeb6c6] text-[.86rem] leading-snug max-w-[210px]\" data-kid=\"1-3-2-1-3-2\" data-name=\"stat 3 label\">\n                        ipari park, logisztika, építőipar\n                    </p>\n                </div>\n                <div class=\"px-2 lg:px-9 py-11\" data-kid=\"1-3-2-1-4\" data-name=\"stat item 4\">\n                    <p class=\"pf text-[#b8905b] text-[2.9rem] leading-none font-semibold\" data-kid=\"1-3-2-1-4-1\" data-name=\"stat 4 value\">\n                        0–24\n                    </p>\n                    <p class=\"mt-3 text-[#aeb6c6] text-[.86rem] leading-snug max-w-[190px]\" data-kid=\"1-3-2-1-4-2\" data-name=\"stat 4 label\">\n                        diszpécserszolgálat, minden nap\n                    </p>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 4. SERVICES ══════════ -->\n        <section class=\"py-24\" data-kid=\"1-3-3\" data-name=\"services section\" id=\"services\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))]\" data-kid=\"1-3-3-1\" data-name=\"services section container\">\n                <div class=\"max-w-[720px]\" data-kid=\"1-3-3-1-1\" data-name=\"services section header\">\n                    <p class=\"label text-[#9a7644] mb-5\" data-kid=\"1-3-3-1-1-1\" data-name=\"services section pre-headline\">\n                        Szolgáltatásaink\n                    </p>\n                    <h2 class=\"pf text-[#0a1428] font-semibold text-[clamp(2rem,2.7vw,2.65rem)] leading-[1.15] tracking-[-.01em]\" data-kid=\"1-3-3-1-1-2\" data-name=\"services section headline\">\n                        Három őrzési alapszolgáltatás, kiegészítő üzemeltetési háttérrel.\n                    </h2>\n                    <div class=\"brass-rule w-[80px] mt-7\" data-kid=\"1-3-3-1-1-3\" data-name=\"decorative brass rule\">\n                    </div>\n                </div>\n                <!-- primary trio -->\n                <div class=\"mt-16 grid grid-cols-1 md:grid-cols-3 gap-10 items-start\" data-kid=\"1-3-3-1-2\" data-name=\"primary services card grid\">\n                    <article class=\"lift bg-white p-6 pb-8 shadow-[0_20px_44px_rgba(10,20,40,.06)] rounded-[4px]\" data-kid=\"1-3-3-1-2-1\" data-name=\"primary service card 1\">\n                        <div class=\"arch-sm overflow-hidden aspect-[4/4.6] bg-[#0a1428]\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"service image container\">\n                            <img alt=\"Irodaház és telephely objektumőrzése\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-3-1-2-1-1-1\" data-name=\"service image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image4.jpeg\"/>\n                        </div>\n                        <div class=\"mt-7 flex items-baseline gap-3\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"service card title row\">\n                            <i class=\"ti ti-building-warehouse text-[#b8905b] text-[1.35rem]\" data-kid=\"1-3-3-1-2-1-2-1\" data-name=\"service building icon\">\n                            </i>\n                            <h3 class=\"pf text-[1.42rem] font-semibold text-[#0a1428] leading-tight\" data-kid=\"1-3-3-1-2-1-2-2\" data-name=\"service card title\">\n                                Objektumőrzés\n                            </h3>\n                        </div>\n                        <p class=\"mt-3.5 text-[.95rem] leading-[1.7] text-[#3c4762]\" data-kid=\"1-3-3-1-2-1-3\" data-name=\"service card description\">\n                            Épületek, telephelyek, irodaházak és ipari létesítmények komplett objektumvédelme, igény esetén kutyás őrszolgálattal.\n                        </p>\n                    </article>\n                    <article class=\"lift bg-white p-6 pb-8 shadow-[0_20px_44px_rgba(10,20,40,.06)] rounded-[4px] md:translate-y-12\" data-kid=\"1-3-3-1-2-2\" data-name=\"primary service card 2\">\n                        <div class=\"arch-sm overflow-hidden aspect-[4/4.6] bg-[#0a1428]\" data-kid=\"1-3-3-1-2-2-1\" data-name=\"service image container\">\n                            <img alt=\"Portaszolgálat és recepciós beléptetés\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-3-1-2-2-1-1\" data-name=\"service image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image6.jpeg\"/>\n                        </div>\n                        <div class=\"mt-7 flex items-baseline gap-3\" data-kid=\"1-3-3-1-2-2-2\" data-name=\"service card title row\">\n                            <i class=\"ti ti-id-badge-2 text-[#b8905b] text-[1.35rem]\" data-kid=\"1-3-3-1-2-2-2-1\" data-name=\"service badge icon\">\n                            </i>\n                            <h3 class=\"pf text-[1.42rem] font-semibold text-[#0a1428] leading-tight\" data-kid=\"1-3-3-1-2-2-2-2\" data-name=\"service card title\">\n                                Portaszolgálat\n                            </h3>\n                        </div>\n                        <p class=\"mt-3.5 text-[.95rem] leading-[1.7] text-[#3c4762]\" data-kid=\"1-3-3-1-2-2-3\" data-name=\"service card description\">\n                            Recepciós, diszpécseri és operátori feladatok ellátása, beléptetés és információs szolgáltatások.\n                        </p>\n                    </article>\n                    <article class=\"lift bg-white p-6 pb-8 shadow-[0_20px_44px_rgba(10,20,40,.06)] rounded-[4px]\" data-kid=\"1-3-3-1-2-3\" data-name=\"primary service card 3\">\n                        <div class=\"arch-sm overflow-hidden aspect-[4/4.6] bg-[#0a1428]\" data-kid=\"1-3-3-1-2-3-1\" data-name=\"service image container\">\n                            <img alt=\"Gépkocsis járőrszolgálat éjszakai ellenőrzőkörön\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-3-1-2-3-1-1\" data-name=\"service image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image3.jpeg\"/>\n                        </div>\n                        <div class=\"mt-7 flex items-baseline gap-3\" data-kid=\"1-3-3-1-2-3-2\" data-name=\"service card title row\">\n                            <i class=\"ti ti-car text-[#b8905b] text-[1.35rem]\" data-kid=\"1-3-3-1-2-3-2-1\" data-name=\"service car icon\">\n                            </i>\n                            <h3 class=\"pf text-[1.42rem] font-semibold text-[#0a1428] leading-tight\" data-kid=\"1-3-3-1-2-3-2-2\" data-name=\"service card title\">\n                                Járőrszolgálat\n                            </h3>\n                        </div>\n                        <p class=\"mt-3.5 text-[.95rem] leading-[1.7] text-[#3c4762]\" data-kid=\"1-3-3-1-2-3-3\" data-name=\"service card description\">\n                            Nappali és éjszakai területellenőrző járőrszolgálat felállítása és üzemeltetése, gépkocsival vagy gyalogosan.\n                        </p>\n                    </article>\n                </div>\n                <!-- secondary trio -->\n                <div class=\"mt-24 md:mt-28 pt-12 border-t border-[#0a1428]/12\" data-kid=\"1-3-3-1-3\" data-name=\"secondary services section\">\n                    <p class=\"label text-[#8a8579] mb-9\" data-kid=\"1-3-3-1-3-1\" data-name=\"secondary services label\">\n                        Kiegészítő szolgáltatások\n                    </p>\n                    <div class=\"grid grid-cols-1 md:grid-cols-3 gap-x-10 gap-y-9\" data-kid=\"1-3-3-1-3-2\" data-name=\"secondary services grid\">\n                        <article class=\"flex gap-5 items-start\" data-kid=\"1-3-3-1-3-2-1\" data-name=\"secondary service card 1\">\n                            <div class=\"shrink-0 w-[74px] h-[74px] rounded-full overflow-hidden bg-[#0a1428]\" data-kid=\"1-3-3-1-3-2-1-1\" data-name=\"secondary service image container\">\n                                <img alt=\"Rendezvénybiztosítás\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-3-1-3-2-1-1-1\" data-name=\"secondary service image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image2.jpeg\"/>\n                            </div>\n                            <div data-kid=\"1-3-3-1-3-2-1-2\" data-name=\"secondary service content\">\n                                <h3 class=\"pf text-[1.13rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-3-1-3-2-1-2-1\" data-name=\"secondary service title\">\n                                    Rendezvénybiztosítás\n                                </h3>\n                                <p class=\"mt-2 text-[.9rem] leading-[1.65] text-[#4a5470]\" data-kid=\"1-3-3-1-3-2-1-2-2\" data-name=\"secondary service description\">\n                                    Rendezvények biztosítása és személyvédelem a résztvevők és a vagyon védelme érdekében.\n                                </p>\n                            </div>\n                        </article>\n                        <article class=\"flex gap-5 items-start\" data-kid=\"1-3-3-1-3-2-2\" data-name=\"secondary service card 2\">\n                            <div class=\"shrink-0 w-[74px] h-[74px] rounded-full overflow-hidden bg-[#0a1428]\" data-kid=\"1-3-3-1-3-2-2-1\" data-name=\"secondary service image container\">\n                                <img alt=\"Gépi takarítás irodaházban\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-3-1-3-2-2-1-1\" data-name=\"secondary service image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image8.jpeg\"/>\n                            </div>\n                            <div data-kid=\"1-3-3-1-3-2-2-2\" data-name=\"secondary service content\">\n                                <h3 class=\"pf text-[1.13rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-3-1-3-2-2-2-1\" data-name=\"secondary service title\">\n                                    Takarítás\n                                </h3>\n                                <p class=\"mt-2 text-[.9rem] leading-[1.65] text-[#4a5470]\" data-kid=\"1-3-3-1-3-2-2-2-2\" data-name=\"secondary service description\">\n                                    Irodaházak, üzemek és közterületek takarítása gépi padló- és szőnyegtisztítással, valamint fertőtlenítő gőztakarítással.\n                                </p>\n                            </div>\n                        </article>\n                        <article class=\"flex gap-5 items-start\" data-kid=\"1-3-3-1-3-2-3\" data-name=\"secondary service card 3\">\n                            <div class=\"shrink-0 w-[74px] h-[74px] rounded-full overflow-hidden bg-[#0a1428]\" data-kid=\"1-3-3-1-3-2-3-1\" data-name=\"secondary service image container\">\n                                <img alt=\"Hosszú távú partneri együttműködés\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-3-1-3-2-3-1-1\" data-name=\"secondary service image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image1.jpeg\"/>\n                            </div>\n                            <div data-kid=\"1-3-3-1-3-2-3-2\" data-name=\"secondary service content\">\n                                <h3 class=\"pf text-[1.13rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-3-1-3-2-3-2-1\" data-name=\"secondary service title\">\n                                    Megbízható partner\n                                </h3>\n                                <p class=\"mt-2 text-[.9rem] leading-[1.65] text-[#4a5470]\" data-kid=\"1-3-3-1-3-2-3-2-2\" data-name=\"secondary service description\">\n                                    Ügyfeleink biztonsága a legfontosabb számunkra. Hosszú távú, megbízható együttműködés.\n                                </p>\n                            </div>\n                        </article>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 5. PROCESS ══════════ -->\n        <section class=\"bg-white py-24 border-y border-[#0a1428]/10\" data-kid=\"1-3-4\" data-name=\"work process section\" id=\"process\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))]\" data-kid=\"1-3-4-1\" data-name=\"work process container\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-[minmax(0,34fr)_minmax(0,66fr)] gap-14\" data-kid=\"1-3-4-1-1\" data-name=\"work process grid\">\n                    <div data-kid=\"1-3-4-1-1-1\" data-name=\"work process info column\">\n                        <p class=\"label text-[#9a7644] mb-5\" data-kid=\"1-3-4-1-1-1-1\" data-name=\"work process label\">\n                            Így dolgozunk\n                        </p>\n                        <h2 class=\"pf text-[#0a1428] font-semibold text-[clamp(1.9rem,2.5vw,2.5rem)] leading-[1.14] tracking-[-.01em]\" data-kid=\"1-3-4-1-1-1-2\" data-name=\"work process headline\">\n                            A felméréstől a havi vezetői értékelésig.\n                        </h2>\n                        <div class=\"brass-rule w-[70px] mt-7\" data-kid=\"1-3-4-1-1-1-3\" data-name=\"decorative brass rule\">\n                        </div>\n                        <p class=\"mt-7 text-[.95rem] leading-[1.75] text-[#4a5470] max-w-[330px]\" data-kid=\"1-3-4-1-1-1-4\" data-name=\"work process description\">\n                            Minden objektumot ugyanezen a négy lépésen vezetünk át, dokumentáltan.\n                        </p>\n                    </div>\n                    <ol class=\"divide-y divide-[#0a1428]/12 border-t border-[#0a1428]/12\" data-kid=\"1-3-4-1-1-2\" data-name=\"work process list\">\n                        <li class=\"grid grid-cols-[76px_1fr] gap-6 py-8\" data-kid=\"1-3-4-1-1-2-1\" data-name=\"process step 1\">\n                            <span class=\"pf text-[2.2rem] leading-none text-[#b8905b] font-semibold\" data-kid=\"1-3-4-1-1-2-1-1\" data-name=\"step 1 number\">\n                                01\n                            </span>\n                            <div data-kid=\"1-3-4-1-1-2-1-2\" data-name=\"step 1 content\">\n                                <h3 class=\"pf text-[1.3rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-4-1-1-2-1-2-1\" data-name=\"step 1 title\">\n                                    Felmérés és ajánlat\n                                </h3>\n                                <p class=\"mt-2.5 text-[.97rem] leading-[1.72] text-[#3c4762] max-w-[620px]\" data-kid=\"1-3-4-1-1-2-1-2-2\" data-name=\"step 1 description\">\n                                    Helyszíni bejárás, kockázatfelmérés, létszám- és óraterv. Írásos ajánlat 24 órán belül.\n                                </p>\n                            </div>\n                        </li>\n                        <li class=\"grid grid-cols-[76px_1fr] gap-6 py-8\" data-kid=\"1-3-4-1-1-2-2\" data-name=\"process step 2\">\n                            <span class=\"pf text-[2.2rem] leading-none text-[#b8905b] font-semibold\" data-kid=\"1-3-4-1-1-2-2-1\" data-name=\"step 2 number\">\n                                02\n                            </span>\n                            <div data-kid=\"1-3-4-1-1-2-2-2\" data-name=\"step 2 content\">\n                                <h3 class=\"pf text-[1.3rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-4-1-1-2-2-2-1\" data-name=\"step 2 title\">\n                                    Átvétel és állományozás\n                                </h3>\n                                <p class=\"mt-2.5 text-[.97rem] leading-[1.72] text-[#3c4762] max-w-[620px]\" data-kid=\"1-3-4-1-1-2-2-2-2\" data-name=\"step 2 description\">\n                                    Őrutasítás és posztleírás kidolgozása, dedikált állomány kijelölése, betanítás az objektum sajátosságaira.\n                                </p>\n                            </div>\n                        </li>\n                        <li class=\"grid grid-cols-[76px_1fr] gap-6 py-8\" data-kid=\"1-3-4-1-1-2-3\" data-name=\"process step 3\">\n                            <span class=\"pf text-[2.2rem] leading-none text-[#b8905b] font-semibold\" data-kid=\"1-3-4-1-1-2-3-1\" data-name=\"step 3 number\">\n                                03\n                            </span>\n                            <div data-kid=\"1-3-4-1-1-2-3-2\" data-name=\"step 3 content\">\n                                <h3 class=\"pf text-[1.3rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-4-1-1-2-3-2-1\" data-name=\"step 3 title\">\n                                    Szolgálat és diszpécserháttér\n                                </h3>\n                                <p class=\"mt-2.5 text-[.97rem] leading-[1.72] text-[#3c4762] max-w-[620px]\" data-kid=\"1-3-4-1-1-2-3-2-2\" data-name=\"step 3 description\">\n                                    0–24 elérhető diszpécser, ellenőrzőkörök, riasztásra történő kivonulás, gépkocsis vagy gyalogos járőrözés.\n                                </p>\n                            </div>\n                        </li>\n                        <li class=\"grid grid-cols-[76px_1fr] gap-6 py-8\" data-kid=\"1-3-4-1-1-2-4\" data-name=\"process step 4\">\n                            <span class=\"pf text-[2.2rem] leading-none text-[#b8905b] font-semibold\" data-kid=\"1-3-4-1-1-2-4-1\" data-name=\"step 4 number\">\n                                04\n                            </span>\n                            <div data-kid=\"1-3-4-1-1-2-4-2\" data-name=\"step 4 content\">\n                                <h3 class=\"pf text-[1.3rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-4-1-1-2-4-2-1\" data-name=\"step 4 title\">\n                                    Jelentés és ellenőrzés\n                                </h3>\n                                <p class=\"mt-2.5 text-[.97rem] leading-[1.72] text-[#3c4762] max-w-[620px]\" data-kid=\"1-3-4-1-1-2-4-2-2\" data-name=\"step 4 description\">\n                                    Szolgálati napló, rendkívüli események írásos jelentése, rendszeres vezetői ellenőrzés és havi értékelés.\n                                </p>\n                            </div>\n                        </li>\n                    </ol>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 6. COVERAGE ══════════ -->\n        <section class=\"py-24\" data-kid=\"1-3-5\" data-name=\"coverage section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] grid grid-cols-1 lg:grid-cols-[minmax(0,55fr)_minmax(0,45fr)] gap-16 items-center\" data-kid=\"1-3-5-1\" data-name=\"coverage container\">\n                <div data-kid=\"1-3-5-1-1\" data-name=\"coverage info column\">\n                    <p class=\"label text-[#9a7644] mb-5\" data-kid=\"1-3-5-1-1-1\" data-name=\"coverage label\">\n                        Országos lefedettség\n                    </p>\n                    <h2 class=\"pf text-[#0a1428] font-semibold text-[clamp(1.9rem,2.5vw,2.5rem)] leading-[1.14] tracking-[-.01em]\" data-kid=\"1-3-5-1-1-2\" data-name=\"coverage headline\">\n                        Dunakeszi központ, Pest megyei súlypont, országos kivonulás.\n                    </h2>\n                    <div class=\"brass-rule w-[70px] mt-7\" data-kid=\"1-3-5-1-1-3\" data-name=\"decorative brass rule\">\n                    </div>\n                    <dl class=\"mt-9 divide-y divide-[#0a1428]/12 border-y border-[#0a1428]/12\" data-kid=\"1-3-5-1-1-4\" data-name=\"coverage detail list\">\n                        <div class=\"grid grid-cols-[190px_1fr] gap-6 py-5\" data-kid=\"1-3-5-1-1-4-1\" data-name=\"coverage detail item 1\">\n                            <dt class=\"label text-[#8a8579] pt-1\" data-kid=\"1-3-5-1-1-4-1-1\" data-name=\"detail item label\">\n                                Központ\n                            </dt>\n                            <dd class=\"text-[1rem] text-[#0a1428] font-medium\" data-kid=\"1-3-5-1-1-4-1-2\" data-name=\"detail item value\">\n                                2120 Dunakeszi, Fő út 69.\n                            </dd>\n                        </div>\n                        <div class=\"grid grid-cols-[190px_1fr] gap-6 py-5\" data-kid=\"1-3-5-1-1-4-2\" data-name=\"coverage detail item 2\">\n                            <dt class=\"label text-[#8a8579] pt-1\" data-kid=\"1-3-5-1-1-4-2-1\" data-name=\"detail item label\">\n                                Kiemelt terület\n                            </dt>\n                            <dd class=\"text-[1rem] text-[#0a1428] font-medium\" data-kid=\"1-3-5-1-1-4-2-2\" data-name=\"detail item value\">\n                                Budapest és Pest megye\n                            </dd>\n                        </div>\n                        <div class=\"grid grid-cols-[190px_1fr] gap-6 py-5\" data-kid=\"1-3-5-1-1-4-3\" data-name=\"coverage detail item 3\">\n                            <dt class=\"label text-[#8a8579] pt-1\" data-kid=\"1-3-5-1-1-4-3-1\" data-name=\"detail item label\">\n                                Rendszeres\n                            </dt>\n                            <dd class=\"text-[1rem] text-[#0a1428] font-medium\" data-kid=\"1-3-5-1-1-4-3-2\" data-name=\"detail item value\">\n                                Közép-Magyarország\n                            </dd>\n                        </div>\n                        <div class=\"grid grid-cols-[190px_1fr] gap-6 py-5\" data-kid=\"1-3-5-1-1-4-4\" data-name=\"coverage detail item 4\">\n                            <dt class=\"label text-[#8a8579] pt-1\" data-kid=\"1-3-5-1-1-4-4-1\" data-name=\"detail item label\">\n                                Egyedi megállapodás\n                            </dt>\n                            <dd class=\"text-[1rem] text-[#0a1428] font-medium\" data-kid=\"1-3-5-1-1-4-4-2\" data-name=\"detail item value\">\n                                Országos kivonulás\n                            </dd>\n                        </div>\n                    </dl>\n                    <p class=\"mt-7 inline-flex items-center gap-3 bg-white border-l-2 border-[#b8905b] px-5 py-4 text-[.94rem] text-[#3c4762]\" data-kid=\"1-3-5-1-1-5\" data-name=\"coverage timing notice\">\n                        <i class=\"ti ti-calendar-stats text-[#9a7644] text-[1.2rem]\" data-kid=\"1-3-5-1-1-5-1\" data-name=\"timing icon\">\n                        </i>\n                        <span data-kid=\"1-3-5-1-1-5-3\" data-name=\"timing notice text\">\n                            Új helyszín indítása jellemzően\n                            <strong class=\"text-[#0a1428] font-bold\" data-kid=\"1-3-5-1-1-5-2\" data-name=\"timing duration emphasis\">\n                                5–10 munkanap\n                            </strong>\n                            .\n                        </span>\n                    </p>\n                </div>\n                <div class=\"relative\" data-kid=\"1-3-5-1-2\" data-name=\"coverage visual column\">\n                    <div class=\"overflow-hidden rounded-[4px] aspect-[5/3.6] bg-[#0a1428] shadow-[0_30px_60px_-28px_rgba(10,20,40,.4)]\" data-kid=\"1-3-5-1-2-1\" data-name=\"vehicle image container\">\n                        <img alt=\"Dog Race Security szolgálati gépjármű\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-5-1-2-1-1\" data-name=\"vehicle image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image7.jpeg\"/>\n                    </div>\n                    <div class=\"mt-5 flex items-center gap-3 text-[.82rem] text-[#8a8579]\" data-kid=\"1-3-5-1-2-2\" data-name=\"vehicle caption\">\n                        <i class=\"ti ti-shield-check text-[#9a7644] text-[1.05rem]\" data-kid=\"1-3-5-1-2-2-1\" data-name=\"shield icon\">\n                        </i>\n                        Saját jelöléssel ellátott szolgálati gépjárművek\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 7. LICENCES & VETTING ══════════ -->\n        <section class=\"bg-[#0a1428] py-24\" data-kid=\"1-3-6\" data-name=\"licenses section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))]\" data-kid=\"1-3-6-1\" data-name=\"licenses container\">\n                <div class=\"grid grid-cols-1 lg:grid-cols-[minmax(0,42fr)_minmax(0,58fr)] gap-16\" data-kid=\"1-3-6-1-1\" data-name=\"licenses grid\">\n                    <div data-kid=\"1-3-6-1-1-1\" data-name=\"licenses highlight\">\n                        <span class=\"inline-flex items-center justify-center w-[72px] h-[72px] rounded-full border border-[#b8905b]/50 text-[#b8905b] mb-8\" data-kid=\"1-3-6-1-1-1-1\" data-name=\"highlight icon container\">\n                            <i class=\"ti ti-award text-[2.1rem]\" data-kid=\"1-3-6-1-1-1-1-1\" data-name=\"award icon\">\n                            </i>\n                        </span>\n                        <p class=\"label text-[#b8905b] mb-6\" data-kid=\"1-3-6-1-1-1-2\" data-name=\"licenses section label\">\n                            Engedélyek és alkalmasság\n                        </p>\n                        <blockquote class=\"pf text-[#f4f1ec] font-medium text-[clamp(1.75rem,2.4vw,2.35rem)] leading-[1.24] tracking-[-.01em]\" data-kid=\"1-3-6-1-1-1-3\" data-name=\"licenses highlight quote\">\n                            „100%-ban magyar tulajdon. Feddhetetlenségi vizsgálat minden munkatársnál.”\n                        </blockquote>\n                        <p class=\"mt-8 text-[.86rem] text-[#8f97a8] leading-relaxed max-w-[340px]\" data-kid=\"1-3-6-1-1-1-4\" data-name=\"licenses section disclaimer\">\n                            A dokumentumok másolata ajánlatkérésre rendelkezésre áll.\n                        </p>\n                    </div>\n                    <ul class=\"divide-y divide-[#b8905b]/22 border-y border-[#b8905b]/22\" data-kid=\"1-3-6-1-1-2\" data-name=\"licenses list\">\n                        <li class=\"flex items-start gap-5 py-6\" data-kid=\"1-3-6-1-1-2-1\" data-name=\"license item 1\">\n                            <i class=\"ti ti-file-certificate text-[#b8905b] text-[1.4rem] shrink-0 mt-0.5\" data-kid=\"1-3-6-1-1-2-1-1\" data-name=\"license icon 1\">\n                            </i>\n                            <p class=\"text-[#e8eaf0] text-[1rem] leading-[1.6]\" data-kid=\"1-3-6-1-1-2-1-2\" data-name=\"license description 1\">\n                                Vagyonvédelmi tevékenységi engedély és kamarai nyilvántartás\n                            </p>\n                        </li>\n                        <li class=\"flex items-start gap-5 py-6\" data-kid=\"1-3-6-1-1-2-2\" data-name=\"license item 2\">\n                            <i class=\"ti ti-file-text text-[#b8905b] text-[1.4rem] shrink-0 mt-0.5\" data-kid=\"1-3-6-1-1-2-2-1\" data-name=\"license icon 2\">\n                            </i>\n                            <p class=\"text-[#e8eaf0] text-[1rem] leading-[1.6]\" data-kid=\"1-3-6-1-1-2-2-2\" data-name=\"license description 2\">\n                                Szakmai felelősségbiztosítás\n                            </p>\n                        </li>\n                        <li class=\"flex items-start gap-5 py-6\" data-kid=\"1-3-6-1-1-2-3\" data-name=\"license item 3\">\n                            <i class=\"ti ti-user-check text-[#b8905b] text-[1.4rem] shrink-0 mt-0.5\" data-kid=\"1-3-6-1-1-2-3-1\" data-name=\"license icon 3\">\n                            </i>\n                            <p class=\"text-[#e8eaf0] text-[1rem] leading-[1.6]\" data-kid=\"1-3-6-1-1-2-3-2\" data-name=\"license description 3\">\n                                Feddhetetlenségi vizsgálat minden munkatársnál\n                            </p>\n                        </li>\n                        <li class=\"flex items-start gap-5 py-6\" data-kid=\"1-3-6-1-1-2-4\" data-name=\"license item 4\">\n                            <i class=\"ti ti-stethoscope text-[#b8905b] text-[1.4rem] shrink-0 mt-0.5\" data-kid=\"1-3-6-1-1-2-4-1\" data-name=\"license icon 4\">\n                            </i>\n                            <p class=\"text-[#e8eaf0] text-[1rem] leading-[1.6]\" data-kid=\"1-3-6-1-1-2-4-2\" data-name=\"license description 4\">\n                                Kétévente kötelező orvosi és pszichológiai vizsgálat\n                            </p>\n                        </li>\n                        <li class=\"flex items-start gap-5 py-6\" data-kid=\"1-3-6-1-1-2-5\" data-name=\"license item 5\">\n                            <i class=\"ti ti-flag text-[#b8905b] text-[1.4rem] shrink-0 mt-0.5\" data-kid=\"1-3-6-1-1-2-5-1\" data-name=\"license icon 5\">\n                            </i>\n                            <p class=\"text-[#e8eaf0] text-[1rem] leading-[1.6]\" data-kid=\"1-3-6-1-1-2-5-2\" data-name=\"license description 5\">\n                                100%-ban magyar tulajdonú társaság, stabil tőkeháttérrel\n                            </p>\n                        </li>\n                        <li class=\"flex items-start gap-5 py-6\" data-kid=\"1-3-6-1-1-2-6\" data-name=\"license item 6\">\n                            <i class=\"ti ti-clock-hour-4 text-[#b8905b] text-[1.4rem] shrink-0 mt-0.5\" data-kid=\"1-3-6-1-1-2-6-1\" data-name=\"license icon 6\">\n                            </i>\n                            <p class=\"text-[#e8eaf0] text-[1rem] leading-[1.6]\" data-kid=\"1-3-6-1-1-2-6-2\" data-name=\"license description 6\">\n                                2019 óta folyamatos működés\n                            </p>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 8. ABOUT ══════════ -->\n        <section class=\"py-24\" data-kid=\"1-3-7\" data-name=\"about section\" id=\"about\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))] grid grid-cols-1 lg:grid-cols-[minmax(0,40fr)_minmax(0,60fr)] gap-16 items-start\" data-kid=\"1-3-7-1\" data-name=\"about container\">\n                <div class=\"relative lg:sticky lg:top-28\" data-kid=\"1-3-7-1-1\" data-name=\"about visual column\">\n                    <div class=\"arch overflow-hidden aspect-[3/4] bg-[#0a1428] shadow-[0_36px_70px_-32px_rgba(10,20,40,.45)]\" data-kid=\"1-3-7-1-1-1\" data-name=\"about image container\">\n                        <img alt=\"Őrzött irodaház alkonyatban\" class=\"w-full h-full object-cover photo\" data-kid=\"1-3-7-1-1-1-1\" data-name=\"about image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/image4.jpeg\"/>\n                    </div>\n                    <div class=\"absolute -right-6 -bottom-6 w-[130px] h-[130px] border border-[#b8905b]/45 hidden lg:block\" data-kid=\"1-3-7-1-1-2\" data-name=\"about decorative element\">\n                    </div>\n                </div>\n                <div data-kid=\"1-3-7-1-2\" data-name=\"about content column\">\n                    <p class=\"label text-[#9a7644] mb-5\" data-kid=\"1-3-7-1-2-1\" data-name=\"about section label\">\n                        Rólunk\n                    </p>\n                    <h2 class=\"pf text-[#0a1428] font-semibold text-[clamp(1.9rem,2.5vw,2.5rem)] leading-[1.14] tracking-[-.01em]\" data-kid=\"1-3-7-1-2-2\" data-name=\"about section headline\">\n                        A Dog Race Security 2019 óta van jelen a magyar vagyonvédelmi piacon.\n                    </h2>\n                    <div class=\"brass-rule w-[70px] mt-7\" data-kid=\"1-3-7-1-2-3\" data-name=\"decorative brass rule\">\n                    </div>\n                    <p class=\"mt-8 text-[1.08rem] leading-[1.75] text-[#2a3450] max-w-[640px]\" data-kid=\"1-3-7-1-2-4\" data-name=\"about main description\">\n                        A Dog Race Security Korlátolt Felelősségű Társaság 2019 óta nyújt vagyonvédelmi és takarítási szolgáltatásokat üzleti ügyfelek részére, saját bejelentett állománnyal és stabil tőkeháttérrel.\n                    </p>\n                    <div class=\"mt-11 space-y-10\" data-kid=\"1-3-7-1-2-5\" data-name=\"about core values list\">\n                        <div data-kid=\"1-3-7-1-2-5-1\" data-name=\"about value 1\">\n                            <h3 class=\"pf text-[1.22rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-7-1-2-5-1-1\" data-name=\"about value 1 title\">\n                                Tevékenységi köreink\n                            </h3>\n                            <p class=\"mt-2.5 text-[.98rem] leading-[1.75] text-[#3c4762] max-w-[640px]\" data-kid=\"1-3-7-1-2-5-1-2\" data-name=\"about value 1 description\">\n                                Létesítmények és irodaházak őrzése, építési területek őrzésvédelme, vagyonvédelmi és tűzvédelmi rendszerek – beléptető- és kamerarendszerek – telepítése és igény szerinti karbantartása, valamint rendezvények biztosítása.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-3-7-1-2-5-2\" data-name=\"about value 2\">\n                            <h3 class=\"pf text-[1.22rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-7-1-2-5-2-1\" data-name=\"about value 2 title\">\n                                Háttér és állomány\n                            </h3>\n                            <p class=\"mt-2.5 text-[.98rem] leading-[1.75] text-[#3c4762] max-w-[640px]\" data-kid=\"1-3-7-1-2-5-2-2\" data-name=\"about value 2 description\">\n                                A 100%-ban magyar tulajdonú cégünk a hazai piaci igények alapos ismeretével teljes körű szolgáltatást kínál üzleti ügyfelei részére, alapos szakmai tudással és gyakorlattal rendelkező munkaerőt foglalkoztatva.\n                            </p>\n                        </div>\n                        <div data-kid=\"1-3-7-1-2-5-3\" data-name=\"about value 3\">\n                            <h3 class=\"pf text-[1.22rem] font-semibold text-[#0a1428]\" data-kid=\"1-3-7-1-2-5-3-1\" data-name=\"about value 3 title\">\n                                Ügyfélkezelés a szerződés után is\n                            </h3>\n                            <p class=\"mt-2.5 text-[.98rem] leading-[1.75] text-[#3c4762] max-w-[640px]\" data-kid=\"1-3-7-1-2-5-3-2\" data-name=\"about value 3 description\">\n                                Célunk, hogy Ügyfeleinket ne csak a szerződéskötés pillanatáig kezeljük kitüntetett figyelemmel, hanem a szolgáltatás teljes időtartama alatt készen álljunk minden felmerülő igény azonnali kiszolgálására.\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"mt-12 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4 pt-8 border-t border-[#0a1428]/12\" data-kid=\"1-3-7-1-2-6\" data-name=\"about footer highlight list\">\n                        <p class=\"flex items-center gap-3 text-[.93rem] text-[#2a3450]\" data-kid=\"1-3-7-1-2-6-1\" data-name=\"highlight 1\">\n                            <i class=\"ti ti-point-filled text-[#b8905b]\" data-kid=\"1-3-7-1-2-6-1-1\" data-name=\"bullet icon\">\n                            </i>\n                            2019 óta a piacon\n                        </p>\n                        <p class=\"flex items-center gap-3 text-[.93rem] text-[#2a3450]\" data-kid=\"1-3-7-1-2-6-2\" data-name=\"highlight 2\">\n                            <i class=\"ti ti-point-filled text-[#b8905b]\" data-kid=\"1-3-7-1-2-6-2-1\" data-name=\"bullet icon\">\n                            </i>\n                            100%-ban magyar tulajdonú cég\n                        </p>\n                        <p class=\"flex items-center gap-3 text-[.93rem] text-[#2a3450]\" data-kid=\"1-3-7-1-2-6-3\" data-name=\"highlight 3\">\n                            <i class=\"ti ti-point-filled text-[#b8905b]\" data-kid=\"1-3-7-1-2-6-3-1\" data-name=\"bullet icon\">\n                            </i>\n                            Feddhetetlenségi vizsgálat\n                        </p>\n                        <p class=\"flex items-center gap-3 text-[.93rem] text-[#2a3450]\" data-kid=\"1-3-7-1-2-6-4\" data-name=\"highlight 4\">\n                            <i class=\"ti ti-point-filled text-[#b8905b]\" data-kid=\"1-3-7-1-2-6-4-1\" data-name=\"bullet icon\">\n                            </i>\n                            Kétévente orvosi és pszichológiai vizsgálat\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 9. TESTIMONIALS ══════════ -->\n        <section class=\"bg-white py-24 border-y border-[#0a1428]/10\" data-kid=\"1-3-8\" data-name=\"testimonials section\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))]\" data-kid=\"1-3-8-1\" data-name=\"testimonials container\">\n                <p class=\"label text-[#9a7644] mb-10\" data-kid=\"1-3-8-1-1\" data-name=\"testimonials label\">\n                    Ügyfeleink mondták\n                </p>\n                <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-x-16 gap-y-12\" data-kid=\"1-3-8-1-2\" data-name=\"testimonials grid\">\n                    <figure class=\"border-l-2 border-[#b8905b] pl-8\" data-kid=\"1-3-8-1-2-1\" data-name=\"testimonial card 1\">\n                        <blockquote class=\"pf text-[#0a1428] text-[clamp(1.3rem,1.75vw,1.65rem)] leading-[1.42] font-medium\" data-kid=\"1-3-8-1-2-1-1\" data-name=\"testimonial quote 1\">\n                            „Éjszakai és hétvégi szolgálatot vettünk át tőlük egy hét alatt, a jelentések azóta minden hétfőn az asztalunkon vannak.”\n                        </blockquote>\n                        <figcaption class=\"mt-6 flex items-center gap-4 flex-wrap\" data-kid=\"1-3-8-1-2-1-2\" data-name=\"testimonial meta 1\">\n                            <span class=\"text-[.9rem] font-bold text-[#2a3450]\" data-kid=\"1-3-8-1-2-1-2-1\" data-name=\"testimonial author 1\">\n                                Létesítménygazdálkodási vezető, ipari park\n                            </span>\n                            <span class=\"label text-[#a8a293] text-[.62rem] border border-[#0a1428]/15 px-2.5 py-1 rounded-[2px]\" data-kid=\"1-3-8-1-2-1-2-2\" data-name=\"testimonial status 1\">\n                                [ jóváhagyásra vár ]\n                            </span>\n                        </figcaption>\n                    </figure>\n                    <figure class=\"border-l-2 border-[#b8905b] pl-8\" data-kid=\"1-3-8-1-2-2\" data-name=\"testimonial card 2\">\n                        <blockquote class=\"pf text-[#0a1428] text-[clamp(1.3rem,1.75vw,1.65rem)] leading-[1.42] font-medium\" data-kid=\"1-3-8-1-2-2-1\" data-name=\"testimonial quote 2\">\n                            „Az őrök megjelenése és a diszpécser elérhetősége az, amiért maradtunk.”\n                        </blockquote>\n                        <figcaption class=\"mt-6 flex items-center gap-4 flex-wrap\" data-kid=\"1-3-8-1-2-2-2\" data-name=\"testimonial meta 2\">\n                            <span class=\"text-[.9rem] font-bold text-[#2a3450]\" data-kid=\"1-3-8-1-2-2-2-1\" data-name=\"testimonial author 2\">\n                                Beruházási igazgató, építőipar\n                            </span>\n                            <span class=\"label text-[#a8a293] text-[.62rem] border border-[#0a1428]/15 px-2.5 py-1 rounded-[2px]\" data-kid=\"1-3-8-1-2-2-2-2\" data-name=\"testimonial status 2\">\n                                [ jóváhagyásra vár ]\n                            </span>\n                        </figcaption>\n                    </figure>\n                </div>\n            </div>\n        </section>\n        <!-- ══════════ 10. REFERENCES ══════════ -->\n        <section class=\"py-24\" data-kid=\"1-3-9\" data-name=\"references section\" id=\"references\">\n            <div class=\"mx-auto w-[min(1240px,calc(100%-4rem))]\" data-kid=\"1-3-9-1\" data-name=\"references container\">\n                <div class=\"flex flex-wrap items-end justify-between gap-6\" data-kid=\"1-3-9-1-1\" data-name=\"references header\">\n                    <div data-kid=\"1-3-9-1-1-1\" data-name=\"references title group\">\n                        <p class=\"label text-[#9a7644] mb-5\" data-kid=\"1-3-9-1-1-1-1\" data-name=\"references label\">\n                            Referenciák\n                        </p>\n                        <h2 class=\"pf text-[#0a1428] font-semibold text-[clamp(1.9rem,2.5vw,2.5rem)] leading-[1.14] tracking-[-.01em]\" data-kid=\"1-3-9-1-1-1-2\" data-name=\"references headline\">\n                            Partnercégeink megbíznak bennünk\n                        </h2>\n                    </div>\n                    <p class=\"text-[.86rem] text-[#8a8579]\" data-kid=\"1-3-9-1-1-2\" data-name=\"references count summary\">\n                        15 megbízó · ipari park, logisztika, építőipar, kereskedelem\n                    </p>\n                </div>\n                <div class=\"brass-rule w-[70px] mt-7 mb-12\" data-kid=\"1-3-9-1-2\" data-name=\"decorative brass rule\">\n                </div>\n                <div class=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px bg-[#0a1428]/10 border border-[#0a1428]/10\" data-kid=\"1-3-9-1-3\" data-name=\"logo grid\">\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-1\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"ATEV Zrt.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-1-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/atev.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-2\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"STRABAG\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-2-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/strabag.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-3\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Proform Ingatlanbefektetési Zrt.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-3-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/proform.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-4\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Titán 94 Kft.\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-4-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/titan-94.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-5\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Toperini Ipari Park\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-5-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/toperini-ipari-park.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-6\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Pallér Csarnok\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-6-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/paller-csarnok.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-7\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Légió 2000 Security\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-7-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/legio-2000-security.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-8\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"HDR Hard Dog Race\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-8-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/hdr-hard-dog-race.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-9\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Dogatlon\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-9-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dogatlon.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-10\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"DPD\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-10-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/dpd.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-11\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"TRT Europe\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-11-1\" data-name=\"logo image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/images/ref_logos/trt-europe.png\"/>\n                    </div>\n                    <div class=\"logo-chip bg-white h-[128px] flex items-center justify-center p-7\" data-kid=\"1-3-9-1-3-12\" data-name=\"logo chip with hover zoom effect\">\n                        <img alt=\"Republic Group\" class=\"max-h-full max-w-full object-contain\" data-kid=\"1-3-9-1-3-12-1\" data-name=\"logo image\" decoding=\"as